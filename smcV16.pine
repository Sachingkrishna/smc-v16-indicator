cdOpenColorInput    = input.color(color.new(#00bcd4, 20), '',   group=PDHL_GROUP, inline='cdo', display = display.none)
cdOpenStyleInput    = input.string(DASHED, '',                  group=PDHL_GROUP, inline='cdo', options=[SOLID,DASHED,DOTTED], display = display.none)
showMidnightOpenInput  = input(false, 'MO (Midnight Open 00:00)',  group=PDHL_GROUP, inline='mo', display = display.none)
midnightOpenColorInput = input.color(color.new(#ffeb3b, 20), '',   group=PDHL_GROUP, inline='mo', display = display.none)
midnightOpenStyleInput = input.string(DOTTED, '',                  group=PDHL_GROUP, inline='mo', options=[SOLID,DASHED,DOTTED],
    tooltip='Open price at 00:00 in the Kill Zone timezone.\nICT treats this as a key daily magnet/pivot.\nOnly works on intraday timeframes where a bar opens at midnight.', display = display.none)

showNDOGInput      = input(false, 'Show NDOG (New Day Opening Gap)', group=NDOG_GROUP, display = display.none)
ndogColorInput     = input.color(color.new(#2196f3, 80), 'NDOG Color', group=NDOG_GROUP, display = display.none)
showNWOGInput      = input(false, 'Show NWOG (New Week Opening Gap)', group=NDOG_GROUP, display = display.none)
nwogColorInput     = input.color(color.new(#e91e63, 80), 'NWOG Color', group=NDOG_GROUP, display = display.none)
// v19.3 — Weekly anchor mode. TV Weekly = use TradingView's weekly bar
//         boundary (default; aligns with FX weekly). ICT NY = anchor
//         strictly to Friday 17:00 ET close → Sunday 17:00 ET open,
//         matching the classic ICT NWOG definition. Use ICT NY on
//         crypto/futures/equities where TV's weekly bar doesn't align
//         with the NY-session week. Requires intraday data that
//         actually has bars at Sun 17:00 ET (won't work on RTH-only
//         equity feeds).
nwogAnchorInput    = input.string('TV Weekly', 'NWOG Anchor', group=NDOG_GROUP,
     options=['TV Weekly', 'ICT NY (Fri/Sun 17:00 ET)'],
     tooltip='TV Weekly: use TradingView\'s weekly bar (default; FX-aligned).\n' +
             'ICT NY: anchor Friday 17:00 ET close → Sunday 17:00 ET open.\n' +
             'On chart timeframes above ~15m the price snapshot loses ' +
             'precision since the open of the bar containing 17:00 ET is ' +
             'used as a proxy for the exact 17:00 price.', display = display.none)
ndogShowCEInput    = input(true,  'Show CE Line (50% midpoint)',       group=NDOG_GROUP, display = display.none)
ndogMaxCountInput  = input.int(5, 'Max Unfilled Gaps Shown',          group=NDOG_GROUP,
    minval=1, maxval=20,
    tooltip='NDOG = gap between prev day close & current day open.\nNWOG = gap between prev week close & current week open.\nCE = consequent encroachment (50% midpoint).\nMultiple unfilled gaps persist until price fills them.', display = display.none)
ndogMaxAgeHoursInput = input.int(24, 'Auto-Expire After (hours)',     group=NDOG_GROUP,
    minval=0, maxval=168,
    tooltip='Remove unfilled NDOG after this many hours.\n0 = never expire (removed only when filled or max count reached).\n24 = persist for 1 trading day.\nWorks consistently across all timeframes.', display = display.none)

// ── CVD (Cumulative Volume Delta) ────────────────────────────────────────────
showCVDDivergenceInput = input(false, 'Detect CVD Divergence at Swings', group=CVD_GROUP,
     tooltip='Marks confirmed swing pivots where CVD diverges from price.\n' +
             'Bearish: HH in price + LH in CVD = distribution / absorption.\n' +
             'Bullish: LL in price + HL in CVD = accumulation.\n' +
             'Per-bar delta is volume × close-position weight: +1 at high, -1 at low.\n' +
             'Silently zero on volume-less symbols (some indices/forex).', display = display.none)
showCVDTableInput      = input(false, 'Show CVD Status Table',           group=CVD_GROUP,
     tooltip='Top-right table showing live cumulative CVD value, sign, and bar delta.', display = display.none)
cvdBullDivColorInput   = input.color(#00e676, 'Bullish Divergence Marker', group=CVD_GROUP, display = display.none)
cvdBearDivColorInput   = input.color(#ff1744, 'Bearish Divergence Marker', group=CVD_GROUP, display = display.none)
// v20.16 — Size of the on-chart "CVD÷" divergence labels (was hardcoded Tiny).
cvdDivLabelSizeInput   = input.string('Small', 'CVD Divergence Label Size', group=CVD_GROUP,
     options=['Tiny','Small','Normal','Large','Huge'],
     tooltip='Font size of the CVD÷ divergence markers drawn at swing pivots on the chart.', display = display.none)
// v18.8 — CVD pivot source: Swing / Internal / Custom (dropdown, replaces
//         the v18.6 bool toggle).
cvdPivotSourceInput = input.string('Swing', 'CVD Pivot Source', group=CVD_GROUP,
     options=['Swing', 'Internal', 'Custom'],
     tooltip='Swing    — use existing swing pivots (Swing Length, default 20).\n' +
             '           Cleanest signals, slowest confirmation.\n' +
             'Internal — use existing internal pivots (Internal Swing\n' +
             '           Length, default 5). Faster, more noise.\n' +
             'Custom   — use a dedicated CVD pivot length (next setting),\n' +
             '           independent from swing/internal structure.', display = display.none)
cvdCustomPivotLengthInput = input.int(10, 'Custom CVD Pivot Length',
     group=CVD_GROUP, minval=3, maxval=50,
     tooltip='Only used when CVD Pivot Source = Custom.\n' +
             'Lower = more divergence labels (faster + noisier).\n' +
             'Higher = fewer divergence labels (slower + cleaner).', display = display.none)
// v19.9 — Magnitude floor for divergence detection. Original logic fired
//         on ANY sign-mismatched CVD delta between consecutive pivots —
//         no magnitude check, so in chop the labels stack. Threshold is
//         normalized by SMA(|cvdBarDelta|, 50) so it's timeframe-agnostic:
//         a value of 1.0 means "the pivot-to-pivot CVD delta must equal
//         at least 1× the recent per-bar abs(delta) average". 0 = off
//         (legacy behavior).
cvdDivMinMagnitudeInput = input.float(0.0, 'Divergence Min Magnitude (× avg |Δ|)',
     group=CVD_GROUP, minval=0.0, maxval=10.0, step=0.1,
     tooltip='Require the pivot-to-pivot CVD delta to be at least this many times the recent SMA(|cvdBarDelta|, 50). Filters noise-floor divergences in chop.\n0 = off (any sign mismatch fires the alert — legacy behavior).\n0.5–2.0 = mild to strict noise filtering. Start at 1.0.', display = display.none)
// v20.5 — Rolling-window CVD bias for the status table. Pre-v20.5 the
//         bias was sign(cumCVD), and cumCVD accumulates from the chart's
//         first loaded bar. A chart loaded on a strong bullish day weeks
//         ago could keep showing "Bullish" through a multi-day crash
//         because the early head-start was never amortized away. Rolling
//         sum over the last N bars answers "what direction is flow
//         leaning RIGHT NOW", which is what a bias indicator should show.
cvdBiasWindowInput = input.int(50, 'CVD Bias Rolling Window (bars)',
     group=CVD_GROUP, minval=10, maxval=500,
     tooltip='Window size for the bias row in the CVD table.\n50 = recent ~50 bars of net flow (default).\nHigher (200, 500) = smoother, slower to flip.\nLower (10-25) = faster, noisier.\nReplaces the legacy "sign of chart-history cumulative CVD" which was chart-load-dependent and could lie about current bias.', display = display.none)
// v20.13 — CVD table text size (was hardcoded to Small).
cvdTableSizeInput = input.string('Normal', 'CVD Table Size', group=CVD_GROUP,
     options=['Tiny','Small','Normal','Large','Huge'],
     tooltip='Font size of the CVD status table. Default Normal (was Small).', display = display.none)

// ── RVOL stamping ────────────────────────────────────────────────────────────
rvolEnableInput      = input(false, 'Enable RVOL Stamping (OB/FVG)', group=RVOL_GROUP,
     tooltip='At creation, compute origin RVOL = volume / SMA(volume, N).\n' +
             'Above-threshold OBs/FVGs render at full opacity (institutional);\n' +
             'below-threshold render dimmed or hidden depending on filter mode.', display = display.none)
rvolPeriodInput      = input.int(20,  'RVOL Lookback (bars)', group=RVOL_GROUP, minval=5, maxval=200, display = display.none)
// v20.12 — Split the OB volume multiple by structure scale. After v20.9
//          made OB RVOL sample the impulse window's peak volume, swing OBs
//          (whose impulse spans 40-100 bars) almost always clear a 1.5×
//          baseline → nearly every swing OB flagged institutional, diluting
//          the flag. Internal OBs have short impulses and are fine at 1.5×.
//          The default is now 1.5 internal / 2.5 swing so the swing-side
//          flag stays discriminating. (Pre-v20.12 the single
//          rvolOBThresholdInput drove both.)
rvolOBThresholdInput      = input.float(1.5, 'Internal OB Volume Multiple', group=RVOL_GROUP, minval=1.0, maxval=8.0, step=0.1,
     tooltip='RVOL multiple an INTERNAL order block must clear at formation to flag institutional.\nInternal impulses are short, so 1.5× is meaningful.', display = display.none)
rvolOBThresholdSwingInput = input.float(2.5, 'Swing OB Volume Multiple',    group=RVOL_GROUP, minval=1.0, maxval=8.0, step=0.1,
     tooltip='RVOL multiple a SWING order block must clear at formation to flag institutional.\nSwing impulses span many bars, so the peak-volume bar easily clears a low multiple — default 2.5× keeps the flag discriminating. Raise toward 3-4 if too many swing OBs still flag institutional.', display = display.none)
rvolFVGThresholdInput= input.float(1.5, 'FVG Volume Multiple', group=RVOL_GROUP, minval=1.0, maxval=5.0, step=0.1, display = display.none)
rvolHideRetailOBInput  = input(false, 'Hide Low-Vol OBs',     group=RVOL_GROUP, display = display.none)
rvolHideRetailFVGInput = input(false, 'Hide Low-Vol FVGs',    group=RVOL_GROUP, display = display.none)
// v20.0 — Retail-trap signal. When a low-RVOL (non-institutional) FVG or OB
//         is mitigated, fire an alert. ICT interpretation: institutions
//         don't respect low-volume levels (retail placed them), so the break
//         signals retail-positioned stops being run, not real distribution.
//         Combined into one alertcondition slot to preserve output budget.
lowRvolBreakAlertInput = input(false, 'Alert on Low-RVOL FVG/OB Break',  group=RVOL_GROUP,
     tooltip='Fires when a non-institutional FVG or OB (RVOL below threshold at formation) gets mitigated.\nRequires RVOL stamping to be enabled.\nUseful as a "retail trap" signal — break of weak levels often precedes reversal.', display = display.none)

// ── Volume Imbalance ─────────────────────────────────────────────────────────
showVIInput        = input(false, 'Show Volume Imbalance (VI)',  group=VI_GROUP,
     tooltip='Body-to-body gap between consecutive bars (no body overlap).\n' +
             'ICT-distinct from FVG. Mitigated when body crosses the far edge.', display = display.none)
viBullColorInput   = input.color(color.new(#80cbc4, 70), 'Bullish VI', group=VI_GROUP, display = display.none)
viBearColorInput   = input.color(color.new(#ef9a9a, 70), 'Bearish VI', group=VI_GROUP, display = display.none)
viMaxCountInput    = input.int(20, 'Max Unmitigated VIs', group=VI_GROUP, minval=1, maxval=100, display = display.none)
viMitigationInput  = input.string(BODY_SRC, 'VI Mitigation', group=VI_GROUP, options=[CLOSE_SRC, BODY_SRC, HIGHLOW], display = display.none)

// ── Anchored VWAP ────────────────────────────────────────────────────────────
showMSSAVWAPInput   = input(false, 'Show Anchored VWAP',     group=AVWAP_GROUP,
     tooltip='Cumulative VWAP that resets at the chosen anchor event.\n' +
             'Acts as a defended institutional reference between anchors.\n' +
             'Note: requires volume data. Symbols without volume\n' +
             '      (some indices) will not render an AVWAP line.', display = display.none)
// v18.4 — Anchor-type dropdown. Single AVWAP plot, multi-source.
avwapAnchorTypeInput = input.string('MSS', 'Anchor Type',     group=AVWAP_GROUP,
     options=['MSS', 'MSS Swing', 'Swing', 'Daily', 'Weekly'],
     tooltip='MSS       = reset on any confirmed MSS (internal + swing).\n' +
             'MSS Swing = reset on confirmed swing MSS only (less noisy).\n' +
             'Swing     = reset on every new swing high or swing low pivot.\n' +
             'Daily     = reset at the start of each new trading day.\n' +
             'Weekly    = reset at the start of each new trading week.', display = display.none)
mssAVWAPColorInput  = input.color(#ffeb3b, 'AVWAP Color',     group=AVWAP_GROUP, display = display.none)
mssAVWAPWidthInput  = input.int(2, 'AVWAP Line Width',         group=AVWAP_GROUP, minval=1, maxval=4, display = display.none)

// ── Power of 3 (PO3) ─ removed in v18.1 ──────────────────────────────────────

//──────────────────────────────────────────────────────────────────────────────
// Types
//──────────────────────────────────────────────────────────────────────────────
type alerts
    bool internalBullishBOS          = false
    bool internalBearishBOS          = false
    bool internalBullishCHoCH        = false
    bool internalBearishCHoCH        = false
    bool internalBullishMSS          = false
    bool internalBearishMSS          = false
    bool swingBullishBOS             = false
    bool swingBearishBOS             = false
    bool swingBullishCHoCH           = false
    bool swingBearishCHoCH           = false
    bool swingBullishMSS             = false
    bool swingBearishMSS             = false
    bool internalBullishOrderBlock   = false
    bool internalBearishOrderBlock   = false
    bool swingBullishOrderBlock      = false
    bool swingBearishOrderBlock      = false
    // v16.8 — OB *formation* alerts (legacy *OrderBlock fields above fire on
    //         mitigation only, despite their misleading naming).
    bool internalBullishOBFormed     = false
    bool internalBearishOBFormed     = false
    bool swingBullishOBFormed        = false
    bool swingBearishOBFormed        = false
    bool equalHighs                  = false
    bool equalLows                   = false
    bool bullishFairValueGap         = false
    bool bearishFairValueGap         = false
    bool bullishLiquiditySweep       = false
    bool bearishLiquiditySweep       = false
    bool bullishBreakerFormed        = false
    bool bearishBreakerFormed        = false
    bool bullishBreakerMitigated     = false
    bool bearishBreakerMitigated     = false
    bool bullishIFVGFormed           = false
    bool bearishIFVGFormed           = false
    // v17.0 — Split per source so internal and swing MSS can fire on the
    //         same bar with different displacement offsets without
    //         clobbering each other.
    int  internalBullishMSSOffset    = na
    int  internalBearishMSSOffset    = na
    int  swingBullishMSSOffset       = na
    int  swingBearishMSSOffset       = na
    // v17.0 — EQH/EQL sweep alerts (extending swing-only sweep coverage).
    bool bearishEQHSweep             = false
    bool bullishEQLSweep             = false
    // v17.0 — CVD divergence at confirmed swing pivots.
    bool bullishCVDDivergence        = false
    bool bearishCVDDivergence        = false
    // v18.0 — Volume Imbalance, AVWAP tag. (PO3 phase change removed in v18.1.)
    bool volumeImbalanceFormed       = false
    bool mssAVWAPTagged              = false
    // v20.0 — Retail-trap signal (low-RVOL FVG or OB mitigation) +
    //         high-confluence OB formation. Both are gated on user inputs
    //         so they only fire when their toggles + thresholds match.
    bool lowRvolBlockBroken          = false
    bool highConfluenceOBFormed      = false

type trailingExtremes
    float top
    float bottom
    int   barTime
    int   barIndex
    int   lastTopTime
    int   lastBottomTime

type fairValueGap
    float top
    float bottom
    int   bias
    box   topBox
    box   bottomBox
    int   createdBarIndex = 0
    // v18.0 — RVOL stamping at FVG creation.
    float originRVOL      = na
    bool  isInstitutional = false

type trend
    int bias

type equalDisplay
    line  l_ine  = na
    label l_abel = na

type pivot
    float currentLevel
    float lastLevel
    bool  crossed
    int   barTime  = time
    int   barIndex = bar_index
    // v16.7 — Always the wick high/low of the pivot bar, regardless of
    //         pivotSourceInput. Used by liquidity-sweep detection so that
    //         sweeps register against the true swing extreme even when the
    //         structural level (currentLevel) is anchored at the body.
    float actualLevel = na
    // v17.0 — CVD value snapshot at the pivot bar. Used by divergence
    //         detection to compare price-level vs CVD-level evolution
    //         across consecutive swings.
    float currentCVD  = na
    float lastCVD     = na
    // v20.7 — Previous pivot's bar index (BS-3 fix). Lets the CVD-divergence
    //         magnitude filter normalize by the bar-distance between the two
    //         pivots being compared, so a wide-spaced pivot pair doesn't
    //         inflate "magnitude" purely from accumulating more bars.
    int   lastBarIndex = na

// ── v15.2: wasInside defaults to TRUE — the OB candle itself is by definition
//          inside the zone, so a touch can only count after price has demonstrably
//          exited and returned. This prevents the very first post-creation bar
//          from being miscounted as a "1x" retest.
type orderBlock
    float barHigh
    float barLow
    int   barTime
    int   bias
    int   touchCount         = 0
    int   identifiedBarIndex = 0
    bool  wasInside          = true
    // v18.0 — RVOL stamping at OB creation.
    float originRVOL         = na
    bool  isInstitutional    = false
    // v20.0 — Session-aware tagging + confluence scoring (set at creation).
    //         sessionOrigin: 'Asian' / 'London' / 'NY' / 'Off' based on the
    //           OB candle's hour-of-day in America/New_York.
    //         confluenceScore: 0-3 summing isInstitutional + FVG overlap +
    //           premium/discount zone membership at formation time.
    string sessionOrigin     = ''
    int   confluenceScore    = 0
    // v20.13 — Human-readable breakdown of WHICH confluences scored, so the
    //          OB box can show e.g. "★RF" (RVOL + FVG) instead of a bare
    //          "★2". Letters: R = institutional RVOL, F = FVG overlap,
    //          P = Premium/Discount zone.
    string confluenceTag     = ''

type volumeImbalance
    float top
    float bottom
    int   bias
    box   viBox
    int   createdBarIndex = 0

// v18.0 — One-int wrapper for the EQH/EQL streak counter. Pine forbids
//         modifying a global scalar from inside a function, but mutating a
//         field of a global type instance is fine — same trick we already
//         use for pivots, trends, alerts, and trailingExtremes.
type streakCounter
    int value = 1

// v19.6 — Multi-pool EQH/EQL tracking. Replaces the single
//         validEqHighPool / validEqLowPool. Each pool is anchored at the
//         FIRST pivot that established it (level/actualLevel/anchorBarIdx
//         locked at creation; never overwritten on subsequent in-tolerance
//         matches — only lastTouchBarIdx and streak update). This fixes:
//           (a) the "pool drifts to the freshest pivot" bug — ICT treats
//               the original untouched pool as the magnet, not the latest
//               re-test, and
//           (b) the single-pool-per-side limitation — multiple distinct
//               EQH/EQL clusters at different prices can now coexist and
//               each be sweep-monitored independently.
//         Pools are removed on sweep or clean break-through (close past
//         the level without a wick-and-reverse).
type eqPool
    float level
    float actualLevel
    int   anchorBarIdx
    int   lastTouchBarIdx
    int   streak

type openingGap
    float  top
    float  bottom
    int    startTime
    int    bias
    box    gapBox
    line   ceLine
    label  gapLabel

type sessionTracker
    bool  active
    bool  prevActive
    float sessionHigh
    float sessionLow
    int   sessionStartTime
    int   sessionStartIndex
    box   sessionBox
    label sessionLabel

//──────────────────────────────────────────────────────────────────────────────
// Derived tracking flags
//──────────────────────────────────────────────────────────────────────────────
bool needInternalOBTracking = showInternalOrderBlocksInput or showInternalBreakerBlocksInput
bool needSwingOBTracking    = showSwingOrderBlocksInput    or showSwingBreakerBlocksInput
bool needFVGTracking        = showFairValueGapsInput or showIFVGInput

// v16.7 — Kill Zones, Session Boxes, and Silver Bullet windows are
//         session-of-day concepts grounded in FX/futures/crypto liquidity
//         cycles. They have no meaning on stocks/funds/ADRs/ETFs, so suppress
//         them automatically on equity instruments.
bool isEquityInstrument = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "ietf"

// v16.9 — Gate the eight history ring buffers behind their actual consumers
//         (storeOrderBlock + drawLevels). When OB tracking and MTF level
//         drawing are all off, the 5000-entry buffers no longer accumulate.
// v18.4 — Removed rvolEnableInput from the predicate. OB RVOL is the only
//         consumer of the volumes array; FVG RVOL uses request.security
//         directly. OB RVOL is implicitly gated by OB-tracking inputs
//         (no OBs = no need for the array), so the original cleanup is
//         sufficient — adding rvolEnableInput caused all 8 buffers to
//         accumulate even on RVOL-on-with-no-OB configurations.
bool needHistoryArrays = needInternalOBTracking or needSwingOBTracking or showDailyLevelsInput or showWeeklyLevelsInput or showMonthlyLevelsInput

//──────────────────────────────────────────────────────────────────────────────
// State Variables
//──────────────────────────────────────────────────────────────────────────────
var pivot swingHigh                       = pivot.new(na,na,false)
var pivot swingLow                        = pivot.new(na,na,false)
var pivot internalHigh                    = pivot.new(na,na,false)
var pivot internalLow                     = pivot.new(na,na,false)
var pivot equalHigh                       = pivot.new(na,na,false)
var pivot equalLow                        = pivot.new(na,na,false)

var pivot snapInternalHigh                = pivot.new(na,na,false)
var pivot snapInternalLow                 = pivot.new(na,na,false)
var pivot snapSwingHigh                   = pivot.new(na,na,false)
var pivot snapSwingLow                    = pivot.new(na,na,false)
// v18.8 — Dedicated CVD pivot instances for the 'Custom' pivot source.
//         Detected at cvdCustomPivotLengthInput bars, independently from
//         swing/internal/equal pivot streams.
var pivot cvdCustomHigh                   = pivot.new(na,na,false)
var pivot cvdCustomLow                    = pivot.new(na,na,false)

var trend swingTrend                      = trend.new(0)
var trend internalTrend                   = trend.new(0)

var equalDisplay equalHighDisplay         = equalDisplay.new()
var equalDisplay equalLowDisplay          = equalDisplay.new()

var array<fairValueGap> fairValueGaps     = array.new<fairValueGap>()
var array<fairValueGap> invertedFVGs      = array.new<fairValueGap>()
// v19.7 — parsedHighs / parsedLows removed. After v19.6 dropped the
//         high-vol-bar swap, they held values identical to highs/lows.
//         The OB-fallback max/min scan now slices highs/lows directly.
var array<float> highs                    = array.new<float>()
var array<float> lows                     = array.new<float>()
var array<int>   times                    = array.new<int>()
var array<float> opens                    = array.new<float>()
var array<float> closes                   = array.new<float>()
var array<float> minPens                  = array.new<float>()
// v18.0 — Volume history (gated). Used by RVOL stamping for OBs/FVGs.
var array<float> volumes                  = array.new<float>()
// v18.0 — Volume Imbalance state.
var array<volumeImbalance> volumeImbalances = array.new<volumeImbalance>()

var trailingExtremes trailing             = trailingExtremes.new()
// v20.8 — Impulse-leg anchors for the Impulse Leg OTE mode. Captured at the
//         swing BOS/CHoCH/MSS that sets bias. oteLegVoided latches true when
//         price closes beyond the leg origin (bullish: below legBottom;
//         bearish: above legTop), hiding the zone.
// v20.10 — R1 fix: the leg's TERMINAL extreme (top for bull, bottom for
//          bear) is no longer frozen at the break bar. Price almost always
//          extends past the break before retracing, so freezing there gave a
//          truncated leg and a too-deep OTE band that price could reverse
//          from before ever reaching. Now the origin is fixed at the swing
//          extreme but the terminal extreme TRACKS the running high/low after
//          the break until price first retraces into the zone, at which point
//          oteLegFrozen latches and the band locks (static, placeable). This
//          keeps the no-drift property of v20.8 while capturing the true leg
//          extent.
// v20.12 — Wrapped in a UDT. Pine v6 forbids reassigning a bare global from
//          inside a function; the leg capture happens inside displayStructure()
//          so the state must live as UDT fields (field mutation IS allowed in
//          functions — same pattern as validEqHighPool / streakCounter).
type oteLeg
    float top        = na
    float bottom     = na
    int   anchorTime = na
    bool  voided     = false
    bool  frozen     = false
    // v20.14 — bar_index of the capture (BOS) bar, so the wick-touch freeze
    //          (R1 audit #6) can skip the BOS candle itself — a large
    //          displacement candle's lower wick could otherwise overlap the
    //          provisional zone and freeze a truncated leg immediately.
    int   captureBar = na
var oteLeg oteLegState = oteLeg.new()

var array<orderBlock> swingOrderBlocks    = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes      = array.new<box>()
var array<box> internalOrderBlocksBoxes   = array.new<box>()

var array<orderBlock> swingBreakerBlocks    = array.new<orderBlock>()
var array<orderBlock> internalBreakerBlocks = array.new<orderBlock>()
var array<box> swingBreakerBoxes            = array.new<box>()
var array<box> internalBreakerBoxes         = array.new<box>()

var array<line>  structureLines  = array.new<line>()
var array<label> structureLabels = array.new<label>()
var array<label> swingLabels     = array.new<label>()
var array<line>  eqLines         = array.new<line>()
var array<label> eqLabels        = array.new<label>()

var swingBullishColor        = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor        = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor         = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor        = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput

var bool  swingHighSwept         = false
var bool  swingLowSwept          = false
var bool  anyCloseAboveSwingHigh = false
var bool  anyCloseBelowSwingLow  = false
var int   lastSwingHighBarIdx    = -1
var int   lastSwingLowBarIdx     = -1
// v19.6 — Multi-pool EQH/EQL sweep tracking. Replaces the single
//         validEqHighPool/validEqLowPool (and the eqHighSwept /
//         anyCloseAboveEqHigh / lastEqHighBarIdx latches, which were
//         scalar single-pool state). Each pool's sweep state is
//         implicit: a pool is removed from the array when it sweeps
//         or when price closes cleanly through its level. No separate
//         swept/anyCloseBeyond flag needed since "still in the array"
//         IS the "active and unswept" state.
var array<eqPool> validEqHighPools = array.new<eqPool>()
var array<eqPool> validEqLowPools  = array.new<eqPool>()
// v20.7 — Multi-level swing-sweep watch lists (BS-2 fix). Reuses the eqPool
//         UDT (level / actualLevel / anchorBarIdx) to hold the last N
//         unswept swing highs and lows. A level is pushed when a new swing
//         pivot forms and removed when it's swept or cleanly broken. The
//         anchorBarIdx field dedups against the most-recently-added pivot
//         so the same swing isn't pushed twice.
var array<eqPool> swingHighSweepPools = array.new<eqPool>()
var array<eqPool> swingLowSweepPools  = array.new<eqPool>()
// v20.7.1 — Seed to -1, NOT na. The push guard compares
//           `swingHigh.barIndex != lastSwingHighPushIdx`; with an na sentinel
//           that comparison yields na (falsy), so the first push never fires,
//           the sentinel stays na forever, and the swing-sweep watch lists are
//           never populated (swing Sweep alerts/labels silently dead). Matches
//           the -1 convention used by every other latch index in this file.
var int   lastSwingHighPushIdx  = -1
var int   lastSwingLowPushIdx   = -1
// v17.0 — CVD divergence latching: only re-evaluate on a freshly-formed
//         swing pivot (barIndex change), not on every bar.
var int   lastCVDDivHighIdx      = -1
var int   lastCVDDivLowIdx       = -1
var array<label> sweepLabels     = array.new<label>()
var array<label> displacementLabels = array.new<label>()
var array<label> cvdDivLabels    = array.new<label>()
// v18.0 — Liquidity Pool clustering: consecutive equal-touch streak counts.
//         Wrapped in streakCounter so getCurrentStructure() (a function)
//         can mutate the value via a field assignment.
var streakCounter eqHighStreak = streakCounter.new()
var streakCounter eqLowStreak  = streakCounter.new()
// v18.0 — AVWAP from latest MSS.
// v18.4 — Now anchor-type aware; lastAvwapSwingHighIdx / lastAvwapSwingLowIdx
//         track swing-pivot transitions for the 'Swing' anchor mode.
var int   mssAvwapAnchorTime     = na
var int   mssAvwapAnchorBar      = na
var float mssAvwapCumPV          = 0.0
var float mssAvwapCumVol         = 0.0
var float mssAvwapValue          = na
var bool  mssAvwapResetThisBar   = false
var int   lastAvwapSwingHighIdx  = -1
var int   lastAvwapSwingLowIdx   = -1
// v18.1 — PO3 phase tracking state removed.

var sessionTracker sydneySession  = sessionTracker.new(false, false, na, na, na, na, na, na)
var sessionTracker tokyoSession   = sessionTracker.new(false, false, na, na, na, na, na, na)
var sessionTracker londonSession  = sessionTracker.new(false, false, na, na, na, na, na, na)
var sessionTracker nySession      = sessionTracker.new(false, false, na, na, na, na, na, na)

var array<box>   sessionBoxes   = array.new<box>()
var array<label> sessionLabsArr = array.new<label>()
var array<openingGap> ndogGaps = array.new<openingGap>()
var array<openingGap> nwogGaps = array.new<openingGap>()
// v19.3 — ICT NY-anchored NWOG state. Latches the open price of the bar
//         covering Friday 17:00 ET as the "prev close", then on Sunday
//         17:00 ET captures the open as the "curr open" and triggers
//         createOpeningGap once. Stored as nz-able floats so the
//         createOpeningGap guard rejects them until both legs land.
var float nwogICTPrevClose = na
var float nwogICTCurrOpen  = na
// v20.15 — Latches true on the bar a NWOG is actually created, in EITHER
//          anchor mode, so the "Opening Gap Formed" alert fires in sync with
//          the drawn gap. Pre-v20.15 the alert always used the TV-week
//          (isNewWeek / nwogPrevClose / nwogCurrOpen) condition, so in ICT NY
//          mode the alert fired on the TV week boundary while the gap was
//          drawn on the Fri/Sun NY boundary — they disagreed.
var bool nwogFormedThisBar = false

var array<line> swingOBCELines      = array.new<line>()
var array<line> internalOBCELines   = array.new<line>()
var array<line> swingBBCELines      = array.new<line>()
var array<line> internalBBCELines   = array.new<line>()

var float asianRangeHigh      = na
var float asianRangeLow       = na
var bool  asianPrevActive     = false
var float midnightOpenPrice   = na
var bool  midnightPrevActive  = false
var int   asianRangeStartTime = na

var float londonRangeHigh      = na
var float londonRangeLow       = na
var bool  londonPrevActive     = false
var int   londonRangeStartTime = na

var float nyRangeHigh          = na
var float nyRangeLow           = na
var bool  nyPrevActive         = false
var int   nyRangeStartTime     = na

var float ibHigh               = na
var float ibLow                = na
var bool  ibPrevActive         = false
var int   ibStartTime          = na
// v17.0 — displacementBull/BearFlag/Offset pattern removed; the marker
//         emitter now consumes currentAlerts.{internal,swing}{Bullish,
//         Bearish}MSSOffset directly, which fixes the offset-collision bug
//         where shared bullish/bearishMSSOffset fields got overwritten.

// v15.4 — Initialise to -1 so that on the very first realtime bar
//         currentBarIndex != lastBarIndex → newBar = true.
//         Previously both initialised to bar_index (== 0 at declaration),
//         making newBar false on bar 0. Safe because newBar is only read
//         inside barstate.isrealtime guards which skip historical bars.
varip int currentBarIndex    = -1
varip int lastBarIndex       = -1

alerts currentAlerts         = alerts.new()

//──────────────────────────────────────────────────────────────────────────────
// Initialization
//──────────────────────────────────────────────────────────────────────────────
if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right))
    if showSwingBreakerBlocksInput
        for index = 1 to swingBreakerBlocksSizeInput
            swingBreakerBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right,border_style=line.style_dashed))
    if showInternalBreakerBlocksInput
        for index = 1 to internalBreakerBlocksSizeInput
            internalBreakerBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right,border_style=line.style_dashed))
    if showCEMidlinesInput
        if showSwingOrderBlocksInput
            for index = 1 to swingOrderBlocksSizeInput
                swingOBCELines.push(line.new(na,na,na,na, xloc=xloc.bar_time, style=line.style_dotted, width=1, extend=extend.right))
        if showInternalOrderBlocksInput
            for index = 1 to internalOrderBlocksSizeInput
                internalOBCELines.push(line.new(na,na,na,na, xloc=xloc.bar_time, style=line.style_dotted, width=1, extend=extend.right))
        if showSwingBreakerBlocksInput
            for index = 1 to swingBreakerBlocksSizeInput
                swingBBCELines.push(line.new(na,na,na,na, xloc=xloc.bar_time, style=line.style_dotted, width=1, extend=extend.right))
        if showInternalBreakerBlocksInput
            for index = 1 to internalBreakerBlocksSizeInput
                internalBBCELines.push(line.new(na,na,na,na, xloc=xloc.bar_time, style=line.style_dotted, width=1, extend=extend.right))

//──────────────────────────────────────────────────────────────────────────────
// Utilities
//──────────────────────────────────────────────────────────────────────────────
copyPivot(pivot dst, pivot src) =>
    dst.currentLevel := src.currentLevel
    dst.lastLevel    := src.lastLevel
    dst.crossed      := src.crossed
    dst.barTime      := src.barTime
    dst.barIndex     := src.barIndex
    dst.actualLevel  := src.actualLevel
    dst.currentCVD   := src.currentCVD
    dst.lastCVD      := src.lastCVD

//──────────────────────────────────────────────────────────────────────────────
// Volatility & Parsing
//──────────────────────────────────────────────────────────────────────────────
// v15.4 — Three mitigation modes:
//   Close    → close must cross (most conservative)
//   Body     → candle body edge must cross (ICT standard, filters wick sweeps)
//   High/Low → any wick crossing counts (most aggressive)
bearishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE_SRC ? close
     : orderBlockMitigationInput == BODY_SRC ? math.max(open, close)
     : high
bullishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE_SRC ? close
     : orderBlockMitigationInput == BODY_SRC ? math.min(open, close)
     : low

atrMeasure        = nz(ta.atr(200), ta.atr(14))
// v20.7 — Fast ATR for displacement + structure-quality only (BS-4 fix).
//         Falls back through shorter lengths during warm-up, then to
//         atrMeasure, so it's never na after the first few bars.
float dispQualityATR = nz(ta.atr(dispQualityATRLenInput), nz(ta.atr(14), atrMeasure))
// v20.9 — Volume-availability latch (RVOL audit #3). Latches true once any
//         bar carries real volume. On volumeless feeds (FX cash, some
//         indices) it stays false forever, so every RVOL-derived effect
//         (institutional flag, ★ confluence point, dimming, retail-trap
//         alert) can be gated off instead of misfiring on zero-volume data.
var bool rvolVolumeAvailable = false
if nz(volume) > 0
    rvolVolumeAvailable := true
// v20.0 — Effective EQH/EQL tolerance: max of ATR-fraction and ticks floor.
//         Computed once per bar so all four detection / pool-update sites
//         use the same value. When the ticks-floor input is 0 (default),
//         this collapses to the legacy ATR-only behavior.
float eqEffectiveThreshold = math.max(equalHighsLowsThresholdInput * atrMeasure, equalHighsLowsTicksInput * syminfo.mintick)
float minPen      = math.max(atrMeasure * minPenetrationFactorInput, minPenetrationTicksInput * syminfo.mintick)
// v19.2 — Non-ATR branch was ta.cum(ta.tr)/bar_index, a running mean
//         from chart start. That introduced chart-history dependence
//         (backtest results varied with how much history TradingView
//         loaded). Replaced with a 500-bar rolling SMA of TR, which
//         preserves the "long-window arithmetic mean true range"
//         intent without depending on the chart's earliest bar.
//         Falls back to atrMeasure (already na-guarded) during warm-up.
volatilityMeasure = orderBlockFilterInput == ATR ? atrMeasure : nz(ta.sma(ta.tr, 500), atrMeasure)
highVolatilityBar = (high - low) >= (2 * volatilityMeasure)
// v19.6 — Removed the wide-range bar swap. Wide bars now contribute their
//         actual high/low to the OB fallback's max/min search (ICT treats
//         displacement candles as strong OB candidates). The
//         volatilityMeasure / highVolatilityBar flag remains computed
//         in case a downstream consumer needs it (none currently).
// v19.7 — parsedHigh / parsedLow local assignments removed alongside the
//         parsedHighs / parsedLows arrays; the fallback scan now uses
//         highs / lows directly.

// v17.0 — CVD (Cumulative Volume Delta).
//         Per-bar delta = volume × close-position weight, where weight is +1
//         at the high, −1 at the low, 0 at the midpoint. This approximates
//         buy/sell pressure without true tick data. Fallback for zero-range
//         bars uses sign(close − open).
//         Gated behind needCVD so volume-less symbols and disabled state
//         contribute zero rather than NaNs to ta.cum().
bool  needCVD       = showCVDDivergenceInput or showCVDTableInput
float cvdRange      = high - low
float cvdWeight     = cvdRange > 0 ? (2 * close - high - low) / cvdRange : math.sign(close - open)
float cvdBarDelta   = needCVD ? cvdWeight * nz(volume) : 0.0
// v19.2 — Note: ta.cum() accumulates from the chart's first bar, so the
//         ABSOLUTE value of cumCVD shifts when TradingView loads more or
//         less history. This is intrinsic to a cumulative metric (Pine
//         has no notion of "true session zero"). The CVD-divergence
//         consumer is unaffected because it compares snapshot DELTAS at
//         consecutive pivots (cumCVD[pivot_n] vs cumCVD[pivot_n-1]) —
//         the chart-start offset cancels. Only the CVD-table bias-sign
//         cell carries the chart-history dependence, which is a coarse
//         direction read rather than a backtest-critical value.
float cumCVD        = ta.cum(cvdBarDelta)
// v15.3 — lookahead_off avoids future-bar leakage; the value is constant
//         per bar (bar duration) so lookahead_on is unnecessary anyway.
htfBarDuration    = nz(
    request.security(syminfo.tickerid, fairValueGapsTimeframeInput, time - time[1], lookahead = barmerge.lookahead_off),
    time - time[1])

//───────────────────────────────────────────────────  ──────────────────────────
// Displacement detection for MSS
//──────────────────────────────────────────────────────────────────────────────
isDisplacementCandle(int offset, bool bullishBreak) =>
    float body      = math.abs(close[offset] - open[offset])
    float rng       = high[offset] - low[offset]
    float bodyRatio = rng > 0 ? body / rng : 0
    // v20.7 — Use the fast displacement/quality ATR instead of ATR(200)
    //         so MSS sensitivity tracks the current volatility regime.
    float atrAtBar  = nz(dispQualityATR[offset], dispQualityATR)
    bool  sizeOk    = body > mssATRMultInput * atrAtBar
    bool  ratioOk   = bodyRatio >= mssBodyRatioInput
    bool  dirMatch  = bullishBreak ? (close[offset] > open[offset]) : (close[offset] < open[offset])
    sizeOk and ratioOk and dirMatch

displacementOffset(bool bullishBreak) =>
    int foundOffset = int(na)
    for i = 0 to mssDisplacementLookbackInput - 1
        if na(foundOffset) and isDisplacementCandle(i, bullishBreak)
            foundOffset := i
    foundOffset

isDisplacement(bool bullishBreak) =>
    not na(displacementOffset(bullishBreak))

//──────────────────────────────────────────────────────────────────────────────
// Previous Day / Week data — global scope
//──────────────────────────────────────────────────────────────────────────────
[pdHigh, pdLow, pdOpen, pdClose, cdOpen] = request.security(
     syminfo.tickerid, 'D',
     [high[1], low[1], open[1], close[1], open],
     lookahead=barmerge.lookahead_on)

[pwHigh, pwLow, nwogPrevClose, nwogCurrOpen] = request.security(
    syminfo.tickerid, 'W',
    [high[1], low[1], close[1], open],
    lookahead=barmerge.lookahead_on)

bool isNewDay  = ta.change(time('D')) != 0
bool isNewWeek = ta.change(time('W')) != 0

currentDayStartTime  = request.security(syminfo.tickerid, 'D', time,
     lookahead=barmerge.lookahead_on)
// v19.2 — Mirror of currentDayStartTime for weekly anchoring. Used by
//         drawPDLevel() so PWH / PWL lines start at the current week's
//         open instead of today's open (which is what currentDayStartTime
//         provides). The previous-week values themselves (pwHigh / pwLow)
//         were already correct; only the line's left anchor was wrong.
currentWeekStartTime = request.security(syminfo.tickerid, 'W', time,
     lookahead=barmerge.lookahead_on)

pushBounded(array<float> arr, float val) =>
    arr.push(val)
    if arr.size() > MAX_ARRAY_SIZE
        arr.shift()

pushBoundedInt(array<int> arr, int val) =>
    arr.push(val)
    if arr.size() > MAX_ARRAY_SIZE
        arr.shift()

if needHistoryArrays
    // v19.7 — parsedHighs / parsedLows pushes removed (arrays deleted).
    pushBounded(highs,       high)
    pushBounded(lows,        low)
    pushBoundedInt(times,    time)
    pushBounded(opens,       open)
    pushBounded(closes,      close)
    pushBounded(minPens,     minPen)
    pushBounded(volumes,     nz(volume))

//──────────────────────────────────────────────────────────────────────────────
// Pre-compute crossovers at global scope
//──────────────────────────────────────────────────────────────────────────────
float internalHighLevel = internalHigh.currentLevel
float internalLowLevel  = internalLow.currentLevel
float swingHighLevel    = swingHigh.currentLevel
float swingLowLevel     = swingLow.currentLevel

bool rawCrossOverInternalHigh  = ta.crossover(close,  nz(internalHighLevel))
bool rawCrossUnderInternalLow  = ta.crossunder(close, nz(internalLowLevel))
bool rawCrossOverSwingHigh     = ta.crossover(close,  nz(swingHighLevel))
bool rawCrossUnderSwingLow     = ta.crossunder(close, nz(swingLowLevel))

bool crossOverInternalHigh  = rawCrossOverInternalHigh  and not na(internalHighLevel) and not na(internalHighLevel[1])
bool crossUnderInternalLow  = rawCrossUnderInternalLow  and not na(internalLowLevel)  and not na(internalLowLevel[1])
bool crossOverSwingHigh     = rawCrossOverSwingHigh     and not na(swingHighLevel)     and not na(swingHighLevel[1])
bool crossUnderSwingLow     = rawCrossUnderSwingLow     and not na(swingLowLevel)      and not na(swingLowLevel[1])

//──────────────────────────────────────────────────────────────────────────────
// Bilateral pivot detection
//──────────────────────────────────────────────────────────────────────────────
bodyHigh = pivotSourceInput == 'Wick' ? high : math.max(open, close)
bodyLow  = pivotSourceInput == 'Wick' ? low  : math.min(open, close)

leg(int size) =>
    var int currentLeg = -1
    // v15.3 — Bars before 2*size cannot have enough left-side history to
    //         validate a pivot. Without this guard, leftHighOk/leftLowOk
    //         remain vacuously true (na comparisons return false in Pine v6,
    //         so the inner loop never invalidates the candidate) and bogus
    //         early pivots seed the swing/internal structure.
    if bar_index >= 2 * size
        candidate_bh = bodyHigh[size]
        candidate_bl = bodyLow[size]
        bool rightHighOk = true
        bool rightLowOk  = true
        for i = 0 to size - 1
            if bodyHigh[i] >= candidate_bh
                rightHighOk := false
            if bodyLow[i] <= candidate_bl
                rightLowOk := false
        bool leftHighOk = true
        bool leftLowOk  = true
        for i = size + 1 to 2 * size
            if bodyHigh[i] >= candidate_bh
                leftHighOk := false
            if bodyLow[i] <= candidate_bl
                leftLowOk := false
        bool isSwingHigh = rightHighOk and leftHighOk
        bool isSwingLow  = rightLowOk  and leftLowOk
        if isSwingHigh and isSwingLow
            float actualBodyH = math.max(open[size], close[size])
            float actualBodyL = math.min(open[size], close[size])
            upperWick = high[size] - actualBodyH
            lowerWick = actualBodyL - low[size]
            if upperWick >= lowerWick
                currentLeg := BEARISH_LEG
            else
                currentLeg := BULLISH_LEG
        else if isSwingHigh
            currentLeg := BEARISH_LEG
        else if isSwingLow
            currentLeg := BULLISH_LEG
    currentLeg

startOfNewLeg(int l_eg) =>
    int change = ta.change(l_eg)
    bool firstEver = nz(l_eg[1], -1) < 0
    l_eg >= 0 and (firstEver or change != 0)

startOfBearishLeg(int l_eg) =>
    int change = ta.change(l_eg)
    bool firstEver = nz(l_eg[1], -1) < 0
    l_eg == BEARISH_LEG and (firstEver or change != 0)

startOfBullishLeg(int l_eg) =>
    int change = ta.change(l_eg)
    bool firstEver = nz(l_eg[1], -1) < 0
    l_eg == BULLISH_LEG and (firstEver or change != 0)

//──────────────────────────────────────────────────────────────────────────────
// Managed drawing creation with ring buffer cleanup
//──────────────────────────────────────────────────────────────────────────────
managedSwingLabel(chart.point p, string txt, string xloc_val, color bgCol, color txtCol, string style, string sz) =>
    label l = label.new(p, txt, xloc_val, color=bgCol, textcolor=txtCol, style=style, size=sz)
    if modeInput == HISTORICAL
        swingLabels.push(l)
        if swingLabels.size() > MAX_SWING_LABELS
            label.delete(swingLabels.shift())
    l

managedEqLine(chart.point p1, chart.point p2, color col, string style) =>
    line l = line.new(p1, p2, xloc=xloc.bar_time, color=col, style=style)
    if modeInput == HISTORICAL
        eqLines.push(l)
        if eqLines.size() > MAX_EQ_LINES
            line.delete(eqLines.shift())
    l

managedEqLabel(chart.point p, string txt, string xloc_val, color bgCol, color txtCol, string style, string sz) =>
    label l = label.new(p, txt, xloc_val, color=bgCol, textcolor=txtCol, style=style, size=sz)
    if modeInput == HISTORICAL
        eqLabels.push(l)
        if eqLabels.size() > MAX_EQ_LABELS
            label.delete(eqLabels.shift())
    l

//──────────────────────────────────────────────────────────────────────────────
// Drawing Helpers
//───────────────  ──────────────────────────────────────────────────────────────
drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na
    if modeInput == PRESENT
        l_abel.delete()
    l_abel := managedSwingLabel(chart.point.new(labelTime,na,labelPrice), tag, xloc.bar_time, color(na), labelColor, labelStyle, size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool isEqualHigh) =>
    equalDisplay e_qualDisplay = isEqualHigh ? equalHighDisplay : equalLowDisplay
    // v18.0 — Liquidity Pool clustering. Streak counter promotes 'EQH' →
    //         'EQH×N' once the same level has been kissed twice or more,
    //         making 3+ equal touches visible at a glance as a high-
    //         conviction sweep target.
    int streakRef = isEqualHigh ? eqHighStreak.value : eqLowStreak.value
    string countSuffix = streakRef >= 2 ? '×' + str.tostring(streakRef) : ''
    string tag        = 'EQL' + countSuffix
    color  equalColor = swingBullishColor
    string labelStyle = label.style_label_up
    if isEqualHigh
        tag        := 'EQH' + countSuffix
        equalColor := swingBearishColor
        labelStyle := label.style_label_down
    if modeInput == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)
    e_qualDisplay.l_ine  := managedEqLine(
         chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel),
         chart.point.new(time[size],na,level),
         equalColor, line.style_dotted)
    labelPosition        = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel := managedEqLabel(
         chart.point.new(na,labelPosition,level),
         tag, xloc.bar_index, color(na), equalColor, labelStyle, equalHighsLowsSizeInput)

//──────────────────────────────────────────────────────────────────────────────
// v19.6 — Multi-pool EQH/EQL helper. Used by getCurrentStructure when an
//         EQ-tolerance match is detected. Returns the streak count to use
//         for the EQH×N label.
//
// Behavior:
//   • If candLevel is within `threshold` of any existing pool's level →
//     increment that pool's streak (or reset to 1 if matched-too-stale),
//     update its lastTouchBarIdx, and return the updated streak. The
//     pool's anchor level/wick are NEVER overwritten — fixes the audit's
//     "EQ pool drifts to freshest pivot" finding.
//   • If no existing pool matches → create a new pool anchored at
//     (anchorLevel, anchorActual, anchorBarIdx) = the FIRST occurrence
//     (the previous pivot, not the new candidate). Streak starts at 2
//     since this represents two confirmed pivots at the same level.
//     Trim pool array to MAX_EQ_POOLS by popping the oldest.
//──────────────────────────────────────────────────────────────────────────────
updateEqPools(array<eqPool> pools, float candLevel, int candBarIdx, float anchorLevel, float anchorActual, int anchorBarIdx, float threshold, int maxStale) =>
    int resultStreak = 2
    bool matched     = false
    int sz           = pools.size()
    if sz > 0
        for i = 0 to sz - 1
            eqPool ep = pools.get(i)
            if math.abs(ep.level - candLevel) <= threshold   // v20.15 — <= so threshold 0 = exact-match (audit #10)
                bool tooStale = maxStale > 0 and (candBarIdx - ep.lastTouchBarIdx) > maxStale
                if tooStale
                    ep.streak := 1
                else
                    ep.streak := ep.streak + 1
                ep.lastTouchBarIdx := candBarIdx
                resultStreak := ep.streak
                matched := true
                break
    if not matched
        eqPool newPool = eqPool.new(anchorLevel, anchorActual, anchorBarIdx, candBarIdx, 2)
        pools.unshift(newPool)
        // v19.9 — Evict by lowest streak, NOT by age. ICT trades the
        //         strongest pools (highest touch count = most accumulated
        //         stops). Original `pools.pop()` evicted the oldest
        //         indiscriminately, which could throw away a long-running
        //         multi-touch pool to make room for a fresh single-touch
        //         level. New policy: scan index 1..n (skip the freshly
        //         unshifted pool at index 0 so new pools always get a
        //         chance to accumulate touches), find the pool with the
        //         lowest streak, drop it. On ties the lower-index (newer)
        //         existing pool loses, keeping older confirmed levels.
        while pools.size() > MAX_EQ_POOLS
            int weakestIdx     = 1
            int weakestStreak  = pools.get(1).streak
            int searchTo       = pools.size() - 1
            if searchTo >= 2
                for k = 2 to searchTo
                    if pools.get(k).streak < weakestStreak
                        weakestStreak := pools.get(k).streak
                        weakestIdx    := k
            pools.remove(weakestIdx)
        resultStreak := 2
    resultStreak

//──────────────────────────────────────────────────────────────────────────────
// getCurrentStructure
//──────────────────────────────────────────────────────────────────────────────
getCurrentStructure(int size, bool equalHighLow = false, bool internal = false) =>
    currentLeg = leg(size)
    newPivot   = startOfNewLeg(currentLeg)
    pivotLow   = startOfBullishLeg(currentLeg)
    pivotHigh  = startOfBearishLeg(currentLeg)
    if newPivot
        if pivotLow
            pivot p_ivot = equalHighLow ? equalLow : internal ? internalLow : swingLow
            // v18.9 — EQ-specific pivot source override.
            string eqEffectiveSourceLow = equalHighLow and eqPivotComparisonInput != 'Follow Main' ? eqPivotComparisonInput : pivotSourceInput
            float candidateBodyLow = eqEffectiveSourceLow == 'Wick' ? low[size] : math.min(open[size], close[size])
            // v18.0 — Liquidity Pool streak counter. Increment on consecutive
            //         in-tolerance equal pivots; reset to 1 on a non-EQ pivot.
            // v18.8 — Optional freshness timeout: matches more than
            //         eqMaxBarsBetweenMatchesInput bars apart still draw the
            //         label but reset the streak count, preventing stale
            //         cumulative x N badges spanning unrelated visits.
            if equalHighLow and not na(p_ivot.currentLevel)
                if math.abs(p_ivot.currentLevel - candidateBodyLow) <= eqEffectiveThreshold   // v20.15 — <= (audit #10)
                    // v19.6 — Multi-pool: anchor at p_ivot (the FIRST pivot),
                    //         pass the new candidate as the "match" bar.
                    //         Streak comes from the pool, not a global counter.
                    // v20.0 — Use eqEffectiveThreshold (ATR or ticks-floor max).
                    int newStreak = updateEqPools(
                         validEqLowPools, candidateBodyLow, bar_index[size],
                         p_ivot.currentLevel, p_ivot.actualLevel, p_ivot.barIndex,
                         eqEffectiveThreshold,
                         eqMaxBarsBetweenMatchesInput)
                    eqLowStreak.value := newStreak
                    // v19.9 — Gate label drawing + alert on barstate.isconfirmed
                    //         so realtime ticks within the same forming bar
                    //         don't pile up duplicate EQL labels. Pool state
                    //         above is intentionally NOT gated — pool tracking
                    //         needs to update each tick so the streak count
                    //         is current; only the visual/alert outputs need
                    //         confirmation.
                    if barstate.isconfirmed
                        drawEqualHighLow(p_ivot, candidateBodyLow, size, false)
                        currentAlerts.equalLows := true
                else
                    eqLowStreak.value := 1
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.lastBarIndex := p_ivot.barIndex   // v20.7 — capture before overwrite (BS-3)
            p_ivot.currentLevel := candidateBodyLow
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            p_ivot.actualLevel  := low[size]
            // v17.0 — Snapshot CVD at the pivot bar for divergence detection.
            // v18.6 — Now also snapshots on internal pivots so users can
            //         opt into faster CVD divergence via the
            //         cvdUseInternalPivotsInput toggle. equalHighLow is still
            //         excluded because EQ pivots aren't a directional swing.
            if not equalHighLow
                p_ivot.lastCVD    := p_ivot.currentCVD
                p_ivot.currentCVD := cumCVD[size]
            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh
            // v18.9 — EQ-specific pivot source override.
            string eqEffectiveSourceHigh = equalHighLow and eqPivotComparisonInput != 'Follow Main' ? eqPivotComparisonInput : pivotSourceInput
            float candidateBodyHigh = eqEffectiveSourceHigh == 'Wick' ? high[size] : math.max(open[size], close[size])
            // v18.0 — Liquidity Pool streak counter (high side).
            // v18.8 — Optional freshness timeout (see low-side branch above).
            if equalHighLow and not na(p_ivot.currentLevel)
                if math.abs(p_ivot.currentLevel - candidateBodyHigh) <= eqEffectiveThreshold   // v20.15 — <= (audit #10)
                    // v19.6 — Multi-pool: see low-side comment for rationale.
                    // v20.0 — Use eqEffectiveThreshold (ATR or ticks-floor max).
                    int newStreakH = updateEqPools(
                         validEqHighPools, candidateBodyHigh, bar_index[size],
                         p_ivot.currentLevel, p_ivot.actualLevel, p_ivot.barIndex,
                         eqEffectiveThreshold,
                         eqMaxBarsBetweenMatchesInput)
                    eqHighStreak.value := newStreakH
                    // v19.9 — see low-side comment.
                    if barstate.isconfirmed
                        drawEqualHighLow(p_ivot, candidateBodyHigh, size, true)
                        currentAlerts.equalHighs := true
                else
                    eqHighStreak.value := 1
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.lastBarIndex := p_ivot.barIndex   // v20.7 — capture before overwrite (BS-3)
            p_ivot.currentLevel := candidateBodyHigh
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            p_ivot.actualLevel  := high[size]
            // v17.0 / v18.6 — Snapshot CVD at the pivot bar (both swing and
            //                 internal; selection happens at divergence-check time).
            if not equalHighLow
                p_ivot.lastCVD    := p_ivot.currentCVD
                p_ivot.currentCVD := cumCVD[size]
            if not equalHighLow and not internal
                trailing.top         := p_ivot.currentLevel
                trailing.barTime     := p_ivot.barTime
                trailing.barIndex    := p_ivot.barIndex
                trailing.lastTopTime := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

//──────────────────────────────────────────────────────────────────────────────
// v18.8 — Custom CVD pivot detection
//   Self-contained pivot detector for the 'Custom' CVD pivot source. Mirrors
//   the swing-pivot logic in getCurrentStructure() but writes into the
//   dedicated cvdCustomHigh / cvdCustomLow instances at user-set length.
//   leg() / startOfBullish-Bearish-Leg() maintain per-call-site state, so
//   this runs independently of the main swing detector.
//──────────────────────────────────────────────────────────────────────────────
detectCVDCustomPivot(int size) =>
    int curLeg = leg(size)
    if startOfBullishLeg(curLeg)
        cvdCustomLow.lastLevel    := cvdCustomLow.currentLevel
        cvdCustomLow.lastBarIndex := cvdCustomLow.barIndex   // v20.7 — BS-3
        cvdCustomLow.currentLevel := pivotSourceInput == 'Wick' ? low[size] : math.min(open[size], close[size])
        cvdCustomLow.crossed      := false
        cvdCustomLow.barTime      := time[size]
        cvdCustomLow.barIndex     := bar_index[size]
        cvdCustomLow.actualLevel  := low[size]
        cvdCustomLow.lastCVD      := cvdCustomLow.currentCVD
        cvdCustomLow.currentCVD   := cumCVD[size]
    else if startOfBearishLeg(curLeg)
        cvdCustomHigh.lastLevel    := cvdCustomHigh.currentLevel
        cvdCustomHigh.lastBarIndex := cvdCustomHigh.barIndex   // v20.7 — BS-3
        cvdCustomHigh.currentLevel := pivotSourceInput == 'Wick' ? high[size] : math.max(open[size], close[size])
        cvdCustomHigh.crossed      := false
        cvdCustomHigh.barTime      := time[size]
        cvdCustomHigh.barIndex     := bar_index[size]
        cvdCustomHigh.actualLevel  := high[size]
        cvdCustomHigh.lastCVD      := cvdCustomHigh.currentCVD
        cvdCustomHigh.currentCVD   := cumCVD[size]

//──────────────────────────────────────────────────────────────────────────────
// Structure Drawing
//──────────────────────────────────────────────────────────────────────────────
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line  l_ine  = line.new(na,na,na,na,xloc=xloc.bar_time)
    var label l_abel = label.new(na,na)
    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()
    l_ine  := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size=labelSize)
    if modeInput == HISTORICAL
        structureLines.push(l_ine)
        if structureLines.size() > MAX_STRUCTURE_LINES
            line.delete(structureLines.shift())
        structureLabels.push(l_abel)
        if structureLabels.size() > MAX_STRUCTURE_LABELS
            label.delete(structureLabels.shift())

//──────────────────────────────────────────────────────────────────────────────
// Order Block deletion → Breaker conversion
//──────────────────────────────────────────────────────────────────────────────

// ── v15.2: Edge-detection touch counting (outside→inside transition only) ────
//   • A touch is only registered when price transitions from OUTSIDE the zone
//     to INSIDE on a confirmed bar. Bars that simply remain inside count as
//     a single test, fixing the 1x→2x→3x stall-bug from v15.0.
//   • The "still-alive" check now reuses the SAME mitigation sources that
//     deleteOrderBlocks() consults (bullishOrderBlockMitigationSource /
//     bearishOrderBlockMitigationSource). This guarantees that touch counting
//     and OB removal agree on whether the block is still valid on this bar
//     — respecting the user's CLOSE vs. HIGH/LOW mitigation preference.
updateOrderBlockTouches(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    int sz = orderBlocks.size()
    if sz > 0
        for index = sz - 1 to 0
            orderBlock ob = orderBlocks.get(index)
            // Skip OBs identified this bar (creation bar price is inside zone by definition)
            if ob.identifiedBarIndex >= bar_index
                continue

            // Range overlap with the OB zone on the current bar
            bool overlaps = high >= ob.barLow and low <= ob.barHigh

            // Mirror deleteOrderBlocks(), including minimum penetration.
            bool mitigated = ob.bias == BULLISH
                 ? bullishOrderBlockMitigationSource < ob.barLow and (ob.barLow - bullishOrderBlockMitigationSource) >= minPen
                 : bearishOrderBlockMitigationSource > ob.barHigh and (bearishOrderBlockMitigationSource - ob.barHigh) >= minPen

            bool nowInside = overlaps and not mitigated

            // Only count a touch on the outside→inside transition.
            // Consecutive bars sitting inside the zone count as ONE touch.
            if nowInside and not ob.wasInside
                ob.touchCount += 1

            // Remember state for next bar
            ob.wasInside := nowInside

            // Remove OB once it has been tested the maximum number of times
            if ob.touchCount >= maxOBTouchesInput
                orderBlocks.remove(index)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    int sz = orderBlocks.size()
    if sz > 0
        for index = sz - 1 to 0
            orderBlock eachOrderBlock = orderBlocks.get(index)
            bool crossed = false
            if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and (bearishOrderBlockMitigationSource - eachOrderBlock.barHigh) >= minPen and eachOrderBlock.bias == BEARISH
                crossed := true
                if internal
                    currentAlerts.internalBearishOrderBlock := true
                else
                    currentAlerts.swingBearishOrderBlock := true
                // v20.0 — Retail-trap: low-RVOL OB just broke. Shared alert
                //         with the FVG-mitigation branch.
                // v20.9 — RVOL audit #2/#3: require a REAL low reading, not
                //         "unmeasured". Pre-v20.9 `not isInstitutional` was
                //         also true when RVOL was na (volumeless symbol,
                //         warm-up), so the trap fired on blocks whose volume
                //         was never measured. Now gated on volume being
                //         available AND originRVOL actually computed AND below
                //         threshold.
                if lowRvolBreakAlertInput and rvolEnableInput and rvolVolumeAvailable and not na(eachOrderBlock.originRVOL) and not eachOrderBlock.isInstitutional
                    currentAlerts.lowRvolBlockBroken := true
            else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and (eachOrderBlock.barLow - bullishOrderBlockMitigationSource) >= minPen and eachOrderBlock.bias == BULLISH
                crossed := true
                if internal
                    currentAlerts.internalBullishOrderBlock := true
                else
                    currentAlerts.swingBullishOrderBlock := true
                // v20.0 — Retail-trap: low-RVOL OB just broke (bullish side).
                // v20.9 — See bearish-side comment (require real low reading).
                if lowRvolBreakAlertInput and rvolEnableInput and rvolVolumeAvailable and not na(eachOrderBlock.originRVOL) and not eachOrderBlock.isInstitutional
                    currentAlerts.lowRvolBlockBroken := true
            if crossed
                bool shouldConvert = internal ? showInternalBreakerBlocksInput : showSwingBreakerBlocksInput
                if shouldConvert
                    int newBias = eachOrderBlock.bias == BULLISH ? BEARISH : BULLISH
                    // wasInside = true on conversion: the bar that mitigated the OB
                    // is, by construction, interacting with the zone that becomes the
                    // breaker. Without this, the very next bar's overlap would falsely
                    // register as the breaker's first retest.
                    // v18.0 — Inherit parent OB's RVOL stamp on BB conversion.
                    orderBlock breaker = orderBlock.new(
                         eachOrderBlock.barHigh,
                         eachOrderBlock.barLow,
                         eachOrderBlock.barTime,
                        newBias,
                        0,
                        bar_index,
                        true,
                        eachOrderBlock.originRVOL,
                        eachOrderBlock.isInstitutional,
                        // v20.0 — Inherit parent OB's session origin and
                        //         confluence score on Breaker conversion.
                        eachOrderBlock.sessionOrigin,
                        eachOrderBlock.confluenceScore,
                        eachOrderBlock.confluenceTag)
                    array<orderBlock> breakers = internal ? internalBreakerBlocks : swingBreakerBlocks
                    if breakers.size() >= MAX_BREAKER_COUNT
                        breakers.pop()
                    breakers.unshift(breaker)
                    if newBias == BULLISH
                        currentAlerts.bullishBreakerFormed := true
                    else
                        currentAlerts.bearishBreakerFormed := true
                orderBlocks.remove(index)

toArrayIndex(int absIndex) =>
    int arrSize = times.size()
    int offset  = bar_index - (arrSize - 1)
    int result  = absIndex - offset
    if result < 0 or result >= arrSize
        int(na)
    else
        result

// v15.3 — Skip the bar on which the BB was created. Without this guard, the
//         very same wick that mitigated the parent OB would, on the bar of
//         conversion, be (incorrectly) re-evaluated against the freshly minted
//         breaker zone — gap opens through the OB level were silently killing
//         the breaker before any touch counting could occur.
deleteBreakerBlocks(bool internal = false) =>
    array<orderBlock> breakers = internal ? internalBreakerBlocks : swingBreakerBlocks
    int sz = breakers.size()
    if sz > 0
        for index = sz - 1 to 0
            orderBlock bb = breakers.get(index)
            if bb.identifiedBarIndex >= bar_index
                continue

            bool crossedAbove = bearishOrderBlockMitigationSource > bb.barHigh and (bearishOrderBlockMitigationSource - bb.barHigh) >= minPen
            bool crossedBelow = bullishOrderBlockMitigationSource < bb.barLow and (bb.barLow - bullishOrderBlockMitigationSource) >= minPen

            // Skip the immediate next bar if it gaps fully beyond the breaker
            // zone. Price never traded back through the zone, so do not treat it
            // as a normal mitigation.
            bool immediateNoTradeThroughZone = bb.identifiedBarIndex == bar_index - 1 and
                 (bb.bias == BEARISH ? low > bb.barHigh and crossedAbove : high < bb.barLow and crossedBelow)
            if immediateNoTradeThroughZone
                bb.wasInside := false
                continue

            bool mitigated = false
            if crossedAbove and bb.bias == BEARISH
                mitigated := true
                currentAlerts.bearishBreakerMitigated := true
            else if crossedBelow and bb.bias == BULLISH
                mitigated := true
                currentAlerts.bullishBreakerMitigated := true
            if mitigated
                breakers.remove(index)

// v15.3 — Breaker Blocks now have full touch counting parity with Order Blocks.
//         Mirrors updateOrderBlockTouches(): a touch is registered only on the
//         outside→inside transition, the creation bar is skipped, and the
//         "still alive" predicate uses the same mitigation sources as
//         deleteBreakerBlocks() so counting and removal stay in sync.
updateBreakerBlockTouches(bool internal = false) =>
    array<orderBlock> breakers = internal ? internalBreakerBlocks : swingBreakerBlocks
    int sz = breakers.size()
    if sz > 0
        for index = sz - 1 to 0
            orderBlock bb = breakers.get(index)
            if bb.identifiedBarIndex >= bar_index
                continue
            bool overlaps = high >= bb.barLow and low <= bb.barHigh
            bool mitigated = bb.bias == BULLISH
                 ? bullishOrderBlockMitigationSource < bb.barLow and (bb.barLow - bullishOrderBlockMitigationSource) >= minPen
                 : bearishOrderBlockMitigationSource > bb.barHigh and (bearishOrderBlockMitigationSource - bb.barHigh) >= minPen
            bool nowInside = overlaps and not mitigated
            if nowInside and not bb.wasInside
                bb.touchCount += 1
            bb.wasInside := nowInside
            if bb.touchCount >= maxOBTouchesInput
                breakers.remove(index)

//──────────────────────────────────────────────────────────────────────────────
// OB cluster search
//──────────────────────────────────────────────────────────────────────────────
storeOrderBlock(pivot brokenPivot, pivot originPivot, bool internal = false, int bias) =>
    bool shouldTrack = (not internal and needSwingOBTracking) or (internal and needInternalOBTracking)
    if shouldTrack
        int originIdx = toArrayIndex(originPivot.barIndex)
        int brokenIdx = toArrayIndex(brokenPivot.barIndex)
        if not na(originIdx) and not na(brokenIdx)
            int searchStart = math.min(originIdx, brokenIdx)
            int searchEnd   = math.max(originIdx, brokenIdx)
            searchStart := math.max(searchStart, 0)
            searchEnd   := math.min(searchEnd, closes.size() - 1)
            // v19.1 — Bumped swing multiplier from 3 to 5 (cap 60 → 100 bars
            //         at default Swing Length 20). Internal cap unchanged.
            //         Avoids landing on the wrong origin candle when the
            //         actual OB is older than the previous 60-bar window.
            // v19.9 — Swing-side multiplier now driven by the user input.
            //         Internal kept at fixed 3× to limit per-bar cost.
            int obSearchCap = internal ? math.max(15, internalLengthInput * 3) : math.max(15, swingsLengthInput * obSearchCapMultiplierInput)
            // v20.6 — Two-stage scan with automatic fallback. Snapshot the
            //         natural window BEFORE applying the cap so we can scan
            //         the unscanned half as a fallback if the primary half
            //         finds no opposite-color candle. Eliminates the blind
            //         spot that v20.4 introduced (whichever half the user's
            //         OB Search Anchor dropped was silently un-searchable).
            //         Cost: the secondary scan only runs when primary
            //         returned na AND the natural window exceeded the cap,
            //         which is rare. In the common case (window ≤ cap, OR
            //         primary finds something) the secondary path is dead.
            int _natStart = searchStart
            int _natEnd   = searchEnd
            // Apply primary cap.
            if obSearchAnchorInput == 'Break'
                searchStart := math.max(searchStart, searchEnd - obSearchCap)
            else
                searchEnd   := math.min(searchEnd, searchStart + obSearchCap)
            bool _windowWasCapped = searchStart > _natStart or searchEnd < _natEnd
            int _closesSize  = closes.size()
            int _highsSize   = highs.size()
            // v19.7 — _parsedHSize / _parsedLSize collapsed into _highsSize
            //         after parsedHighs / parsedLows were removed.
            // v20.4 — Removed _opensSize (never referenced after computation).
            // v19.6 — `lastFound` overwrites on every opposite-color hit, so
            //         the loop returns the LATEST opposite-color candle in
            //         the scanned range. Primary scan covers the half
            //         dictated by OB Search Anchor.
            // v20.4 — Removed inner `if i >= 0 and i < _closesSize` guard;
            //         search bounds are already clamped above.
            int parsedIndex  = na
            if bias == BULLISH
                int lastFound = na
                for i = searchStart to searchEnd
                    if closes.get(i) < opens.get(i)
                        lastFound := i
                parsedIndex := lastFound
            else
                int lastFound = na
                for i = searchStart to searchEnd
                    if closes.get(i) > opens.get(i)
                        lastFound := i
                parsedIndex := lastFound
            // v20.6 — Secondary scan: if primary found nothing AND the natural
            //         window had bars outside the cap, scan the OTHER half
            //         before falling through to the extreme high/low fallback.
            //         This means BOTH halves of the natural window are
            //         eventually searched — the anchor only controls which
            //         half gets PREFERENCE (its "latest opposite-color" wins
            //         over the other half's). Worst-case: secondary half's
            //         OB is found instead of nothing.
            if na(parsedIndex) and _windowWasCapped
                int _secStart = obSearchAnchorInput == 'Break' ? _natStart : (searchEnd + 1)
                int _secEnd   = obSearchAnchorInput == 'Break' ? (searchStart - 1) : _natEnd
                _secStart := math.max(_secStart, 0)
                _secEnd   := math.min(_secEnd, _closesSize - 1)
                if _secStart <= _secEnd
                    if bias == BULLISH
                        int lastFound2 = na
                        for i = _secStart to _secEnd
                            if closes.get(i) < opens.get(i)
                                lastFound2 := i
                        parsedIndex := lastFound2
                    else
                        int lastFound2 = na
                        for i = _secStart to _secEnd
                            if closes.get(i) > opens.get(i)
                                lastFound2 := i
                        parsedIndex := lastFound2
            if na(parsedIndex) and _natEnd >= _natStart
                // v19.7 — Use highs/lows directly (parsedHighs/parsedLows
                //         removed; they held identical values after v19.6).
                // v20.6 — Extreme-bar fallback now scans the FULL natural
                //         window, not just the capped primary half. If
                //         both the primary AND secondary cluster scans
                //         couldn't find an opposite-color candle anywhere
                //         in the natural window, the extreme high/low
                //         should at least be looked for over the same
                //         full range — otherwise we'd silently miss the
                //         actual swing extreme on long-impulse setups.
                int safeEnd   = math.min(_natEnd + 1, _highsSize)
                int safeStart = math.max(_natStart, 0)
                if safeEnd > safeStart
                    if bias == BEARISH
                        array<float> a_rray = highs.slice(safeStart, safeEnd)
                        parsedIndex := safeStart + a_rray.indexof(a_rray.max())
                    else
                        array<float> a_rray = lows.slice(safeStart, safeEnd)
                        parsedIndex := safeStart + a_rray.indexof(a_rray.min())
            if not na(parsedIndex) and parsedIndex >= 0 and parsedIndex < _highsSize
                float obTop    = na
                float obBottom = na
                if orderBlockRangeInput == BODY_ONLY
                    obTop    := math.max(opens.get(parsedIndex), closes.get(parsedIndex))
                    obBottom := math.min(opens.get(parsedIndex), closes.get(parsedIndex))
                else
                    obTop    := highs.get(parsedIndex)
                    obBottom := lows.get(parsedIndex)

                // v15.3 — Back-fill the touch counter across the historical
                //         window between the OB candle (parsedIndex) and the
                //         detection bar. Previously the touch counter only
                //         started from the detection bar, so the very first
                //         user-visible "1x" could correspond to the Nth real
                //         retest instead of the 1st. The replay logic mirrors
                //         updateOrderBlockTouches() exactly: outside→inside
                //         transitions only, mitigation source aware.
                int hTouches      = 0
                bool prevInside   = true   // OB candle is inside by definition
                int  loopFrom     = parsedIndex + 1
                int  loopTo       = _closesSize - 2  // exclude detection bar
                bool stillValid   = true
                if loopTo >= loopFrom
                    for i = loopFrom to loopTo
                        if i >= 0 and i < _highsSize
                            float h_i = highs.get(i)
                            float l_i = lows.get(i)
                            float c_i = closes.get(i)
                            float o_i = opens.get(i)
                            bool overlaps_i = h_i >= obBottom and l_i <= obTop
                            // v15.4 — alive check mirrors all three mitigation modes
                            float bearSrc_i = orderBlockMitigationInput == CLOSE_SRC ? c_i
                                 : orderBlockMitigationInput == BODY_SRC ? math.max(o_i, c_i)
                                 : h_i
                            float bullSrc_i = orderBlockMitigationInput == CLOSE_SRC ? c_i
                                 : orderBlockMitigationInput == BODY_SRC ? math.min(o_i, c_i)
                                 : l_i
                            float minPen_i = i < minPens.size() ? minPens.get(i) : minPen
                            bool mitigated_i = bias == BULLISH
                                 ? bullSrc_i < obBottom and (obBottom - bullSrc_i) >= minPen_i
                                 : bearSrc_i > obTop and (bearSrc_i - obTop) >= minPen_i
                            bool alive_i = not mitigated_i
                            // If the historical bar would have already
                            // mitigated the OB, drop it entirely.
                            if not alive_i
                                stillValid := false
                                break
                            bool inside_i = overlaps_i
                            if inside_i and not prevInside
                                hTouches += 1
                            prevInside := inside_i

                // Skip storing if the OB was already exhausted historically.
                if stillValid and hTouches < maxOBTouchesInput
                    // v18.0 — RVOL stamping. Look up the origin bar's volume
                    //         and the trailing SMA(volume, rvolPeriodInput)
                    //         centred on parsedIndex. Volumes array gated on
                    //         rvolEnableInput (see needHistoryArrays).
                    // v20.9 — RVOL audit #1: sample OB volume over the IMPULSE
                    //         window, not the OB candle alone. The OB origin
                    //         (parsedIndex) is by construction the quiet
                    //         pullback candle BEFORE the break; the
                    //         institutional volume lives in the displacement
                    //         that follows it. Pre-v20.9 used
                    //         volumes.get(parsedIndex) — the low-volume side
                    //         of the move — so OBs rarely qualified as
                    //         institutional while FVGs (sampled on the push
                    //         bar) frequently did, despite the SAME 1.5×
                    //         threshold. Now take the MAX volume across
                    //         [parsedIndex … break bar], which captures the
                    //         displacement and matches the FVG semantic. The
                    //         baseline (denominator) stays the trailing
                    //         pre-OB average so the ratio is "impulse peak vs
                    //         quiet baseline".
                    //         NOTE: opt-in (rvolEnableInput off by default).
                    //         Expect more OBs to flag institutional than in
                    //         pre-v20.9 — that's the corrected, OB/FVG-
                    //         consistent behavior; re-tune rvolOBThresholdInput
                    //         if desired.
                    float obOriginVol = na
                    float obAvgVol    = na
                    if rvolEnableInput and parsedIndex >= 0 and parsedIndex < volumes.size()
                        // Numerator: peak volume over the impulse window.
                        int impEnd = volumes.size() - 1
                        int impStart = math.max(0, parsedIndex)
                        if impEnd >= impStart
                            array<float> impSlice = volumes.slice(impStart, impEnd + 1)
                            obOriginVol := impSlice.max()
                        // Denominator: trailing average of the bars BEFORE the
                        // OB candle (true RVOL baseline, origin bar excluded).
                        int volEnd   = math.max(0, parsedIndex)               // exclusive of parsedIndex
                        int volStart = math.max(0, parsedIndex - rvolPeriodInput)
                        if volEnd > volStart
                            array<float> volSlice = volumes.slice(volStart, volEnd)
                            obAvgVol := volSlice.avg()
                    float obRVOL = (rvolEnableInput and rvolVolumeAvailable and not na(obAvgVol) and obAvgVol > 0) ? obOriginVol / obAvgVol : na
                    // v20.12 — Threshold by scale: internal vs swing OB.
                    float obRvolThreshold = internal ? rvolOBThresholdInput : rvolOBThresholdSwingInput
                    bool  obIsInst = rvolEnableInput and not na(obRVOL) and obRVOL >= obRvolThreshold
                    // v20.0 — Session-aware tagging. Classify the OB candle's
                    //         hour-of-day in NY time into ICT sessions.
                    int    _obHourNY = hour(times.get(parsedIndex), 'America/New_York')
                    string _obSession = (_obHourNY >= 20) ? 'Asian'
                                      : (_obHourNY < 3)   ? 'Asian'
                                      : (_obHourNY < 8)   ? 'London'
                                      : (_obHourNY < 17)  ? 'NY'
                                      : 'Off'
                    // v20.0 — Confluence scoring at formation. Three points
                    //         max: institutional RVOL, FVG overlap with the
                    //         OB price range, and Premium/Discount zone
                    //         membership of the OB midpoint.
                    bool _confInst = obIsInst
                    // v20.5 — FVG confluence now uses HISTORICAL price arrays
                    //         (highs/lows) around parsedIndex instead of the
                    //         live fairValueGaps array. Pre-v20.5 the check
                    //         iterated the active FVG list, which by the time
                    //         the OB was identified had been depleted by any
                    //         mitigations that occurred in the bars between
                    //         OB birth (parsedIndex) and BOS detection bar.
                    //         An OB that was born with FVG support but whose
                    //         FVG got filled during the impulse was being
                    //         denied its confluence point. ICT convention:
                    //         OB strength is determined at BIRTH — whether
                    //         the gap fills later is downstream behavior,
                    //         not retro-active grading.
                    //         New approach: detect a 3-bar FVG pattern in
                    //         the impulse-start window (parsedIndex,
                    //         parsedIndex+1, parsedIndex+2) — i.e., does the
                    //         OB candle or one of the first impulse bars
                    //         have a wick-gap to the candle two bars after?
                    //         A 3-bar FVG = high[bar1] < low[bar3] (bullish
                    //         gap up) OR low[bar1] > high[bar3] (bearish
                    //         gap down). Scan +0/+1/+2 offsets to catch
                    //         FVGs that formed at the OB itself or 1-2 bars
                    //         into the impulse.
                    // v20.15 — Require DIRECTIONAL alignment between the gap
                    //          and the OB bias (audit #2). A bullish OB's
                    //          impulse should leave a bullish (gap-up) FVG;
                    //          a bearish OB's a bearish (gap-down) FVG.
                    //          Pre-v20.15 any 3-bar gap in either direction
                    //          scored the point, so a bullish OB could earn
                    //          FVG confluence from an unrelated bearish gap.
                    bool _confFvg  = false
                    for _kOff = 0 to 2
                        int _b1Idx = parsedIndex + _kOff
                        int _b3Idx = _b1Idx + 2
                        if _b1Idx >= 0 and _b3Idx < _highsSize
                            float _b1Hi = highs.get(_b1Idx)
                            float _b1Lo = lows.get(_b1Idx)
                            float _b3Hi = highs.get(_b3Idx)
                            float _b3Lo = lows.get(_b3Idx)
                            bool _bullGap = _b1Hi < _b3Lo   // gap up
                            bool _bearGap = _b1Lo > _b3Hi   // gap down
                            if (bias == BULLISH and _bullGap) or (bias == BEARISH and _bearGap)
                                _confFvg := true
                                break
                    // v20.1 — Bias-aware P/D confluence. Pre-v20.1 the check
                    //         awarded +1 if the OB midpoint was in EITHER the
                    //         premium OR discount zone, ignoring OB direction.
                    //         That inflated the score on directionally-wrong
                    //         setups: a bearish OB in discount (selling cheap)
                    //         and a bullish OB in premium (buying expensive)
                    //         both got the point. ICT methodology only counts
                    //         a bullish OB in discount and a bearish OB in
                    //         premium as high-conviction.
                    bool _confPD = false
                    if not na(trailing.top) and not na(trailing.bottom)
                        float _trRange = trailing.top - trailing.bottom
                        if _trRange > 0
                            float _obMid = (obTop + obBottom) / 2
                            float _premiumFloor = trailing.top    - _trRange * 0.3
                            float _discountCeil = trailing.bottom + _trRange * 0.3
                            _confPD := (bias == BULLISH and _obMid <= _discountCeil) or (bias == BEARISH and _obMid >= _premiumFloor)
                    int _obConfScore = (_confInst ? 1 : 0) + (_confFvg ? 1 : 0) + (_confPD ? 1 : 0)
                    // v20.13 — Build the human-readable confluence breakdown
                    //          (R = institutional RVOL, F = FVG overlap,
                    //          P = Premium/Discount zone).
                    string _obConfTag = (_confInst ? 'R' : '') + (_confFvg ? 'F' : '') + (_confPD ? 'P' : '')
                    orderBlock o_rderBlock = orderBlock.new(obTop, obBottom, times.get(parsedIndex), bias, hTouches, bar_index, prevInside, obRVOL, obIsInst, _obSession, _obConfScore, _obConfTag)
                    if _obConfScore >= obConfluenceMinScoreInput
                        currentAlerts.highConfluenceOBFormed := true
                    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
                    int _orderBlocksSize = orderBlocks.size()
                    if _orderBlocksSize >= MAX_ORDER_BLOCK_COUNT
                        orderBlocks.pop()
                    orderBlocks.unshift(o_rderBlock)
                    // v16.8 — Fire OB-formation alert flag.
                    if bias == BULLISH
                        if internal
                            currentAlerts.internalBullishOBFormed := true
                        else
                            currentAlerts.swingBullishOBFormed := true
                    else
                        if internal
                            currentAlerts.internalBearishOBFormed := true
                        else
                            currentAlerts.swingBearishOBFormed := true

//──────────────────────────────────────────────────────────────────────────────
// Order Block Drawing
//──────────────────────────────────────────────────────────────────────────────
drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    int orderBlocksSize           = orderBlocks.size()
    int maxOBs                    = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
    array<box> b_oxes             = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
    int totalBoxes                = b_oxes.size()
    int usedCount                 = math.min(maxOBs, orderBlocksSize)
    array<line> ceLines           = internal ? internalOBCELines : swingOBCELines
    int totalCELines              = ceLines.size()
    if usedCount > 0
        for index = 0 to usedCount - 1
            if index < totalBoxes and index < orderBlocks.size()
                orderBlock eachOB = orderBlocks.get(index)
                // v20.0 — Session filter. When set to a specific session,
                //         hide OBs that didn't form during it. Implemented
                //         by force-transparent colors; box geometry still
                //         updates so the underlying data stays consistent.
                bool _sessionMatch = obSessionFilterInput == 'All' or
                     (obSessionFilterInput == 'Asian'       and eachOB.sessionOrigin == 'Asian') or
                     (obSessionFilterInput == 'London'      and eachOB.sessionOrigin == 'London') or
                     (obSessionFilterInput == 'NY'          and eachOB.sessionOrigin == 'NY') or
                     (obSessionFilterInput == 'Off-Session' and eachOB.sessionOrigin == 'Off')
                obColor = styleInput == MONOCHROME
                     ? (eachOB.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80))
                     : internal
                         ? (eachOB.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor)
                         : (eachOB.bias == BEARISH ? swingBearishOrderBlockColor    : swingBullishOrderBlockColor)
                box b_ox = b_oxes.get(index)
                // v18.0 — RVOL render: dim non-institutional, optionally hide.
                color rvolBg = obColor
                color rvolBd = obColor
                // v20.11 — RVOL #3 completion: gate dimming/hide on
                //          rvolVolumeAvailable. On volumeless feeds RVOL is na
                //          → isInstitutional false for everything → without
                //          this guard every OB would dim/disappear under
                //          Hide-Low-Vol. Guard makes the block render normally.
                if rvolEnableInput and rvolVolumeAvailable and not eachOB.isInstitutional
                    rvolBg := rvolHideRetailOBInput ? color.new(obColor, 100) : color.new(obColor, 95)
                    rvolBd := rvolHideRetailOBInput ? color.new(obColor, 100) : color.new(obColor, 95)
                // v20.0 — Session-filter override: if this OB isn't in the
                //         chosen session, make it fully transparent.
                if not _sessionMatch
                    rvolBg := color.new(obColor, 100)
                    rvolBd := color.new(obColor, 100)
                b_ox.set_top_left_point(    chart.point.new(eachOB.barTime, na, eachOB.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time,  na, eachOB.barLow))
                b_ox.set_border_color(rvolBd)
                b_ox.set_bgcolor(rvolBg)
                // v20.0 — Build composite OB label: touch count + optional
                //         ★N confluence badge + optional session tag.
                string _touchPart   = (showOBTouchCountInput and eachOB.touchCount > 0) ? str.tostring(eachOB.touchCount) + 'x' : ''
                // v20.13 — Confluence badge now spells out WHICH confluences
                //          scored (e.g. "★2 RF") instead of a bare star+count.
                //          R = institutional RVOL, F = FVG overlap,
                //          P = Premium/Discount zone. Score number kept for
                //          a quick magnitude read.
                string _confPart    = (showOBConfluenceScoreInput and eachOB.confluenceScore > 0) ? ' ★' + str.tostring(eachOB.confluenceScore) + (eachOB.confluenceTag != '' ? ' ' + eachOB.confluenceTag : '') : ''
                string _sessionPart = (showOBSessionTagInput and eachOB.sessionOrigin != '' and eachOB.sessionOrigin != 'Off')
                     ? (' ' + (eachOB.sessionOrigin == 'Asian'  ? 'A'
                             : eachOB.sessionOrigin == 'London' ? 'L'
                             : eachOB.sessionOrigin == 'NY'     ? 'NY'
                             : eachOB.sessionOrigin))
                     : ''
                string _obText = _touchPart + _confPart + _sessionPart
                if _obText != ''
                    b_ox.set_text(_obText)
                    b_ox.set_text_size(size.tiny)
                    b_ox.set_text_color(eachOB.bias == BULLISH
                         ? color.new(#1848cc, 0)
                         : color.new(#b22833, 0))
                    b_ox.set_text_halign(text.align_right)
                    b_ox.set_text_valign(text.align_top)
                else
                    b_ox.set_text('')
                if showCEMidlinesInput and index < totalCELines
                    float ceLevel = (eachOB.barHigh + eachOB.barLow) / 2
                    line ceLine = ceLines.get(index)
                    ceLine.set_first_point(    chart.point.new(eachOB.barTime, na, ceLevel))
                    ceLine.set_second_point(   chart.point.new(last_bar_time,  na, ceLevel))
                    ceLine.set_color(obColor)
    if usedCount < totalBoxes
        for i = usedCount to totalBoxes - 1
            box b_ox = b_oxes.get(i)
            b_ox.set_top_left_point(    chart.point.new(time, na, close))
            b_ox.set_bottom_right_point(chart.point.new(time, na, close))
            b_ox.set_bgcolor(color.new(color.white, 100))
            b_ox.set_border_color(color.new(color.white, 100))
            b_ox.set_text('')
    if showCEMidlinesInput
        int ceUsed = math.min(usedCount, totalCELines)
        if ceUsed < totalCELines
            for i = ceUsed to totalCELines - 1
                line ceLine = ceLines.get(i)
                ceLine.set_first_point(    chart.point.new(time, na, close))
                ceLine.set_second_point(   chart.point.new(time, na, close))
                ceLine.set_color(color.new(color.white, 100))

//──────────────────────────────────────────────────────────────────────────────
// Breaker Block Drawing
//──────────────────────────────────────────────────────────────────────────────
drawBreakerBlocks(bool internal = false) =>
    array<orderBlock> breakers = internal ? internalBreakerBlocks : swingBreakerBlocks
    int breakersSize           = breakers.size()
    int maxBBs                 = internal ? internalBreakerBlocksSizeInput : swingBreakerBlocksSizeInput
    array<box> b_oxes          = internal ? internalBreakerBoxes : swingBreakerBoxes
    int totalBoxes             = b_oxes.size()
    int usedCount              = math.min(maxBBs, breakersSize)
    array<line> ceLines        = internal ? internalBBCELines : swingBBCELines
    int totalCELines           = ceLines.size()
    if usedCount > 0
        for index = 0 to usedCount - 1
            if index < totalBoxes and index < breakers.size()
                orderBlock eachBB = breakers.get(index)
                bbColor = styleInput == MONOCHROME
                     ? (eachBB.bias == BEARISH ? color.new(MONO_BEARISH,70) : color.new(MONO_BULLISH,70))
                     : internal
                         ? (eachBB.bias == BEARISH ? internalBearishBreakerColor : internalBullishBreakerColor)
                         : (eachBB.bias == BEARISH ? swingBearishBreakerColor    : swingBullishBreakerColor)
                box b_ox = b_oxes.get(index)
                // v18.0 — RVOL render: dim non-institutional, optionally hide.
                color rvolBbBg = bbColor
                color rvolBbBd = bbColor
                // v20.11 — RVOL #3 completion (see OB render comment).
                if rvolEnableInput and rvolVolumeAvailable and not eachBB.isInstitutional
                    rvolBbBg := rvolHideRetailOBInput ? color.new(bbColor, 100) : color.new(bbColor, 95)
                    rvolBbBd := rvolHideRetailOBInput ? color.new(bbColor, 100) : color.new(bbColor, 95)
                b_ox.set_top_left_point(    chart.point.new(eachBB.barTime, na, eachBB.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time,  na, eachBB.barLow))
                b_ox.set_border_color(rvolBbBd)
                b_ox.set_bgcolor(rvolBbBg)
                // v15.4 — BB touch count now has its own toggle.
                if showBBTouchCountInput and eachBB.touchCount > 0
                    string bbTouchText = str.tostring(eachBB.touchCount) + 'x'
                    b_ox.set_text(bbTouchText)
                    b_ox.set_text_size(size.tiny)
                    b_ox.set_text_halign(text.align_right)
                    b_ox.set_text_valign(text.align_top)
                    b_ox.set_text_color(eachBB.bias == BULLISH
                         ? color.new(#00838f, 0)
                         : color.new(#e65100, 0))
                else
                    b_ox.set_text('')
                if showCEMidlinesInput and index < totalCELines
                    float ceLevel = (eachBB.barHigh + eachBB.barLow) / 2
                    line ceLine = ceLines.get(index)
                    ceLine.set_first_point(    chart.point.new(eachBB.barTime, na, ceLevel))
                    ceLine.set_second_point(   chart.point.new(last_bar_time,  na, ceLevel))
                    ceLine.set_color(bbColor)
    if usedCount < totalBoxes
        for i = usedCount to totalBoxes - 1
            box b_ox = b_oxes.get(i)
            b_ox.set_top_left_point(    chart.point.new(time, na, close))
            b_ox.set_bottom_right_point(chart.point.new(time, na, close))
            b_ox.set_bgcolor(color.new(color.white, 100))
            b_ox.set_border_color(color.new(color.white, 100))
            b_ox.set_text('')
    if showCEMidlinesInput
        int ceUsed = math.min(usedCount, totalCELines)
        if ceUsed < totalCELines
            for i = ceUsed to totalCELines - 1
                line ceLine = ceLines.get(i)
                ceLine.set_first_point(    chart.point.new(time, na, close))
                ceLine.set_second_point(   chart.point.new(time, na, close))
                ceLine.set_color(color.new(color.white, 100))

//──────────────────────────────────────────────────────────────────────────────
// displayStructure (with MSS)
//──────────────────────────────────────────────────────────────────────────────
displayStructure(bool internal = false) =>
    if barstate.isconfirmed
        bool bullishBar = true
        bool bearishBar = true
        if internalFilterConfluenceInput
            float upperWick = high - math.max(close, open)
            float lowerWick = math.min(close, open) - low
            // v19.1 — Inverted-flag fix. Convention: large lower wick =
            //         buying pressure = bullish-character bar; large upper
            //         wick = selling rejection = bearish-character bar.
            //         Previously these assignments were swapped, causing
            //         the confluence filter to gate breaks the wrong way.
            bullishBar := lowerWick >= upperWick
            bearishBar := upperWick >= lowerWick

        pivot snapHigh = internal ? snapInternalHigh : snapSwingHigh
        pivot snapLow  = internal ? snapInternalLow  : snapSwingLow
        pivot realHigh = internal ? internalHigh : swingHigh
        pivot realLow  = internal ? internalLow  : swingLow
        trend t_rend   = internal ? internalTrend : swingTrend

        string baseLineStyle = internal ? line.style_dashed : line.style_solid
        labelSize = internal ? internalStructureSize : swingStructureSize
        bool bullCross = internal ? crossOverInternalHigh  : crossOverSwingHigh
        bool bearCross = internal ? crossUnderInternalLow  : crossUnderSwingLow

        // v19.2 — Warm-up silence fix. Original ternary subtracted
        //         snapSwingHigh.currentLevel from snapHigh.currentLevel
        //         unconditionally; before the first swing pivot forms,
        //         snapSwingHigh.currentLevel is na, the subtraction is na,
        //         math.abs(na) is na, and `na > mintick/2` evaluates to
        //         false in Pine v6. Net effect: every internal break in the
        //         indicator's warm-up window was silenced (only mattered
        //         when internalFilterConfluenceInput = ON, which is OFF by
        //         default, but the bug was real when enabled).
        //         Fix: when the swing snap level isn't formed yet, fall back
        //         to the bullishBar/bearishBar confluence alone (the
        //         level-distinctness check can't be evaluated without a
        //         swing reference, so skip it rather than failing closed).
        bool swingHighSnapReady = not na(snapSwingHigh.currentLevel)
        bool swingLowSnapReady  = not na(snapSwingLow.currentLevel)
        extraConditionBull = internal ? (swingHighSnapReady ? math.abs(snapHigh.currentLevel - snapSwingHigh.currentLevel) > syminfo.mintick / 2 and bullishBar : bullishBar) : true
        bullishColor       = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
        extraConditionBear = internal ? (swingLowSnapReady  ? math.abs(snapLow.currentLevel  - snapSwingLow.currentLevel)  > syminfo.mintick / 2 and bearishBar : bearishBar) : true
        bearishColor       = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

        bool validBullCross = bullCross and not snapHigh.crossed and extraConditionBull
        bool validBearCross = bearCross and not snapLow.crossed  and extraConditionBear

        // v20.7 — Outside-bar tie-break (BS-1 fix). When a single bar closes
        //         through BOTH the prior swing high and swing low (engulfing /
        //         displacement / stop-run-and-reverse — the highest-info
        //         candles on the chart), pre-v20.7 silenced BOTH signals,
        //         producing NO structure event on exactly the most tradeable
        //         bars. Now resolve by CLOSE LOCATION within the bar's range:
        //           close in upper third  → bullish break wins (closed strong)
        //           close in lower third  → bearish break wins (closed weak)
        //           close in middle third → genuinely indeterminate, silence
        //                                    both (legacy behavior preserved
        //                                    only for the ambiguous case)
        //         Rationale: a bar that swept the lows and closed near its
        //         high is a bullish stop-run; the close tells you which side
        //         actually won the bar.
        if validBullCross and validBearCross
            float _tieRange = high - low
            if _tieRange > 0
                float _closePos = (close - low) / _tieRange
                if _closePos >= 0.6667
                    validBearCross := false       // bull wins
                else if _closePos <= 0.3333
                    validBullCross := false       // bear wins
                else
                    validBullCross := false       // indeterminate → silence both
                    validBearCross := false
            else
                validBullCross := false
                validBearCross := false

        bool needOBStore = internal ? needInternalOBTracking : needSwingOBTracking

        if validBullCross
            string tag = t_rend.bias == BEARISH ? CHOCH : BOS
            bool isChoch = tag == CHOCH

            bool applyMSS = internal ? mssApplyInternalInput : mssApplySwingInput
            int bullDispOffset = int(na)
            if isChoch and showMSSInput and applyMSS
                bullDispOffset := displacementOffset(true)
                if not na(bullDispOffset)
                    tag := MSS

            // v20.0 — Structure-quality score. Displacement (close past the
            //         broken level, in ATRs) × body/range ratio.
            // v20.1 — Honest note on MSS bypass: MSS bars auto-pass the
            //         structureMinQualityInput filter because MSS already
            //         has its own strength filter chain (mssATRMultInput +
            //         mssBodyRatioInput). Those two filter chains are
            //         configured INDEPENDENTLY — if a user sets
            //         mssBodyRatioInput = 0.3 while structureMinQualityInput
            //         = 'Strong Only', an MSS bar with body/range = 0.4
            //         (Medium by the structure-quality classifier) still
            //         passes via the MSS path. This is by design (MSS is
            //         a more specific signal — its own thresholds win), but
            //         users who want a single unified strength cap should
            //         align mssATRMultInput / mssBodyRatioInput with the
            //         Strong thresholds here (1.0 ATR / 0.6 body ratio).
            float _bullRange      = math.max(high - low, syminfo.mintick)
            float _bullBodyRatio  = math.abs(close - open) / _bullRange
            // v20.4 — Warm-up na guard. During the first 14 bars of chart
            //         history both ta.atr(200) and ta.atr(14) return na, so
            //         atrMeasure = na and math.max(na, mintick) = na in Pine
            //         v6, propagating na through _bullDisp and forcing every
            //         early-bar break to classify as 'Weak' regardless of
            //         actual displacement. Inner nz() falls back to mintick
            //         so the displacement ratio is finite during warm-up.
            float _bullDisp       = (not na(snapHigh.currentLevel)) ? math.abs(close - snapHigh.currentLevel) / math.max(nz(dispQualityATR, syminfo.mintick), syminfo.mintick) : 0.0
            string _bullQuality   = (_bullDisp >= 1.0 and _bullBodyRatio >= 0.6) ? 'Strong'
                                  : (_bullDisp >= 0.3 or  _bullBodyRatio >= 0.4) ? 'Medium'
                                  :                                                'Weak'
            bool _bullPasses      = tag == MSS or
                 structureMinQualityInput == 'All' or
                 (structureMinQualityInput == 'Medium+'     and (_bullQuality == 'Strong' or _bullQuality == 'Medium')) or
                 (structureMinQualityInput == 'Strong Only' and  _bullQuality == 'Strong')

            // v20.1 — All BOS/CHoCH state mutations are now inside the
            //         _bullPasses gate. Pre-v20.1 the alert assignments were
            //         gated but realHigh.crossed, t_rend.bias, and the
            //         trail-reset block ran unconditionally, so a "Weak BOS"
            //         filtered out of alerts/labels would still:
            //           - flip swingTrend.bias (corrupting future CHoCH detection),
            //           - mark the snap pivot as crossed (preventing a re-fire if
            //             a clean break occurred later on the same pivot), and
            //           - reset trailing extremes (silently reshaping OTE / P/D).
            //         Net effect: filter "felt" like fewer signals but produced
            //         wrong downstream signals on the trades that did fire.
            //         If you want filter-as-display-only semantics, set
            //         structureMinQualityInput = 'All' and use the badge toggle
            //         to visually mark weak structure without suppressing it.
            if _bullPasses
                if internal
                    currentAlerts.internalBullishCHoCH := tag == CHOCH
                    currentAlerts.internalBullishBOS   := tag == BOS
                    if tag == MSS
                        currentAlerts.internalBullishMSS       := true
                        currentAlerts.internalBullishMSSOffset := bullDispOffset
                else
                    currentAlerts.swingBullishCHoCH    := tag == CHOCH
                    currentAlerts.swingBullishBOS      := tag == BOS
                    if tag == MSS
                        currentAlerts.swingBullishMSS       := true
                        currentAlerts.swingBullishMSSOffset := bullDispOffset

                // v15.3 — Use mintick tolerance instead of float ==.
                if not na(snapHigh.currentLevel) and not na(realHigh.currentLevel) and math.abs(snapHigh.currentLevel - realHigh.currentLevel) <= syminfo.mintick / 2
                    realHigh.crossed := true
                t_rend.bias := BULLISH

                // v17.0 — Trail-reset top now respects pivotSourceInput so a
                //         Wick-mode chart resets to the actual high, not the body.
                if not internal and useTrailResetInput
                    float resetTop = pivotSourceInput == 'Wick' ? high : math.max(open, close)
                    trailing.bottom         := nz(snapSwingLow.currentLevel, math.min(open, close))
                    trailing.lastBottomTime := nz(snapSwingLow.barTime, time)
                    trailing.barIndex       := nz(snapSwingLow.barIndex, bar_index)
                    trailing.top            := resetTop
                    trailing.lastTopTime    := time

                // v20.8/v20.10 — Capture the bullish impulse leg for Impulse
                //         Leg OTE mode (swing only, independent of the
                //         useTrailResetInput toggle). Origin = swing-low wick
                //         (fixed); top = provisional breakout-bar high that
                //         then TRACKS the running high until first retrace
                //         (oteLegFrozen, set in the per-bar update block).
                if not internal
                    oteLegState.bottom     := nz(snapSwingLow.actualLevel, nz(snapSwingLow.currentLevel, low))
                    oteLegState.top        := high
                    oteLegState.anchorTime := nz(snapSwingLow.barTime, time)
                    oteLegState.voided     := false
                    oteLegState.frozen     := false
                    oteLegState.captureBar := bar_index

            bool isChochOrMSS = tag == CHOCH or tag == MSS
            displayCondition = internal
                 ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and not isChochOrMSS) or (showInternalBullInput == CHOCH and isChochOrMSS))
                 : showStructureInput and (showSwingBullInput    == ALL or (showSwingBullInput    == BOS and not isChochOrMSS) or (showSwingBullInput    == CHOCH and isChochOrMSS))

            // v20.0 — Quality filter also gates the structure label draw and
            //         OB storage, so weak BOS bars don't pollute the chart
            //         OR the OB stream when the filter is set higher than All.
            displayCondition := displayCondition and _bullPasses

            color structColor = tag == MSS
                 ? (styleInput == MONOCHROME ? MONO_BULLISH : mssBullColorInput)
                 : bullishColor
            string lineStyle = tag == MSS ? line.style_solid : baseLineStyle

            // v20.0 — Optional quality badge appended to the structure tag.
            string _bullTag = (showStructureQualityBadgeInput and tag != MSS)
                 ? tag + ' (' + (_bullQuality == 'Strong' ? 'S' : _bullQuality == 'Medium' ? 'M' : 'W') + ')'
                 : tag
            if displayCondition
                drawStructure(snapHigh, _bullTag, structColor, lineStyle, label.style_label_down, labelSize)
            if needOBStore and _bullPasses
                storeOrderBlock(snapHigh, snapLow, internal, BULLISH)

        else if validBearCross
            string tag = t_rend.bias == BULLISH ? CHOCH : BOS
            bool isChoch = tag == CHOCH

            bool applyMSS = internal ? mssApplyInternalInput : mssApplySwingInput
            int bearDispOffset = int(na)
            if isChoch and showMSSInput and applyMSS
                bearDispOffset := displacementOffset(false)
                if not na(bearDispOffset)
                    tag := MSS

            // v20.0 — Structure-quality score (bearish mirror).
            float _bearRange      = math.max(high - low, syminfo.mintick)
            float _bearBodyRatio  = math.abs(close - open) / _bearRange
            // v20.4 — Warm-up na guard (see _bullDisp comment).
            float _bearDisp       = (not na(snapLow.currentLevel)) ? math.abs(close - snapLow.currentLevel) / math.max(nz(dispQualityATR, syminfo.mintick), syminfo.mintick) : 0.0
            string _bearQuality   = (_bearDisp >= 1.0 and _bearBodyRatio >= 0.6) ? 'Strong'
                                  : (_bearDisp >= 0.3 or  _bearBodyRatio >= 0.4) ? 'Medium'
                                  :                                                'Weak'
            bool _bearPasses      = tag == MSS or
                 structureMinQualityInput == 'All' or
                 (structureMinQualityInput == 'Medium+'     and (_bearQuality == 'Strong' or _bearQuality == 'Medium')) or
                 (structureMinQualityInput == 'Strong Only' and  _bearQuality == 'Strong')

            // v20.1 — State mutations now inside _bearPasses gate. See
            //         bullish branch comment for rationale (silent state
            //         corruption was the pre-v20.1 failure mode).
            if _bearPasses
                if internal
                    currentAlerts.internalBearishCHoCH := tag == CHOCH
                    currentAlerts.internalBearishBOS   := tag == BOS
                    if tag == MSS
                        currentAlerts.internalBearishMSS       := true
                        currentAlerts.internalBearishMSSOffset := bearDispOffset
                else
                    currentAlerts.swingBearishCHoCH    := tag == CHOCH
                    currentAlerts.swingBearishBOS      := tag == BOS
                    if tag == MSS
                        currentAlerts.swingBearishMSS       := true
                        currentAlerts.swingBearishMSSOffset := bearDispOffset

                // v15.3 — Use mintick tolerance instead of float ==.
                if not na(snapLow.currentLevel) and not na(realLow.currentLevel) and math.abs(snapLow.currentLevel - realLow.currentLevel) <= syminfo.mintick / 2
                    realLow.crossed := true
                t_rend.bias := BEARISH

                // v17.0 — Trail-reset bottom now respects pivotSourceInput.
                if not internal and useTrailResetInput
                    float resetBot = pivotSourceInput == 'Wick' ? low : math.min(open, close)
                    trailing.top            := nz(snapSwingHigh.currentLevel, math.max(open, close))
                    trailing.lastTopTime    := nz(snapSwingHigh.barTime, time)
                    trailing.barIndex       := nz(snapSwingHigh.barIndex, bar_index)
                    trailing.bottom         := resetBot
                    trailing.lastBottomTime := time

                // v20.8/v20.10 — Capture the bearish impulse leg. Origin =
                //         swing-high wick (fixed); bottom = provisional
                //         breakout-bar low that then TRACKS the running low
                //         until first retrace (oteLegFrozen).
                if not internal
                    oteLegState.top        := nz(snapSwingHigh.actualLevel, nz(snapSwingHigh.currentLevel, high))
                    oteLegState.bottom     := low
                    oteLegState.anchorTime := nz(snapSwingHigh.barTime, time)
                    oteLegState.voided     := false
                    oteLegState.frozen     := false
                    oteLegState.captureBar := bar_index

            bool isChochOrMSS = tag == CHOCH or tag == MSS
            displayCondition = internal
                 ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and not isChochOrMSS) or (showInternalBearInput == CHOCH and isChochOrMSS))
                 : showStructureInput and (showSwingBearInput    == ALL or (showSwingBearInput    == BOS and not isChochOrMSS) or (showSwingBearInput    == CHOCH and isChochOrMSS))

            // v20.0 — Quality filter gates display + OB storage (bearish).
            displayCondition := displayCondition and _bearPasses

            color structColor = tag == MSS
                 ? (styleInput == MONOCHROME ? MONO_BEARISH : mssBearColorInput)
                 : bearishColor
            string lineStyle = tag == MSS ? line.style_solid : baseLineStyle

            string _bearTag = (showStructureQualityBadgeInput and tag != MSS)
                 ? tag + ' (' + (_bearQuality == 'Strong' ? 'S' : _bearQuality == 'Medium' ? 'M' : 'W') + ')'
                 : tag
            if displayCondition
                drawStructure(snapLow, _bearTag, structColor, lineStyle, label.style_label_up, labelSize)
            if needOBStore and _bearPasses
                storeOrderBlock(snapLow, snapHigh, internal, BEARISH)

//──────────────────────────────────────────────────────────────────────────────
// Fair Value Gaps
//─────────  ────────────────────────────────────────────────────────────────────
fairValueGapBox(int leftTime, int rightTime, float topPrice, float bottomPrice, color boxColor) =>
    box.new(chart.point.new(leftTime,na,topPrice),
         chart.point.new(rightTime + fairValueGapsExtendInput * htfBarDuration,na,bottomPrice),
         xloc=xloc.bar_time, border_color=boxColor, bgcolor=boxColor)

deleteFairValueGaps() =>
    int sz = fairValueGaps.size()
    if sz > 0
        for index = sz - 1 to 0
            fairValueGap eachFVG = fairValueGaps.get(index)
            bool mitigated = false

            // v16.4 — ROOT-CAUSE FIX for "bullish iFVG vanishes instantly".
            //
            //         The bug was NOT in deleteInvertedFVGs() — that logic is
            //         correct. The bug was the ASYMMETRIC FVG mitigation here:
            //
            //           Bullish FVG: required FULL FILL (min(o,c) < .bottom)
            //                        → bearish iFVG is born with full-gap buffer
            //                          between price and its resistance ceiling.
            //           Bearish FVG: only required FIRST ENTRY (close > .top)
            //                        → bullish iFVG is born with price sitting
            //                          ON its support floor → next minor pullback
            //                          invalidates it instantly.
            //
            //         Fix: make bearish FVG also require body past the FAR edge
            //         (.bottom = oldLow = upper edge of bearish gap = full fill).
            //         This makes both iFVGs born with proper buffer and produces
            //         the symmetric persistence the user expects.
            // v19.6 — minPen guard added for symmetry with OB/BB. A single-tick
            //         body close past the gap edge no longer triggers mitigation;
            //         price must penetrate by at least minPen (ATR-fraction +
            //         mintick floor). minPenetrationFactorInput defaults to 0.1
            //         so a fraction of ATR is required even with the ticks input
            //         at 0. For bearish FVG the "far edge" is .bottom = oldLow
            //         (the higher edge); penetration is body − bottom.
            if math.min(open, close) < eachFVG.bottom and (eachFVG.bottom - math.min(open, close)) >= minPen and eachFVG.bias == BULLISH
                mitigated := true
            else if math.max(open, close) > eachFVG.bottom and (math.max(open, close) - eachFVG.bottom) >= minPen and eachFVG.bias == BEARISH
                mitigated := true

            // v20.0 — Retail-trap signal: an FVG that was non-institutional
            //         at formation just got mitigated. Fire the combined
            //         low-RVOL alert (shared with OB mitigation below).
            // v20.9 — RVOL audit #2/#3: require a real low reading, not
            //         "unmeasured" (volumeless / warm-up → originRVOL na).
            if mitigated and lowRvolBreakAlertInput and rvolEnableInput and rvolVolumeAvailable and not na(eachFVG.originRVOL) and not eachFVG.isInstitutional
                currentAlerts.lowRvolBlockBroken := true

            if mitigated
                int   savedLeftTime  = eachFVG.topBox.get_left()
                int   savedRightTime = eachFVG.topBox.get_right()
                float savedTop       = eachFVG.top
                float savedBottom    = eachFVG.bottom
                int   savedBias      = eachFVG.bias
                // v18.0 — Inherit parent's RVOL on iFVG conversion.
                float savedRVOL      = eachFVG.originRVOL
                bool  savedIsInst    = eachFVG.isInstitutional

                eachFVG.topBox.delete()
                eachFVG.bottomBox.delete()
                fairValueGaps.remove(index)

                if showIFVGInput
                    int newBias = savedBias == BULLISH ? BEARISH : BULLISH
                    color ifvgColor = newBias == BULLISH
                         ? (styleInput == MONOCHROME ? color.new(MONO_BULLISH, 75) : ifvgBullColorInput)
                         : (styleInput == MONOCHROME ? color.new(MONO_BEARISH, 75) : ifvgBearColorInput)
                    // v18.4 — Apply RVOL dimming on iFVG using the inherited
                    //         parent stamp. Without this, a low-volume FVG
                    //         became a fully-opaque iFVG on conversion,
                    //         defeating the "Hide Low-Vol FVGs" filter.
                    // v20.11 — RVOL #3 completion (see OB render comment).
                    if rvolEnableInput and rvolVolumeAvailable and not savedIsInst
                        ifvgColor := rvolHideRetailFVGInput ? color.new(ifvgColor, 100) : color.new(ifvgColor, 95)

                    // v16.7 — For bearish-FVG-derived iFVGs, savedTop is the
                    //         LOWER edge and savedBottom is the HIGHER edge
                    //         (recentHigh < oldLow). Normalising with
                    //         math.max/min guarantees the two halves render
                    //         as adjacent rectangles in canonical top-down
                    //         order regardless of parent bias.
                    float boxHigh  = math.max(savedTop, savedBottom)
                    float boxLow   = math.min(savedTop, savedBottom)
                    float midPrice = math.avg(boxHigh, boxLow)

                    box newTopBox = box.new(
                         chart.point.new(savedLeftTime,  na, boxHigh),
                         chart.point.new(savedRightTime, na, midPrice),
                         xloc=xloc.bar_time,
                         bgcolor=ifvgColor,
                         border_color=ifvgColor,
                         border_style=line.style_dashed)

                    box newBottomBox = box.new(
                         chart.point.new(savedLeftTime,  na, midPrice),
                         chart.point.new(savedRightTime, na, boxLow),
                         xloc=xloc.bar_time,
                         bgcolor=ifvgColor,
                         border_color=ifvgColor,
                         border_style=line.style_dashed)

                    fairValueGap iFVG = fairValueGap.new(
                         savedTop,
                         savedBottom,
                         newBias,
                         newTopBox,
                         newBottomBox,
                         bar_index,
                         savedRVOL,
                         savedIsInst)

                    invertedFVGs.unshift(iFVG)
                    if newBias == BULLISH
                        currentAlerts.bullishIFVGFormed := true
                    else
                        currentAlerts.bearishIFVGFormed := true

                    while invertedFVGs.size() > ifvgMaxCountInput
                        fairValueGap old = invertedFVGs.pop()
                        old.topBox.delete()
                        old.bottomBox.delete()

deleteInvertedFVGs() =>
    int sz = invertedFVGs.size()
    if sz > 0
        for index = sz - 1 to 0
            fairValueGap eachIFVG = invertedFVGs.get(index)
            if eachIFVG.createdBarIndex >= bar_index
                continue
            bool mitigated = false

            // v16.3 — RESTORE v16.1 field references AND adopt the same
            //         configurable mitigation source the OB/BB system uses
            //         (orderBlockMitigationInput, BODY_SRC by default since v16.0).
            //
            //         FIELD SEMANTICS (verified from creation lines 1539–1554):
            //           Bearish FVG: top = LOWER, bottom = HIGHER  (recentHigh < oldLow)
            //           Bullish FVG: top = HIGHER, bottom = LOWER  (recentLow > oldHigh)
            //         iFVG inherits both fields verbatim, only bias flips. So:
            //           Bullish iFVG (from bearish FVG): .top is the LOWER edge (support)
            //           Bearish iFVG (from bullish FVG): .top is the HIGHER edge (resistance)
            //
            //         v16.2 incorrectly used .bottom for the bullish branch (the
            //         HIGHER edge for a bullish iFVG), causing instant deletion.
            //         v16.1 had the field references right but used a bare `close`
            //         comparison that didn't filter wick sweeps; bringing in the
            //         shared mitigation source matches v16.0 ICT-correctness.
            float ifvgBullSrc = ifvgMitigationInput == CLOSE_SRC ? close
                 : ifvgMitigationInput == BODY_SRC ? math.min(open, close)
                 : low
            float ifvgBearSrc = ifvgMitigationInput == CLOSE_SRC ? close
                 : ifvgMitigationInput == BODY_SRC ? math.max(open, close)
                 : high

            // v19.6 — minPen guard for symmetry with OB/BB. See FVG comment.
            //         iFVG's mitigation reference is .top — for a BULLISH iFVG
            //         derived from a bearish FVG, .top holds the LOWER edge
            //         (support); penetration is .top − src. For a BEARISH
            //         iFVG derived from a bullish FVG, .top is the HIGHER edge
            //         (resistance); penetration is src − .top.
            if eachIFVG.bias == BULLISH and ifvgBullSrc < eachIFVG.top and (eachIFVG.top - ifvgBullSrc) >= minPen
                mitigated := true
            else if eachIFVG.bias == BEARISH and ifvgBearSrc > eachIFVG.top and (ifvgBearSrc - eachIFVG.top) >= minPen
                mitigated := true

            if mitigated
                eachIFVG.topBox.delete()
                eachIFVG.bottomBox.delete()
                invertedFVGs.remove(index)

trimFairValueGaps() =>
    while fairValueGaps.size() > MAX_FVG_COUNT
        fairValueGap old = fairValueGaps.pop()
        old.topBox.delete()
        old.bottomBox.delete()

//──────────────────────────────────────────────────────────────────────────────
// v18.0 — Volume Imbalance (VI)
//   ICT body-to-body gap between two adjacent candles (distinct from FVG):
//     Bullish: max(open,close)[1] < min(open,close)  → gap above prev body
//     Bearish: min(open,close)[1] > max(open,close)  → gap below prev body
//   Stored with top > bottom invariant. Mitigated when body crosses the FAR
//   edge (bullish → below .bottom; bearish → above .top), consistent with
//   the OB/FVG mitigation-source model.
//──────────────────────────────────────────────────────────────────────────────
detectVolumeImbalances() =>
    if showVIInput and barstate.isconfirmed and bar_index >= 1
        float prevTopBody = math.max(open[1], close[1])
        float prevBotBody = math.min(open[1], close[1])
        float currTopBody = math.max(open, close)
        float currBotBody = math.min(open, close)
        bool bullVI = prevTopBody < currBotBody
        bool bearVI = prevBotBody > currTopBody
        int  barDur = nz(time - time[1], 60000)
        if bullVI
            box viBox = box.new(
                 chart.point.new(time[1], na, currBotBody),
                 chart.point.new(time + 5 * barDur, na, prevTopBody),
                 xloc=xloc.bar_time,
                 bgcolor=viBullColorInput,
                 border_color=color.new(viBullColorInput, 30),
                 border_style=line.style_dotted)
            volumeImbalance newVI = volumeImbalance.new(currBotBody, prevTopBody, BULLISH, viBox, bar_index)
            volumeImbalances.unshift(newVI)
            currentAlerts.volumeImbalanceFormed := true
        if bearVI
            box viBox = box.new(
                 chart.point.new(time[1], na, prevBotBody),
                 chart.point.new(time + 5 * barDur, na, currTopBody),
                 xloc=xloc.bar_time,
                 bgcolor=viBearColorInput,
                 border_color=color.new(viBearColorInput, 30),
                 border_style=line.style_dotted)
            volumeImbalance newVI = volumeImbalance.new(prevBotBody, currTopBody, BEARISH, viBox, bar_index)
            volumeImbalances.unshift(newVI)
            currentAlerts.volumeImbalanceFormed := true
        while volumeImbalances.size() > viMaxCountInput
            volumeImbalance oldVI = volumeImbalances.pop()
            oldVI.viBox.delete()

deleteVolumeImbalances() =>
    int sz = volumeImbalances.size()
    if sz > 0
        for index = sz - 1 to 0
            volumeImbalance vi = volumeImbalances.get(index)
            if vi.createdBarIndex >= bar_index
                continue
            float viBullSrc = viMitigationInput == CLOSE_SRC ? close
                 : viMitigationInput == BODY_SRC ? math.min(open, close)
                 : low
            float viBearSrc = viMitigationInput == CLOSE_SRC ? close
                 : viMitigationInput == BODY_SRC ? math.max(open, close)
                 : high
            bool mitigated = false
            // v19.6 — minPen guard for symmetry with OB/BB/FVG/iFVG.
            if vi.bias == BULLISH and viBullSrc < vi.bottom and (vi.bottom - viBullSrc) >= minPen
                mitigated := true
            else if vi.bias == BEARISH and viBearSrc > vi.top and (viBearSrc - vi.top) >= minPen
                mitigated := true
            if mitigated
                vi.viBox.delete()
                volumeImbalances.remove(index)

extendVolumeImbalances() =>
    int sz = volumeImbalances.size()
    if sz > 0
        int barDur = nz(time - time[1], 60000)
        int rightEdge = time + 5 * barDur
        for index = 0 to sz - 1
            volumeImbalance vi = volumeImbalances.get(index)
            vi.viBox.set_right(rightEdge)

drawFairValueGaps() =>
    // v18.4 — Volume series for RVOL stamping is now fetched at the same
    //         timeframe as the FVG OHLC tuple. Before, RVOL read chart-time
    //         volume[2] even when fairValueGapsTimeframeInput pointed at a
    //         higher timeframe — completely unrelated number.
    // v19.2 — Index offsets reduced by 1 across the tuple. Under lookahead_off,
    //         request.security() returns values from the last FULLY CLOSED HTF
    //         bar, so an offset of [0] (no offset) already means "last closed".
    //         The previous [3]/[2]/[1] (old/mid/recent) therefore looked at
    //         (last-closed-3)/(last-closed-2)/(last-closed-1), skipping the
    //         most-recently-finalized HTF bar entirely and detecting each FVG
    //         one full HTF bar after it could have been confirmed. New offsets
    //         [2]/[1]/[0] use (last-closed-2)/(last-closed-1)/(last-closed),
    //         firing the FVG on the chart bar where the 3rd HTF bar of the
    //         pattern has just closed (still no look-ahead). Volume offsets
    //         (mid-bar samples) shifted by the same -1.
    [midClose, midOpen, midTime, recentHigh, recentLow, recentTime, oldHigh, oldLow, htfOriginVol, htfAvgVol] = request.security(
         syminfo.tickerid,
         fairValueGapsTimeframeInput,
         [close[1], open[1], time[1], high, low, time, high[2], low[2], nz(volume[1]), ta.sma(nz(volume), rvolPeriodInput)[1]],
         lookahead = barmerge.lookahead_off)
    // v15.3 — Was (midClose - midOpen) / (midOpen * 100), which is 1/100th of
    //         the real percentage. Threshold compares like-for-like so detection
    //         still functioned, but the variable now represents an actual %.
    barDeltaPercent = midOpen != 0 ? (midClose - midOpen) / midOpen * 100 : 0
    newTimeframe    = timeframe.change(fairValueGapsTimeframeInput)
    // v19.2 — Threshold was ta.cum(|delta| on newTimeframe bars) / bar_index * 2.
    //         Two problems: (a) chart-history dependence — the running mean
    //         shifted with how much chart history TradingView loaded, so
    //         backtests weren't reproducible; and (b) the denominator was
    //         ALL chart bars while the numerator only accumulated on the rare
    //         newTimeframe bars (1 chart bar per HTF bar), making the average
    //         ~1/(chart-to-htf ratio) of the intended "average HTF bar move".
    //         On a 1m chart watching 4H FVGs, threshold was ~1/240 of intent.
    //         Replaced with a rolling 100-HTF-bar history of |barDeltaPercent|,
    //         updated only on newTimeframe transitions so the average is over
    //         HTF bars (not chart bars) and bounded so it can't drift with
    //         chart history.
    var array<float> htfDeltaHist = array.new<float>()
    if newTimeframe and not na(barDeltaPercent)
        htfDeltaHist.push(math.abs(barDeltaPercent))
        if htfDeltaHist.size() > 100
            htfDeltaHist.shift()
    float htfAvgAbsDelta = htfDeltaHist.size() > 0 ? htfDeltaHist.avg() : 0
    threshold       = fairValueGapsThresholdInput ? htfAvgAbsDelta * 2 : 0
    float ceLevel = na
    bullishFVG = recentLow > oldHigh and midClose > oldHigh and barDeltaPercent > threshold and newTimeframe and barstate.isconfirmed
    bearishFVG = recentHigh < oldLow and midClose < oldLow and -barDeltaPercent > threshold and newTimeframe and barstate.isconfirmed
    // v18.4 — RVOL stamp now reads from the request.security tuple so the
    //         volume sample matches the FVG's timeframe instead of using
    //         chart-time volume[2] (which only matched when FVG TF == chart).
    float fvgOriginVol = rvolEnableInput ? nz(htfOriginVol) : na
    float fvgAvgVol    = rvolEnableInput ? htfAvgVol        : na
    // v20.9 — RVOL audit #3: gate on volume availability so volumeless feeds
    //         don't produce a spurious fvgRVOL.
    float fvgRVOL      = (rvolEnableInput and rvolVolumeAvailable and not na(fvgAvgVol) and fvgAvgVol > 0) ? fvgOriginVol / fvgAvgVol : na
    bool  fvgIsInst    = rvolEnableInput and not na(fvgRVOL) and fvgRVOL >= rvolFVGThresholdInput
    // v18.0 — RVOL color modulation. Uses fvgIsInst computed above so it
    //         applies to whichever direction (bullish/bearish) fires.
    color rvolBullCol = fairValueGapBullishColor
    color rvolBearCol = fairValueGapBearishColor
    // v20.11 — RVOL #3 completion (see OB render comment).
    if rvolEnableInput and rvolVolumeAvailable and not fvgIsInst
        rvolBullCol := rvolHideRetailFVGInput ? color.new(fairValueGapBullishColor, 100) : color.new(fairValueGapBullishColor, 95)
        rvolBearCol := rvolHideRetailFVGInput ? color.new(fairValueGapBearishColor, 100) : color.new(fairValueGapBearishColor, 95)
    color activeBullFVGColor = showFairValueGapsInput ? rvolBullCol : color.new(fairValueGapBullishColor, 100)
    color activeBearFVGColor = showFairValueGapsInput ? rvolBearCol : color.new(fairValueGapBearishColor, 100)
    if bullishFVG
        currentAlerts.bullishFairValueGap := true
        ceLevel  := math.avg(recentLow, oldHigh)
        fairValueGaps.unshift(fairValueGap.new(recentLow, oldHigh, BULLISH,
             fairValueGapBox(midTime, recentTime, recentLow, ceLevel, activeBullFVGColor),
             fairValueGapBox(midTime, recentTime, ceLevel, oldHigh, activeBullFVGColor),
             bar_index, fvgRVOL, fvgIsInst))
    if bearishFVG
        currentAlerts.bearishFairValueGap := true
        ceLevel  := math.avg(recentHigh, oldLow)
        fairValueGaps.unshift(fairValueGap.new(recentHigh, oldLow, BEARISH,
             fairValueGapBox(midTime, recentTime, recentHigh, ceLevel, activeBearFVGColor),
             fairValueGapBox(midTime, recentTime, ceLevel, oldLow, activeBearFVGColor),
             bar_index, fvgRVOL, fvgIsInst))
    trimFairValueGaps()

//──────────────────────────────────────────────────────────────────────────────
// MTF Levels
//──────────────────────────────────────────────────────────────────────────────
getStyle(string style) =>
    switch style
        SOLID  => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted
        => line.style_solid   // v15.4 — safe fallback for unmatched strings

drawLevels(string tf, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, tf, [high[1],low[1],time[1],time], lookahead=barmerge.lookahead_on)
    // v19.2 — Same-timeframe branch was reading current-bar high/low/time,
    //         which painted the IN-PROGRESS period's extremes under a "P{tf}H"
    //         (Previous-period) label. On a daily chart with Daily Levels on,
    //         that meant today's high was labeled "PDH". Use [1] offsets so
    //         the same-TF case reads the PREVIOUS bar, matching both the
    //         label semantics and the cross-TF branch above.
    float parsedTop     = sameTimeframe ? high[1] : topLevel
    float parsedBottom  = sameTimeframe ? low[1]  : bottomLevel
    int parsedLeftTime  = sameTimeframe ? time[1] : leftTime
    int parsedRightTime = sameTimeframe ? time    : rightTime
    int parsedTopTime   = time
    int parsedBotTime   = time
    if not sameTimeframe
        int leftIndex  = math.max(0, times.binary_search_rightmost(parsedLeftTime))
        int rightIndex = math.min(times.size(), times.binary_search_rightmost(parsedRightTime))
        if rightIndex > leftIndex and leftIndex >= 0 and rightIndex <= times.size()
            timeArray    = times.slice(leftIndex, rightIndex)
            topArray     = highs.slice(leftIndex, rightIndex)
            bottomArray  = lows.slice(leftIndex, rightIndex)
            if timeArray.size() > 0
                parsedTopTime  := timeArray.get(topArray.indexof(topArray.max()))
                parsedBotTime  := timeArray.get(bottomArray.indexof(bottomArray.min()))
    var line  topLine  = line.new(na,na,na,na, xloc=xloc.bar_time, color=levelColor, style=getStyle(style))
    var line  botLine  = line.new(na,na,na,na, xloc=xloc.bar_time, color=levelColor, style=getStyle(style))
    var label topLabel = label.new(na,na, xloc=xloc.bar_time, text=str.format('P{0}H',tf), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left)
    var label botLabel = label.new(na,na, xloc=xloc.bar_time, text=str.format('P{0}L',tf), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left)
    rightEdge = last_bar_time + 20*(time-time[1])
    topLine.set_first_point(    chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(   chart.point.new(rightEdge,     na, parsedTop))
    topLabel.set_point(         chart.point.new(rightEdge,     na, parsedTop))
    botLine.set_first_point(    chart.point.new(parsedBotTime, na, parsedBottom))
    botLine.set_second_point(   chart.point.new(rightEdge,     na, parsedBottom))
    botLabel.set_point(         chart.point.new(rightEdge,     na, parsedBottom))

higherTimeframe(string tf) => timeframe.in_seconds() > timeframe.in_seconds(tf)

//──────────────────────────────────────────────────────────────────────────────
// Trailing extremes
//──────────────────────────────────────────────────────────   ───────────────────
updateTrailingExtremes() =>
    // v15.3 — Honour pivotSourceInput so trailing extremes track the same
    //         price source used by leg() / swing pivots. Previously locked
    //         to body high/low, which caused Strong/Weak H/L, Premium/Discount,
    //         and OTE to diverge from the swing pivots in Wick mode.
    float currentBodyHigh = pivotSourceInput == 'Wick' ? high : math.max(open, close)
    float currentBodyLow  = pivotSourceInput == 'Wick' ? low  : math.min(open, close)
    bool newTop = na(trailing.top) or currentBodyHigh > trailing.top
    trailing.top         := newTop ? currentBodyHigh : trailing.top
    trailing.lastTopTime := newTop ? time : trailing.lastTopTime
    bool newBot = na(trailing.bottom) or currentBodyLow < trailing.bottom
    trailing.bottom         := newBot ? currentBodyLow : trailing.bottom
    trailing.lastBottomTime := newBot ? time : trailing.lastBottomTime
    if na(trailing.barTime)
        trailing.barTime  := time
        trailing.barIndex := bar_index

drawHighLowSwings() =>
    var line  topLine  = line.new(na,na,na,na, color=swingBearishColor, xloc=xloc.bar_time)
    var line  botLine  = line.new(na,na,na,na, color=swingBullishColor, xloc=xloc.bar_time)
    var label topLabel = label.new(na,na, color=color(na), textcolor=swingBearishColor, xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny)
    var label botLabel = label.new(na,na, color=color(na), textcolor=swingBullishColor, xloc=xloc.bar_time, style=label.style_label_up,   size=size.tiny)
    rightEdge = last_bar_time + 20*(time-time[1])
    topLine.set_first_point(    chart.point.new(trailing.lastTopTime,    na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightEdge,               na, trailing.top))
    topLabel.set_point(         chart.point.new(rightEdge,               na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')
    botLine.set_first_point(    chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    botLine.set_second_point(   chart.point.new(rightEdge,               na, trailing.bottom))
    botLabel.set_point(         chart.point.new(rightEdge,               na, trailing.bottom))
    botLabel.set_text(          swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

//───────────────────────────────────────────────────────   ──────────────────────
// Premium/Discount zones
//──────────────────────────────────────────────────────────────────────────────
drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style, int leftTime) =>
    var label l_abel = label.new(na,na, text=tag, color=color(na), textcolor=zoneColor, style=style, size=size.small)
    var box   b_ox   = box.new(na,na,na,na, bgcolor=color.new(zoneColor,80), border_color=color(na), xloc=xloc.bar_time)
    b_ox.set_top_left_point(    chart.point.new(leftTime,      na, top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, bottom))
    l_abel.set_point(           chart.point.new(na, labelIndex, labelLevel))

drawPremiumDiscountZones() =>
    float zoneTop    = trailing.top
    float zoneBottom = trailing.bottom
    if not na(zoneTop) and not na(zoneBottom) and zoneTop > zoneBottom
        float zoneRange  = zoneTop - zoneBottom
        float minHeight  = syminfo.mintick * 2
        int highBarIdx   = not na(swingHigh.barIndex) ? swingHigh.barIndex : bar_index
        int lowBarIdx    = not na(swingLow.barIndex)  ? swingLow.barIndex  : bar_index
        int barDuration  = math.max(time - time[1], 1)
        int minBoxBars   = math.max(swingsLengthInput, 20)
        int minLeftTime  = last_bar_time - minBoxBars * barDuration
        int rawTopAnchor = nz(trailing.lastTopTime,    minLeftTime)
        int rawBotAnchor = nz(trailing.lastBottomTime, minLeftTime)
        int topAnchor    = rawTopAnchor >= last_bar_time ? minLeftTime : rawTopAnchor
        int botAnchor    = rawBotAnchor >= last_bar_time ? minLeftTime : rawBotAnchor
        int eqAnchor     = math.min(topAnchor, botAnchor)
        float premHeight = math.max(0.05 * zoneRange, minHeight)
        float eqHeight   = math.max(0.025 * zoneRange, minHeight)
        float discHeight = math.max(0.05 * zoneRange, minHeight)
        drawZone(zoneTop, math.round(0.5*(highBarIdx + last_bar_index)), zoneTop, zoneTop - premHeight, 'Premium', premiumZoneColor, label.style_label_down, topAnchor)
        eqLevel = math.avg(zoneTop, zoneBottom)
        drawZone(eqLevel, last_bar_index, eqLevel + eqHeight, eqLevel - eqHeight, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left, eqAnchor)
        drawZone(zoneBottom, math.round(0.5*(lowBarIdx + last_bar_index)), zoneBottom + discHeight, zoneBottom, 'Discount', discountZoneColor, label.style_label_up, botAnchor)

// v20.8 — Single source of truth for OTE levels (BS audit #4 + #5 fix; #1-#3
//         handled via oteAnchorModeInput). Returns
//         [upper, lower, valid, srcTop, srcBottom, eqLvl].
//           #4 — fib order clamped: fShallow = min(fib1,fib2),
//                fDeep = max(...), so the box can never invert even if the
//                user sets Fib1 >= Fib2.
//           #5 — both drawOTEZone() and the priceInOTE alert consume this,
//                so the level math exists in exactly one place.
//           #1-#3 — 'Impulse Leg' mode sources frozen leg anchors and
//                respects the void flag; 'Dealing Range' keeps the legacy
//                trailing-envelope source.
oteZoneLevels() =>
    float srcTop    = oteAnchorModeInput == 'Impulse Leg' ? oteLegState.top    : trailing.top
    float srcBottom = oteAnchorModeInput == 'Impulse Leg' ? oteLegState.bottom : trailing.bottom
    float fShallow  = math.min(oteFib1Input, oteFib2Input)
    float fDeep     = math.max(oteFib1Input, oteFib2Input)
    bool  valid     = not na(srcTop) and not na(srcBottom) and srcTop > srcBottom and (srcTop - srcBottom) >= syminfo.mintick * 10
    if oteAnchorModeInput == 'Impulse Leg' and oteLegState.voided
        valid := false
    float upper = na
    float lower = na
    float eqLvl = na
    if valid
        float rng    = srcTop - srcBottom
        bool  isBull = swingTrend.bias == BULLISH
        upper := isBull ? srcTop - fShallow * rng : srcBottom + fDeep    * rng
        lower := isBull ? srcTop - fDeep    * rng : srcBottom + fShallow * rng
        eqLvl := srcTop - 0.5 * rng
    [upper, lower, valid, srcTop, srcBottom, eqLvl]

drawOTEZone() =>
    var box  oteBox     = box.new(na, na, na, na, xloc=xloc.bar_time)
    var line oteFibLine = line.new(na, na, na, na, xloc=xloc.bar_time, style=line.style_dotted, width=1)
    var line ote618Line = line.new(na, na, na, na, xloc=xloc.bar_time, style=line.style_dashed, width=1)
    var line ote786Line = line.new(na, na, na, na, xloc=xloc.bar_time, style=line.style_dashed, width=1)
    var label oteLabel  = label.new(na, na, xloc=xloc.bar_time, size=size.tiny, color=color(na))

    [oteUpper, oteLower, oteValid, swTop, swBottom, eqLevel] = oteZoneLevels()

    if not oteValid
        oteBox.set_bgcolor(color.new(color.white, 100))
        oteBox.set_border_color(color.new(color.white, 100))
        oteFibLine.set_color(color.new(color.white, 100))
        ote618Line.set_color(color.new(color.white, 100))
        ote786Line.set_color(color.new(color.white, 100))
        oteLabel.set_text('')
    else
        bool isBullish = swingTrend.bias == BULLISH
        color oteColor = isBullish
             ? (styleInput == MONOCHROME ? color.new(MONO_BULLISH, 75) : oteBullColorInput)
             : (styleInput == MONOCHROME ? color.new(MONO_BEARISH, 75) : oteBearColorInput)

        // v20.8 — In Impulse Leg mode anchor the box left edge at the frozen
        //         leg origin time; otherwise keep the legacy trailing-edge.
        int leftTime  = oteAnchorModeInput == 'Impulse Leg' and not na(oteLegState.anchorTime)
             ? oteLegState.anchorTime
             : math.max(nz(trailing.lastTopTime, time), nz(trailing.lastBottomTime, time))
        int rightEdge = last_bar_time + 10 * (time - time[1])

        oteBox.set_top_left_point(    chart.point.new(leftTime,  na, oteUpper))
        oteBox.set_bottom_right_point(chart.point.new(rightEdge, na, oteLower))
        oteBox.set_bgcolor(oteColor)
        oteBox.set_border_color(color.new(oteColor, 50))

        if showOTEFibsInput
            // v20.10 — Bind each fib line to its actual retracement level
            //          regardless of bias. oteUpper/oteLower are GEOMETRIC
            //          (higher/lower price); the 0.618 (shallow) and 0.786
            //          (deep) levels map differently per direction:
            //            bull → 0.618 = upper, 0.786 = lower
            //            bear → 0.618 = lower, 0.786 = upper
            //          Pre-v20.10 the 0.618 handle was always assigned
            //          oteUpper, so on bearish zones it actually held the
            //          0.786 level. Invisible while both share oteColor, but
            //          wrong if the two lines are ever styled differently.
            float fib618Price = isBullish ? oteUpper : oteLower
            float fib786Price = isBullish ? oteLower : oteUpper

            oteFibLine.set_first_point( chart.point.new(leftTime,  na, eqLevel))
            oteFibLine.set_second_point(chart.point.new(rightEdge, na, eqLevel))
            oteFibLine.set_color(color.new(equilibriumZoneColorInput, 30))

            ote618Line.set_first_point( chart.point.new(leftTime,  na, fib618Price))
            ote618Line.set_second_point(chart.point.new(rightEdge, na, fib618Price))
            ote618Line.set_color(color.new(oteColor, 40))

            ote786Line.set_first_point( chart.point.new(leftTime,  na, fib786Price))
            ote786Line.set_second_point(chart.point.new(rightEdge, na, fib786Price))
            ote786Line.set_color(color.new(oteColor, 40))
        else
            oteFibLine.set_color(color.new(color.white, 100))
            ote618Line.set_color(color.new(color.white, 100))
            ote786Line.set_color(color.new(color.white, 100))

        string oteTxt = isBullish ? 'OTE Buy' : 'OTE Sell'
        oteLabel.set_point(chart.point.new(rightEdge, na, math.avg(oteUpper, oteLower)))
        oteLabel.set_text(oteTxt)
        oteLabel.set_textcolor(oteColor)
        oteLabel.set_style(label.style_label_left)

//───────────────────────────────────────────────────────────────────────────  ──
// Candle Coloring
//──────────────────────────────────────────────────────────────────────────────
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen, high, low, close, color=candleColor, wickcolor=candleColor, bordercolor=candleColor)
// v18.7 — MSS AVWAP plot() moved to AFTER the AVWAP computation block
//         (see end of main execution section) to fix a 1-bar lag.

//──────────────────────────────────────────────────────────────────────────────
// Main Execution
//──────────────────────────────────────────────────────────────────────────────
if needFVGTracking and barstate.isconfirmed
    deleteFairValueGaps()
if showIFVGInput and barstate.isconfirmed
    deleteInvertedFVGs()

copyPivot(snapInternalHigh, internalHigh)
copyPivot(snapInternalLow,  internalLow)
copyPivot(snapSwingHigh,    swingHigh)
copyPivot(snapSwingLow,     swingLow)

getCurrentStructure(swingsLengthInput, false)
getCurrentStructure(internalLengthInput, false, true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput, true)

// v18.8 — Run the dedicated CVD pivot detector only when needed.
if showCVDDivergenceInput and cvdPivotSourceInput == 'Custom'
    detectCVDCustomPivot(cvdCustomPivotLengthInput)

if showInternalsInput or needInternalOBTracking or showTrendInput
    displayStructure(true)

if showStructureInput or needSwingOBTracking or showHighLowSwingsInput
    displayStructure()

// v19.4 — Trailing extremes + Strong/Weak / Premium-Discount / OTE rendering
//         moved here from BEFORE getCurrentStructure/displayStructure so
//         these visuals read the CURRENT bar's swingTrend.bias instead of
//         yesterday's. Previously OTE direction, Strong/Weak high-low
//         labels, and Premium/Discount placement lagged one bar on every
//         BOS/CHoCH bias flip. Order updateTrailingExtremes() → drawers is
//         preserved within the block, and the function itself is order-
//         independent vs getCurrentStructure's trailing writes (a new
//         pivot resets trailing to the pivot level, and the next-bar
//         bodyHigh/Low extension via updateTrailingExtremes is unaffected).
if showHighLowSwingsInput or showPremiumDiscountZonesInput or showOTEInput
    updateTrailingExtremes()
    if showHighLowSwingsInput
        drawHighLowSwings()
    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()
    // v20.8 — Impulse-Leg void check (BS audit #3). Runs every bar so a
    //         long whose leg origin is violated (close below legBottom) or
    //         a short whose origin is violated (close above legTop) voids
    //         the zone instead of letting it stretch to chase price.
    if oteAnchorModeInput == 'Impulse Leg' and not oteLegState.voided and not na(oteLegState.bottom) and not na(oteLegState.top)
        if swingTrend.bias == BULLISH and close < oteLegState.bottom
            oteLegState.voided := true
        else if swingTrend.bias == BEARISH and close > oteLegState.top
            oteLegState.voided := true
    // v20.10 — R1 fix: extend the leg's terminal extreme to the running
    //          high/low after the break, then FREEZE on the first bar that
    //          retraces into the OTE band. Before freeze the zone tracks the
    //          impulse upward (bull) / downward (bear) under price; once
    //          price pulls back into it the band locks and becomes a static,
    //          placeable level. Extension is skipped once frozen or voided.
    if oteAnchorModeInput == 'Impulse Leg' and not oteLegState.voided and not oteLegState.frozen and not na(oteLegState.bottom) and not na(oteLegState.top)
        if swingTrend.bias == BULLISH
            oteLegState.top := math.max(oteLegState.top, high)
        else if swingTrend.bias == BEARISH
            oteLegState.bottom := math.min(oteLegState.bottom, low)
        // v20.14 — R1 audit #6: freeze on the first WICK touch (bar range
        //          overlaps the band), not close-inside. A sharp wick into
        //          OTE that rejects without closing inside is the classic
        //          first reaction; close-only let the leg keep extending and
        //          the zone drift away from that actionable touch. Skip the
        //          capture (BOS) bar so a large displacement candle's lower
        //          wick can't freeze a truncated leg on bar 0.
        [_legUpper, _legLower, _legValid, _ls1, _ls2, _ls3] = oteZoneLevels()
        if _legValid and bar_index > nz(oteLegState.captureBar, bar_index) and high >= _legLower and low <= _legUpper
            oteLegState.frozen := true
    // v15.3 — Don't render OTE before the first BOS/CHoCH; until then
    //         swingTrend.bias == 0, which silently rendered as bearish.
    if showOTEInput and swingTrend.bias != 0
        drawOTEZone()

// ── v18.4 — Anchored VWAP with selectable anchor type ─────────────────────────
//   Reset cumulative on the chosen anchor event; accumulate hlc3 * volume
//   thereafter. plot.style_linebr breaks the line on the reset bar so the new
//   AVWAP doesn't visually connect to the previous one. Tag-alert fires when
//   price wicks the level after at least one prior bar where price was outside.
//
//   Anchor types:
//     MSS    — reset on any confirmed Market Structure Shift (internal or swing)
//     Swing  — reset on every new swing high or swing low pivot (barIndex change)
//     Daily  — reset on isNewDay
//     Weekly — reset on isNewWeek
bool mssAnyFired       = currentAlerts.internalBullishMSS or currentAlerts.swingBullishMSS or currentAlerts.internalBearishMSS or currentAlerts.swingBearishMSS
bool mssSwingOnlyFired = currentAlerts.swingBullishMSS or currentAlerts.swingBearishMSS
bool swingHighNew      = not na(swingHigh.barIndex) and swingHigh.barIndex != lastAvwapSwingHighIdx
bool swingLowNew       = not na(swingLow.barIndex)  and swingLow.barIndex  != lastAvwapSwingLowIdx
bool avwapShouldReset = avwapAnchorTypeInput == 'MSS'       ? mssAnyFired
                      : avwapAnchorTypeInput == 'MSS Swing' ? mssSwingOnlyFired
                      : avwapAnchorTypeInput == 'Swing'     ? (swingHighNew or swingLowNew)
                      : avwapAnchorTypeInput == 'Daily'     ? isNewDay
                      : avwapAnchorTypeInput == 'Weekly'    ? isNewWeek
                      : false
mssAvwapResetThisBar := false
if showMSSAVWAPInput and avwapShouldReset
    mssAvwapAnchorTime   := time
    mssAvwapAnchorBar    := bar_index
    mssAvwapCumPV        := 0.0
    mssAvwapCumVol       := 0.0
    mssAvwapResetThisBar := true
// Update tracking indices for the Swing anchor type. Update unconditionally so
// the comparison on subsequent bars detects only true pivot changes.
if not na(swingHigh.barIndex)
    lastAvwapSwingHighIdx := swingHigh.barIndex
if not na(swingLow.barIndex)
    lastAvwapSwingLowIdx  := swingLow.barIndex

if showMSSAVWAPInput and not na(mssAvwapAnchorBar)
    mssAvwapCumPV  += hlc3 * nz(volume)
    mssAvwapCumVol += nz(volume)
    mssAvwapValue  := mssAvwapCumVol > 0 ? mssAvwapCumPV / mssAvwapCumVol : na
else
    mssAvwapValue := na

if showMSSAVWAPInput and barstate.isconfirmed and not na(mssAvwapValue) and not na(mssAvwapValue[1])
    bool taggedNow  = high >= mssAvwapValue and low <= mssAvwapValue
    bool taggedPrev = high[1] >= mssAvwapValue[1] and low[1] <= mssAvwapValue[1]
    if taggedNow and not taggedPrev
        currentAlerts.mssAVWAPTagged := true

// v18.7 — AVWAP plot moved here from above plotcandle. mssAvwapValue is a
//         `var` so a plot() positioned above its assignment captured the
//         previous bar's final value, producing a 1-bar visible lag and
//         shifting the linebr gap one bar later than the actual MSS event.
plot(showMSSAVWAPInput and not mssAvwapResetThisBar ? mssAvwapValue : na,
     title = 'MSS Anchored VWAP',
     color = mssAVWAPColorInput,
     linewidth = mssAVWAPWidthInput,
     style = plot.style_linebr)

// Liquidity Sweep Detection
// v16.7 — Compare against the swing pivot's wick high/low (actualLevel) so a
//         sweep registers against the true swing extreme even when Pivot
//         Source = Body anchors currentLevel at the body. Falls back to
//         currentLevel when actualLevel is na (warm-up safety).
if showLiquiditySweepsInput and barstate.isconfirmed
    // v20.7 — Multi-level swing-sweep tracking (BS-2 fix). Replaces the
    //         single-pivot latch with watch-list arrays holding the last N
    //         unswept swing highs / lows. Each new swing pivot is pushed
    //         (deduped on barIndex); the array is capped at
    //         swingSweepLevelsInput, evicting the oldest. Every confirmed
    //         bar we iterate the watch lists: a wick-through-and-close-back
    //         = sweep (fire alert + label, remove level); a clean close
    //         beyond the level = level consumed by trend (remove, no alert).
    //         Set swingSweepLevelsInput = 1 to reproduce legacy behavior.
    //
    //         Push newly-formed swing high (dedup on barIndex).
    if not na(swingHigh.currentLevel) and not na(swingHigh.barIndex) and swingHigh.barIndex != lastSwingHighPushIdx
        swingHighSweepPools.unshift(eqPool.new(swingHigh.currentLevel, nz(swingHigh.actualLevel, swingHigh.currentLevel), swingHigh.barIndex, swingHigh.barIndex, 1))
        while swingHighSweepPools.size() > swingSweepLevelsInput
            swingHighSweepPools.pop()
        lastSwingHighPushIdx := swingHigh.barIndex
    if not na(swingLow.currentLevel) and not na(swingLow.barIndex) and swingLow.barIndex != lastSwingLowPushIdx
        swingLowSweepPools.unshift(eqPool.new(swingLow.currentLevel, nz(swingLow.actualLevel, swingLow.currentLevel), swingLow.barIndex, swingLow.barIndex, 1))
        while swingLowSweepPools.size() > swingSweepLevelsInput
            swingLowSweepPools.pop()
        lastSwingLowPushIdx := swingLow.barIndex
    // Scan high watch list (reverse for safe in-loop removal).
    int _shSz = swingHighSweepPools.size()
    if _shSz > 0
        for _i = _shSz - 1 to 0
            eqPool _hp = swingHighSweepPools.get(_i)
            float sweepHighLevel = nz(_hp.actualLevel, _hp.level)
            if high > sweepHighLevel and close <= sweepHighLevel
                currentAlerts.bearishLiquiditySweep := true
                color sweepCol = styleInput == MONOCHROME ? MONO_BEARISH : sweepBearColorInput
                label sl = label.new(bar_index, high, 'Sweep',
                     color=color(na), textcolor=sweepCol,
                     style=label.style_label_down, size=sweepLabelSizeInput)
                sweepLabels.push(sl)
                if sweepLabels.size() > MAX_SWEEP_LABELS
                    label.delete(sweepLabels.shift())
                swingHighSweepPools.remove(_i)
            else if close > sweepHighLevel
                swingHighSweepPools.remove(_i)
    // Scan low watch list.
    int _slSz = swingLowSweepPools.size()
    if _slSz > 0
        for _i = _slSz - 1 to 0
            eqPool _lp = swingLowSweepPools.get(_i)
            float sweepLowLevel = nz(_lp.actualLevel, _lp.level)
            if low < sweepLowLevel and close >= sweepLowLevel
                currentAlerts.bullishLiquiditySweep := true
                color sweepCol = styleInput == MONOCHROME ? MONO_BULLISH : sweepBullColorInput
                label sl = label.new(bar_index, low, 'Sweep',
                     color=color(na), textcolor=sweepCol,
                     style=label.style_label_up, size=sweepLabelSizeInput)
                sweepLabels.push(sl)
                if sweepLabels.size() > MAX_SWEEP_LABELS
                    label.delete(sweepLabels.shift())
                swingLowSweepPools.remove(_i)
            else if close < sweepLowLevel
                swingLowSweepPools.remove(_i)

    // v17.0 — Equal Highs/Lows are textbook ICT liquidity pools.
    //         Mirror the swing sweep latching logic against the most recent
    //         confirmed EQH/EQL level so wick-and-reverse through a pool
    //         emits its own dedicated alert.
    // v19.2 — Reference validEqHigh/Low (set only inside the EQ-tolerance
    // v19.6 — Multi-pool sweep detection. Iterate every active EQH/EQL pool;
    //         each pool is its own latch (no global swept/anyCloseBeyond
    //         scalar — the array membership IS the latch). A pool exits the
    //         array in two ways:
    //           (a) Sweep — high > level AND close ≤ level (wick-and-reverse
    //               for EQH; mirror for EQL). Fires the sweep alert + label.
    //           (b) Clean break — close past the level without the wick-and-
    //               reverse. Pool is "consumed" by trend; no sweep alert.
    //         Iterate reverse so .remove() during the loop is safe.
    int hiSweepSz = validEqHighPools.size()
    if hiSweepSz > 0
        for hiIdx = hiSweepSz - 1 to 0
            eqPool ep = validEqHighPools.get(hiIdx)
            float eqHighSweepLevel = nz(ep.actualLevel, ep.level)
            if high > eqHighSweepLevel and close <= eqHighSweepLevel
                currentAlerts.bearishEQHSweep := true
                color sweepCol = styleInput == MONOCHROME ? MONO_BEARISH : sweepBearColorInput
                label sl = label.new(bar_index, high, 'EQH×',
                     color=color(na), textcolor=sweepCol,
                     style=label.style_label_down, size=sweepLabelSizeInput)
                sweepLabels.push(sl)
                if sweepLabels.size() > MAX_SWEEP_LABELS
                    label.delete(sweepLabels.shift())
                validEqHighPools.remove(hiIdx)
            else if close > eqHighSweepLevel
                validEqHighPools.remove(hiIdx)
    int loSweepSz = validEqLowPools.size()
    if loSweepSz > 0
        for loIdx = loSweepSz - 1 to 0
            eqPool ep = validEqLowPools.get(loIdx)
            float eqLowSweepLevel = nz(ep.actualLevel, ep.level)
            if low < eqLowSweepLevel and close >= eqLowSweepLevel
                currentAlerts.bullishEQLSweep := true
                color sweepCol = styleInput == MONOCHROME ? MONO_BULLISH : sweepBullColorInput
                label sl = label.new(bar_index, low, 'EQL×',
                     color=color(na), textcolor=sweepCol,
                     style=label.style_label_up, size=sweepLabelSizeInput)
                sweepLabels.push(sl)
                if sweepLabels.size() > MAX_SWEEP_LABELS
                    label.delete(sweepLabels.shift())
                validEqLowPools.remove(loIdx)
            else if close < eqLowSweepLevel
                validEqLowPools.remove(loIdx)

// v17.0 — CVD divergence detection at confirmed swing pivots.
//         Bearish: HH in price + LH in CVD (price made higher swing high
//                  but cumulative delta did NOT confirm = absorption /
//                  distribution).
//         Bullish: LL in price + HL in CVD (price made lower swing low
//                  but cumulative delta did NOT confirm = accumulation).
//         Triggered once per pivot, gated on barIndex change so it doesn't
//         re-fire while the swing is still the most-recent pivot.
if showCVDDivergenceInput and barstate.isconfirmed
    // v20.16 — Resolve the user-selected CVD÷ label size once per bar.
    string _cvdDivSz = cvdDivLabelSizeInput == 'Tiny'   ? size.tiny
                     : cvdDivLabelSizeInput == 'Normal' ? size.normal
                     : cvdDivLabelSizeInput == 'Large'  ? size.large
                     : cvdDivLabelSizeInput == 'Huge'   ? size.huge
                     :                                    size.small
    // v18.8 — Pivot-stream selection: Swing / Internal / Custom (dropdown).
    pivot cvdHighPivot = cvdPivotSourceInput == 'Internal' ? internalHigh
                       : cvdPivotSourceInput == 'Custom'   ? cvdCustomHigh
                       :                                     swingHigh
    pivot cvdLowPivot  = cvdPivotSourceInput == 'Internal' ? internalLow
                       : cvdPivotSourceInput == 'Custom'   ? cvdCustomLow
                       :                                     swingLow
    // v19.9 — Magnitude filter. v20.7 (BS-3) — now LEG-LENGTH normalized.
    //         The numerator (currentCVD − lastCVD) is the CUMULATIVE CVD
    //         change across the entire span between two pivots (often 20-40
    //         bars). Pre-v20.7 the denominator was only the per-bar average
    //         |cvdBarDelta|, so the ratio scaled with the number of bars in
    //         the leg — a widely-spaced pivot pair scored high "magnitude"
    //         purely from accumulating more bars, while a sharp short-leg
    //         divergence could fail. Now multiply the denominator by the
    //         bar-distance between the two pivots, giving a true per-bar
    //         intensity (net CVD flow per bar, relative to typical bar flow)
    //         that's independent of leg length. When cvdDivMinMagnitudeInput
    //         = 0 (default) the filter is off regardless.
    float cvdAvgAbsDelta = nz(ta.sma(math.abs(cvdBarDelta), 50), 0.0)
    float cvdPerBarDenom = math.max(cvdAvgAbsDelta, 1e-9)
    if cvdHighPivot.barIndex != lastCVDDivHighIdx
        if not na(cvdHighPivot.lastLevel) and not na(cvdHighPivot.lastCVD) and not na(cvdHighPivot.currentCVD) and cvdHighPivot.currentLevel > cvdHighPivot.lastLevel and cvdHighPivot.currentCVD < cvdHighPivot.lastCVD
            int   _bearLegBars = not na(cvdHighPivot.lastBarIndex) ? math.max(cvdHighPivot.barIndex - cvdHighPivot.lastBarIndex, 1) : 1
            float bearMag      = math.abs(cvdHighPivot.currentCVD - cvdHighPivot.lastCVD) / (cvdPerBarDenom * _bearLegBars)
            bool  passesBearMag = bearMag >= cvdDivMinMagnitudeInput
            if passesBearMag
                currentAlerts.bearishCVDDivergence := true
                label divLabel = label.new(cvdHighPivot.barTime, cvdHighPivot.actualLevel, 'CVD÷',
                     xloc=xloc.bar_time,
                     color=color(na),
                     textcolor=cvdBearDivColorInput,
                     style=label.style_label_down,
                     size=_cvdDivSz)
                cvdDivLabels.push(divLabel)
                if cvdDivLabels.size() > MAX_SWEEP_LABELS
                    label.delete(cvdDivLabels.shift())
        lastCVDDivHighIdx := cvdHighPivot.barIndex
    if cvdLowPivot.barIndex != lastCVDDivLowIdx
        if not na(cvdLowPivot.lastLevel) and not na(cvdLowPivot.lastCVD) and not na(cvdLowPivot.currentCVD) and cvdLowPivot.currentLevel < cvdLowPivot.lastLevel and cvdLowPivot.currentCVD > cvdLowPivot.lastCVD
            int   _bullLegBars = not na(cvdLowPivot.lastBarIndex) ? math.max(cvdLowPivot.barIndex - cvdLowPivot.lastBarIndex, 1) : 1
            float bullMag      = math.abs(cvdLowPivot.currentCVD - cvdLowPivot.lastCVD) / (cvdPerBarDenom * _bullLegBars)
            bool  passesBullMag = bullMag >= cvdDivMinMagnitudeInput
            if passesBullMag
                currentAlerts.bullishCVDDivergence := true
                label divLabel = label.new(cvdLowPivot.barTime, cvdLowPivot.actualLevel, 'CVD÷',
                     xloc=xloc.bar_time,
                     color=color(na),
                     textcolor=cvdBullDivColorInput,
                     style=label.style_label_up,
                     size=_cvdDivSz)
                cvdDivLabels.push(divLabel)
                if cvdDivLabels.size() > MAX_SWEEP_LABELS
                    label.delete(cvdDivLabels.shift())
        lastCVDDivLowIdx := cvdLowPivot.barIndex

// v15.4 — Correct execution order: delete OBs FIRST (mitigation → BB conversion),
//         THEN count touches on surviving OBs. Previously updateOrderBlockTouches()
//         ran before deleteOrderBlocks(), so on the bar of mitigation an OB could
//         hit maxOBTouchesInput via touch counting and be removed by exhaustion
//         before deleteOrderBlocks() had a chance to convert it to a BB.
if needInternalOBTracking and barstate.isconfirmed
    deleteOrderBlocks(true)
if needSwingOBTracking and barstate.isconfirmed
    deleteOrderBlocks()

if needInternalOBTracking and barstate.isconfirmed
    updateOrderBlockTouches(true)
if needSwingOBTracking and barstate.isconfirmed
    updateOrderBlockTouches()

// Delete breakers BEFORE touch counting to allow mitigation alerts to fire
// before the touch count exhausts the breaker on the mitigation bar.
if showInternalBreakerBlocksInput and barstate.isconfirmed
    deleteBreakerBlocks(true)
if showSwingBreakerBlocksInput and barstate.isconfirmed
    deleteBreakerBlocks()

// v15.3 — Count BB touches so the breaker has a chance to register a retest
//         Touch counter exhaustion (touchCount >= maxOBTouchesInput)
//         is also enforced inside updateBreakerBlockTouches().
if showInternalBreakerBlocksInput and barstate.isconfirmed
    updateBreakerBlockTouches(true)
if showSwingBreakerBlocksInput and barstate.isconfirmed
    updateBreakerBlockTouches()

if needFVGTracking and barstate.isconfirmed
    drawFairValueGaps()

// v18.0 — Volume Imbalance lifecycle. Detect on confirmed bars, mitigate on
//         confirmed bars (using the configured mitigation source), extend
//         box right edges every bar so unmitigated VIs stay visible.
if showVIInput and barstate.isconfirmed
    deleteVolumeImbalances()
if showVIInput
    detectVolumeImbalances()
    extendVolumeImbalances()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)
    if showSwingOrderBlocksInput
        drawOrderBlocks()
    if showInternalBreakerBlocksInput
        drawBreakerBlocks(true)
    if showSwingBreakerBlocksInput
        drawBreakerBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar           = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D', timeframe.isdaily,   dailyLevelsStyleInput,   dailyLevelsColorInput)
    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W', timeframe.isweekly,  weeklyLevelsStyleInput,  weeklyLevelsColorInput)
    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

//──────────────────────────────────────────────────────────────────────────────
// Kill Zones
//──────────────────────────────────────────────────────────────────────────────
inKillZone(string sess) => not na(time(timeframe.period, sess, kzTimezoneInput))

// v16.7 — Auto-suppress kill zones on equity instruments.
bool kzEnabled = showKillZonesInput and not isEquityInstrument

bool inAsianKZ       = kzEnabled and kzAsianInput       and inKillZone('2000-0000')
bool inLondonOpenKZ  = kzEnabled and kzLondonOpenInput  and inKillZone('0200-0500')
bool inNYOpenKZ      = kzEnabled and kzNYOpenInput      and inKillZone('0700-1000')
bool inLondonCloseKZ = kzEnabled and kzLondonCloseInput and inKillZone('1000-1200')

bool inSilverBulletAM  = kzEnabled and kzSilverBulletAMInput  and inKillZone('1000-1100')
bool inSilverBulletPM  = kzEnabled and kzSilverBulletPMInput  and inKillZone('1400-1500')
bool inSilverBulletLDN = kzEnabled and kzSilverBulletLDNInput and inKillZone('0300-0400')

// v19.8 — KZ + Silver Bullet bottom ribbon (replaces six bgcolor() calls).
//         bgcolor() with series color = 1 output; plotshape() with series
//         color = 2 outputs. Split-per-zone was 12 outputs (blew the
//         ceiling); collapsing helped.
// v19.10 — Kill Zones and Silver Bullet split into TWO plotshapes so they're
//          visually distinguishable when they overlap in time (Silver Bullet
//          AM falls inside London Close KZ, Silver Bullet LDN inside London
//          Open KZ, etc.). KZ uses shape.square, Silver Bullet uses
//          shape.diamond — same bottom row, different glyph. Cost: 2
//          plotshapes × 2 outputs = 4 (was 2). Still well under the 64
//          ceiling. When an SB window is also a KZ window, both render at
//          the same bar — user sees a diamond ON a square = "this KZ is
//          ALSO a Silver Bullet sub-window".
bool _inAnyKz = inAsianKZ or inLondonOpenKZ or inNYOpenKZ or inLondonCloseKZ
color _kzColor = inAsianKZ       ? kzAsianColorInput
               : inLondonOpenKZ  ? kzLondonOpenColorInput
               : inNYOpenKZ      ? kzNYOpenColorInput
               : inLondonCloseKZ ? kzLondonCloseColorInput
               : na
plotshape(_inAnyKz, title='Kill Zones', location=location.bottom, color=_kzColor, style=shape.square, size=size.tiny)

bool _inAnySb = inSilverBulletAM or inSilverBulletPM or inSilverBulletLDN
color _sbColor = inSilverBulletAM  ? kzSilverBulletAMColorInput
               : inSilverBulletPM  ? kzSilverBulletPMColorInput
               : inSilverBulletLDN ? kzSilverBulletLDNColorInput
               : na
plotshape(_inAnySb, title='Silver Bullet', location=location.bottom, color=_sbColor, style=shape.diamond, size=size.tiny)

// v19.8 — Silver Bullet windows merged into the combined KZ/SB
//         plotshape above to save output slots.

// v18.1 — Power of 3 (PO3) day-cycle module removed.

//──────────────────────────────────────────────────────────────────────────────
// Session Boxes
//──────────────────────────────────────────────────────────────────────────────
// v20.3 — Now accepts explicit timezone so per-session-local anchoring
//         works. The Single-Timezone path passes sessTimezoneInput from
//         the call site (no behavior change for legacy mode).
inSessionWindow(string sess, string tz) => not na(time(timeframe.period, sess, tz))

// v20.2 — Added drawAllowed parameter. State tracking (tracker.active,
//         .prevActive, .sessionHigh, .sessionLow) updates EVERY bar so
//         the active-state transitions remain coherent across history-
//         window boundaries. Only the box/label CREATION and the
//         subsequent geometry updates are gated. If a session started
//         while drawAllowed was false, no box exists; the expand block's
//         `if not na(tracker.sessionBox)` guard silently skips it.
updateSession(sessionTracker tracker, bool isActive, string sessionName, color sessColor, bool drawAllowed) =>
    tracker.prevActive := tracker.active
    tracker.active     := isActive
    if tracker.active and not tracker.prevActive
        tracker.sessionHigh       := high
        tracker.sessionLow        := low
        tracker.sessionStartTime  := time
        tracker.sessionStartIndex := bar_index
        if drawAllowed
            color borderCol = sessBoxBorderInput ? color.new(sessColor, 50) : na
            tracker.sessionBox := box.new(
                 chart.point.new(time, na, high),
                 chart.point.new(time, na, low),
                 xloc=xloc.bar_time,
                 bgcolor=sessColor,
                 border_color=borderCol,
                 border_width=1)
            sessionBoxes.push(tracker.sessionBox)
            if sessionBoxes.size() > MAX_SESSION_BOXES
                box.delete(sessionBoxes.shift())
            if sessLabelInput
                tracker.sessionLabel := label.new(
                     chart.point.new(time, na, high),
                     sessionName,
                     xloc=xloc.bar_time,
                     color=color(na),
                     textcolor=color.new(sessColor, 0),
                     style=label.style_label_down,
                     size=size.tiny)
                sessionLabsArr.push(tracker.sessionLabel)
                if sessionLabsArr.size() > MAX_SESSION_LABELS
                    label.delete(sessionLabsArr.shift())
    if tracker.active
        tracker.sessionHigh := math.max(nz(tracker.sessionHigh, high), high)
        tracker.sessionLow  := math.min(nz(tracker.sessionLow, low), low)
        if not na(tracker.sessionBox)
            tracker.sessionBox.set_top_left_point(
                 chart.point.new(tracker.sessionStartTime, na, tracker.sessionHigh))
            tracker.sessionBox.set_bottom_right_point(
                 chart.point.new(time, na, tracker.sessionLow))
        if not na(tracker.sessionLabel)
            tracker.sessionLabel.set_point(
                 chart.point.new(tracker.sessionStartTime, na, tracker.sessionHigh))

// v16.7 — Auto-suppress session boxes on equity instruments.
// v20.2 — History-window cap: in 'Custom (Last N Days)' mode, only render
//         session boxes for sessions starting within N days of the latest
//         loaded bar.
// v20.3 — Each session can be evaluated in its own market timezone (default)
//         or all four in a single shared timezone (legacy ICT mode).
// v20.4 — Auto-suppress on Daily+ timeframes. On a daily/weekly bar, every
//         intraday session window fits entirely inside the bar's 24h+
//         duration, so `time(tf, sess, tz)` returns the bar's time on EVERY
//         bar — tracker.active and prevActive both latch true forever, the
//         "new session" branch fires only on the very first bar, and one
//         oversized box stretches across the chart. Sessions are inherently
//         intraday concepts; suppress them entirely outside intraday TF.
if showSessionsInput and timeframe.isintraday and not isEquityInstrument
    bool _sessDrawAllowed = sessHistoryModeInput == 'All History' or
         (last_bar_time - time) <= sessHistoryDaysInput * 86400000
    bool _perLocal = sessionAnchorModeInput == 'Per-Session Local'
    // Per-session timezone + hours. In Single mode, all four collapse to
    // sessTimezoneInput + their NY-clock hours.
    string _sydHours = _perLocal ? '0700-1600' : '1700-0200'
    string _sydTz    = _perLocal ? 'Australia/Sydney' : sessTimezoneInput
    string _tokHours = _perLocal ? '0900-1800' : '1900-0400'
    string _tokTz    = _perLocal ? 'Asia/Tokyo'       : sessTimezoneInput
    string _lonHours = _perLocal ? '0800-1700' : '0300-1200'
    string _lonTz    = _perLocal ? 'Europe/London'    : sessTimezoneInput
    string _nyHours  = _perLocal ? '0800-1700' : '0800-1700'
    string _nyTz     = _perLocal ? 'America/New_York' : sessTimezoneInput
    if sessSydneyInput
        updateSession(sydneySession, inSessionWindow(_sydHours, _sydTz), 'Sydney', sessSydneyColorInput, _sessDrawAllowed)
    if sessTokyoInput
        updateSession(tokyoSession,  inSessionWindow(_tokHours, _tokTz), 'Tokyo',  sessTokyoColorInput,  _sessDrawAllowed)
    if sessLondonInput
        updateSession(londonSession, inSessionWindow(_lonHours, _lonTz), 'London', sessLondonColorInput, _sessDrawAllowed)
    if sessNYInput
        updateSession(nySession,     inSessionWindow(_nyHours,  _nyTz),  'NY',     sessNYColorInput,     _sessDrawAllowed)

createOpeningGap(array<openingGap> gaps, float prevClose, float currOpen, color gapColor, string gapName, int maxCount) =>
    // v19.3 — Changed strict `>` to `>=` so a clean 1-tick gap is still
    //         registered as a gap. Was previously excluding e.g. 5040.00 →
    //         5040.25 on ES (0.25 tick) because |0.25| > 0.25 is false.
    //         A 1-tick separation IS a gap by definition; the threshold's
    //         purpose is to skip the equal-open=equal-close no-gap case.
    if not na(prevClose) and not na(currOpen) and math.abs(currOpen - prevClose) >= syminfo.mintick
        float gapTop    = math.max(currOpen, prevClose)
        float gapBottom = math.min(currOpen, prevClose)
        int   gapBias   = currOpen > prevClose ? BULLISH : BEARISH
        float midPrice  = math.avg(gapTop, gapBottom)

        box gapBox = box.new(
             chart.point.new(time, na, gapTop),
             chart.point.new(time, na, gapBottom),
             xloc=xloc.bar_time,
             bgcolor=gapColor,
             border_color=color.new(gapColor, 50))

        line ceLine = na
        if ndogShowCEInput
            ceLine := line.new(
                 chart.point.new(time, na, midPrice),
                 chart.point.new(time, na, midPrice),
                 xloc=xloc.bar_time,
                 color=color.new(gapColor, 30),
                 style=line.style_dotted,
                 width=1)

        label gapLabel = label.new(
             chart.point.new(time, na, gapTop),
             gapName,
             xloc=xloc.bar_time,
             color=color(na),
             textcolor=color.new(gapColor, 0),
             style=label.style_label_down,
             size=size.tiny)

        openingGap newGap = openingGap.new(gapTop, gapBottom, time, gapBias, gapBox, ceLine, gapLabel)
        gaps.unshift(newGap)

        while gaps.size() > maxCount
            openingGap old = gaps.pop()
            old.gapBox.delete()
            if not na(old.ceLine)
                old.ceLine.delete()
            old.gapLabel.delete()

updateAndMitigateGaps(array<openingGap> gaps, int maxAgeHours) =>
    int sz = gaps.size()
    if sz > 0
        int maxAgeMs = maxAgeHours * 3600000
        for index = sz - 1 to 0
            openingGap gap = gaps.get(index)

            bool expired = maxAgeMs > 0 and (time - gap.startTime) > maxAgeMs

            // v19.5 — Hybrid fill detection. Two earlier iterations failed:
            //   • v19.3 had bias-aware logic but with the v16.8 same-bar
            //     skip retained. Genuine same-bar fills (e.g., the rollover
            //     bar's range covers gap.bottom on a bullish NDOG) were
            //     suppressed indefinitely → stale unfilled gaps on chart.
            //   • v19.4 removed the skip outright. On any timeframe where
            //     the rollover bar is wide enough to span both gap edges
            //     (true for almost every NDOG on 15m+ FX charts), the gap
            //     was created and deleted on the same execution, making
            //     it invisible to the user.
            // v19.5 keeps the same-bar SKIP so the gap renders for at
            // least one bar, but adds a one-bar RETROACTIVE fill check
            // that runs on the bar immediately after creation and looks
            // back at the creation bar's high/low. Net effect:
            //   • Gap visible on the creation bar always (no instant
            //     deletion).
            //   • On the next bar, if the creation bar's range already
            //     filled the gap (the audit's "stale gap" concern), the
            //     deletion fires immediately — no missed fills.
            //   • From bar+2 onward, the current-bar check runs normally.
            bool sameBar       = time == gap.startTime
            bool justAfterCreate = (not na(time[1])) and time[1] == gap.startTime and (not na(low[1])) and (not na(high[1]))
            bool fillFromCreation = justAfterCreate and (gap.bias == BULLISH ? low[1] <= gap.bottom : high[1] >= gap.top)
            bool fillFromCurrent  = (not sameBar) and (gap.bias == BULLISH ? low <= gap.bottom : high >= gap.top)
            bool filled = fillFromCreation or fillFromCurrent

            if filled or expired
                gap.gapBox.delete()
                if not na(gap.ceLine)
                    gap.ceLine.delete()
                gap.gapLabel.delete()
                gaps.remove(index)

extendGapBoxes(array<openingGap> gaps) =>
    int sz = gaps.size()
    if sz > 0
        int rightEdge = last_bar_time + 5 * (time - time[1])
        for index = 0 to sz - 1
            openingGap gap = gaps.get(index)
            gap.gapBox.set_bottom_right_point(chart.point.new(rightEdge, na, gap.bottom))
            if not na(gap.ceLine)
                float midPrice = math.avg(gap.top, gap.bottom)
                gap.ceLine.set_second_point(chart.point.new(rightEdge, na, midPrice))

if showNDOGInput
    if isNewDay and barstate.isconfirmed
        createOpeningGap(ndogGaps, pdClose, cdOpen, ndogColorInput, 'NDOG', ndogMaxCountInput)
    extendGapBoxes(ndogGaps)
    if barstate.isconfirmed
        updateAndMitigateGaps(ndogGaps, ndogMaxAgeHoursInput)

if showNWOGInput
    // v19.5 — Rewrote ICT NY anchor detection. v19.3 used
    //         `time(timeframe.period, '1700-1701:6', 'America/New_York')`
    //         to detect "Fri 17:00 NY" — but that requires a bar OPENING
    //         at 17:00 NY Friday. FX brokers (Pepperstone, ICMarkets, etc.)
    //         close the Friday session at 17:00 NY, so the last Friday bar
    //         opens at 16:00 NY and CLOSES at 17:00 NY. No bar opens at
    //         17:00 Fri → atFri17ET never fired → no NWOG was ever created
    //         in ICT NY mode on FX feeds (regression from v19.3).
    //         New detection: track whether each bar is INSIDE the
    //         NY-anchored trading week using dayofweek/hour in the
    //         'America/New_York' zone. Latch close while inside the week;
    //         the LAST latched value before the weekend gap IS Friday's
    //         close (since the latch stops updating once trading closes).
    //         On the first bar that re-enters the NY week (Sun 17:00 NY,
    //         or the next bar after a long gap if the broker skips the
    //         weekend), use the latched value + current open as the gap.
    nwogFormedThisBar := false   // v20.15 — reset per bar; set on actual creation
    bool useICTAnchor = nwogAnchorInput == 'ICT NY (Fri/Sun 17:00 ET)'
    if useICTAnchor
        int nyDow = dayofweek(time, 'America/New_York')
        int nyHr  = hour(time, 'America/New_York')
        bool inICTWeek = (nyDow == dayofweek.sunday and nyHr >= 17) or
                         (nyDow == dayofweek.monday)    or
                         (nyDow == dayofweek.tuesday)   or
                         (nyDow == dayofweek.wednesday) or
                         (nyDow == dayofweek.thursday)  or
                         (nyDow == dayofweek.friday and nyHr < 17)
        // Detect transition INTO the ICT week. Either:
        //   (a) previous bar was outside (broker has weekend bars), or
        //   (b) bar duration jumped — broker skipped the weekend.
        // Pine v6 doesn't overload na()/nz() for series bool, so track
        // the previous-bar state with a `var bool` updated each bar. On
        // bar 0 the var defaults to false, which is the safe assumption
        // (treated as "previous bar was outside the week" — the only
        // consequence is startedICTWeek may fire on bar 0 if it happens
        // to land inside the ICT week, but the downstream na guard on
        // nwogICTPrevClose prevents a spurious gap creation there).
        int barDur = nz(time - time[1], 0)
        var bool inICTWeekPrev = false
        bool startedICTWeek = inICTWeek and (not inICTWeekPrev or barDur > 6 * 3600000)
        if barstate.isconfirmed
            if startedICTWeek and not na(nwogICTPrevClose)
                // Fire NWOG using the latched Fri close vs the current Sun open
                createOpeningGap(nwogGaps, nwogICTPrevClose, open, nwogColorInput, 'NWOG', ndogMaxCountInput)
                if math.abs(open - nwogICTPrevClose) >= syminfo.mintick
                    nwogFormedThisBar := true   // v20.15
            // Latch close while inside the active NY week. The latched
            // value naturally becomes Friday's close once the weekend hits.
            if inICTWeek
                nwogICTPrevClose := close
        // Carry the current bar's inICTWeek into the next bar's "prev".
        // Updated unconditionally so the comparison is consistent across
        // realtime/historical and confirmed/forming bars.
        inICTWeekPrev := inICTWeek
    else
        if isNewWeek and barstate.isconfirmed
            createOpeningGap(nwogGaps, nwogPrevClose, nwogCurrOpen, nwogColorInput, 'NWOG', ndogMaxCountInput)
            if not na(nwogPrevClose) and not na(nwogCurrOpen) and math.abs(nwogCurrOpen - nwogPrevClose) >= syminfo.mintick
                nwogFormedThisBar := true   // v20.15
    extendGapBoxes(nwogGaps)
    if barstate.isconfirmed
        updateAndMitigateGaps(nwogGaps, 0)

//──────────────────────────────────────────────────────────────────────────────
// Previous Day / Week Level Drawing
//──────────────────────────────────────────────────────────────────────────────
// v19.2 — Added optional leftAnchor parameter so callers can specify a
//         non-daily left edge (used by PWH/PWL to anchor at the current
//         week's open). Defaults to na, which falls back to the original
//         currentDayStartTime anchor for all existing PD/MO callers.
drawPDLevel(float level, color levelColor, string levelStyle, string labelText, int leftAnchor = na) =>
    var line  pdLine  = line.new(na, na, na, na, xloc=xloc.bar_time)
    var label pdLabel = label.new(na, na, xloc=xloc.bar_time, size=size.tiny)
    if not na(level)
        int rightEdge = last_bar_time + 20 * (time - time[1])
        int leftEdge  = nz(leftAnchor, nz(currentDayStartTime, time))
        pdLine.set_first_point(     chart.point.new(leftEdge,  na, level))
        pdLine.set_second_point(    chart.point.new(rightEdge, na, level))
        pdLine.set_color(levelColor)
        pdLine.set_style(getStyle(levelStyle))
        pdLine.set_width(1)
        pdLabel.set_point(          chart.point.new(rightEdge, na, level))
        pdLabel.set_text(labelText)
        pdLabel.set_textcolor(levelColor)
        pdLabel.set_color(color(na))
        pdLabel.set_style(label.style_label_left)

if showPDLevelsInput and (barstate.islastconfirmedhistory or barstate.islast)
    if showPDHighInput
        drawPDLevel(pdHigh, pdHighColorInput, pdHighStyleInput, 'PDH')
    if showPDLowInput
        drawPDLevel(pdLow, pdLowColorInput, pdLowStyleInput, 'PDL')
    if showPDOpenInput
        drawPDLevel(pdOpen, pdOpenColorInput, pdOpenStyleInput, 'PDO')
    if showPDCloseInput
        drawPDLevel(pdClose, pdCloseColorInput, pdCloseStyleInput, 'PDC')
    if showCDOpenInput
        drawPDLevel(cdOpen, cdOpenColorInput, cdOpenStyleInput, 'CDO')

if showMidnightOpenInput and (barstate.islastconfirmedhistory or barstate.islast)
    drawPDLevel(midnightOpenPrice, midnightOpenColorInput, midnightOpenStyleInput, 'MO')

if showPWLevelsInput and (barstate.islastconfirmedhistory or barstate.islast)
    // v19.2 — Pass currentWeekStartTime so PWH/PWL anchor at the current
    //         week's open, not today's open. PDH/PDL/PDO/PDC/MO above stay
    //         on the default (daily) anchor.
    drawPDLevel(pwHigh, pwColorInput, pwStyleInput, 'PWH', currentWeekStartTime)
    drawPDLevel(pwLow,  pwColorInput, pwStyleInput, 'PWL', currentWeekStartTime)

//──────────────────────────────────────────────────────────────────────────────
// Asian Range H/L
//──────────────────────────────────────────────────────────────────────────────
// v20.11 — All five intraday-window drivers below now carry the same
//          `timeframe.isintraday` guard that Sessions got in v20.4. On a
//          Daily+ bar, time(timeframe.period, sess, tz) returns non-na on
//          EVERY bar (the 24h+ bar fully contains any intraday window), so
//          asianNow/londonNow/nyNow/ibNow/midnightNow latch true forever:
//          the "new session" reset fires only once and the range
//          high/low then expand monotonically to the chart's all-time
//          extremes (garbage), while Midnight Open captures once and goes
//          stale. These are intraday concepts; suppress them off intraday
//          TF so the drawings + the *Touched alerts don't read garbage.
//          (AVWAP is unaffected — it has no session window; its Daily/
//          Weekly anchors still reset correctly on higher TFs.)
if showAsianRangeInput and timeframe.isintraday
    bool asianNow = not na(time(timeframe.period, asianRangeSessionInput, rangeTimezoneInput))
    if asianNow and not asianPrevActive
        asianRangeHigh      := high
        asianRangeLow       := low
        asianRangeStartTime := time
    if asianNow
        asianRangeHigh := math.max(nz(asianRangeHigh, high), high)
        asianRangeLow  := math.min(nz(asianRangeLow, low), low)
    asianPrevActive := asianNow

// London Range detection
if showLondonRangeInput and timeframe.isintraday
    bool londonNow = not na(time(timeframe.period, londonRangeSessionInput, rangeTimezoneInput))
    if londonNow and not londonPrevActive
        londonRangeHigh      := high
        londonRangeLow       := low
        londonRangeStartTime := time
    if londonNow
        londonRangeHigh := math.max(nz(londonRangeHigh, high), high)
        londonRangeLow  := math.min(nz(londonRangeLow,  low),  low)
    londonPrevActive := londonNow

// NY Range detection
if showNYRangeInput and timeframe.isintraday
    bool nyNow = not na(time(timeframe.period, nyRangeSessionInput, rangeTimezoneInput))
    if nyNow and not nyPrevActive
        nyRangeHigh      := high
        nyRangeLow       := low
        nyRangeStartTime := time
    if nyNow
        nyRangeHigh := math.max(nz(nyRangeHigh, high), high)
        nyRangeLow  := math.min(nz(nyRangeLow,  low),  low)
    nyPrevActive := nyNow

// Initial Balance detection
if showInitialBalanceInput and timeframe.isintraday
    bool ibNow = not na(time(timeframe.period, ibSessionInput, rangeTimezoneInput))
    if ibNow and not ibPrevActive
        ibHigh      := high
        ibLow       := low
        ibStartTime := time
    if ibNow
        ibHigh := math.max(nz(ibHigh, high), high)
        ibLow  := math.min(nz(ibLow,  low),  low)
    ibPrevActive := ibNow

// Midnight Open detection
if showMidnightOpenInput and timeframe.isintraday
    bool midnightNow  = not na(time(timeframe.period, '0000-0001', kzTimezoneInput))
    bool midnightStart = midnightNow and not midnightPrevActive
    if midnightStart
        midnightOpenPrice := open
    midnightPrevActive := midnightNow

if showAsianRangeInput and not na(asianRangeHigh) and not na(asianRangeLow)
    var line  arHighLine  = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  arLowLine   = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label arHighLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label arLowLabel  = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    int rightEdge  = last_bar_time + 20 * (time - time[1])
    int leftEdge   = nz(asianRangeStartTime, time)
    arHighLine.set_first_point(     chart.point.new(leftEdge,  na, asianRangeHigh))
    arHighLine.set_second_point(    chart.point.new(rightEdge, na, asianRangeHigh))
    arHighLine.set_color(asianRangeHighColorInput)
    arHighLine.set_style(getStyle(asianRangeStyleInput))
    arHighLine.set_width(1)
    arLowLine.set_first_point(      chart.point.new(leftEdge,  na, asianRangeLow))
    arLowLine.set_second_point(     chart.point.new(rightEdge, na, asianRangeLow))
    arLowLine.set_color(asianRangeLowColorInput)
    arLowLine.set_style(getStyle(asianRangeStyleInput))
    arLowLine.set_width(1)
    arHighLabel.set_point(          chart.point.new(rightEdge, na, asianRangeHigh))
    arHighLabel.set_text('Asia H')
    arHighLabel.set_textcolor(asianRangeHighColorInput)
    arHighLabel.set_color(color(na))
    arHighLabel.set_style(label.style_label_left)
    arLowLabel.set_point(           chart.point.new(rightEdge, na, asianRangeLow))
    arLowLabel.set_text('Asia L')
    arLowLabel.set_textcolor(asianRangeLowColorInput)
    arLowLabel.set_color(color(na))
    arLowLabel.set_style(label.style_label_left)

// ── London Range Drawing ──────────────────────────────────────────────────────
if showLondonRangeInput and not na(londonRangeHigh) and not na(londonRangeLow)
    var line  ldnHighLine  = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  ldnLowLine   = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label ldnHighLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label ldnLowLabel  = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    int ldnRightEdge = last_bar_time + 20 * (time - time[1])
    int ldnLeftEdge  = nz(londonRangeStartTime, time)
    ldnHighLine.set_first_point(  chart.point.new(ldnLeftEdge,  na, londonRangeHigh))
    ldnHighLine.set_second_point( chart.point.new(ldnRightEdge, na, londonRangeHigh))
    ldnHighLine.set_color(londonRangeHighColorInput)
    ldnHighLine.set_style(getStyle(londonRangeStyleInput))
    ldnHighLine.set_width(1)
    ldnLowLine.set_first_point(   chart.point.new(ldnLeftEdge,  na, londonRangeLow))
    ldnLowLine.set_second_point(  chart.point.new(ldnRightEdge, na, londonRangeLow))
    ldnLowLine.set_color(londonRangeLowColorInput)
    ldnLowLine.set_style(getStyle(londonRangeStyleInput))
    ldnLowLine.set_width(1)
    ldnHighLabel.set_point(       chart.point.new(ldnRightEdge, na, londonRangeHigh))
    ldnHighLabel.set_text('London H')
    ldnHighLabel.set_textcolor(londonRangeHighColorInput)
    ldnHighLabel.set_color(color(na))
    ldnHighLabel.set_style(label.style_label_left)
    ldnLowLabel.set_point(        chart.point.new(ldnRightEdge, na, londonRangeLow))
    ldnLowLabel.set_text('London L')
    ldnLowLabel.set_textcolor(londonRangeLowColorInput)
    ldnLowLabel.set_color(color(na))
    ldnLowLabel.set_style(label.style_label_left)

// ── New York Range Drawing ────────────────────────────────────────────────────
if showNYRangeInput and not na(nyRangeHigh) and not na(nyRangeLow)
    var line  nyHighLine  = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  nyLowLine   = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label nyHighLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label nyLowLabel  = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    int nyRightEdge = last_bar_time + 20 * (time - time[1])
    int nyLeftEdge  = nz(nyRangeStartTime, time)
    nyHighLine.set_first_point(  chart.point.new(nyLeftEdge,  na, nyRangeHigh))
    nyHighLine.set_second_point( chart.point.new(nyRightEdge, na, nyRangeHigh))
    nyHighLine.set_color(nyRangeHighColorInput)
    nyHighLine.set_style(getStyle(nyRangeStyleInput))
    nyHighLine.set_width(1)
    nyLowLine.set_first_point(   chart.point.new(nyLeftEdge,  na, nyRangeLow))
    nyLowLine.set_second_point(  chart.point.new(nyRightEdge, na, nyRangeLow))
    nyLowLine.set_color(nyRangeLowColorInput)
    nyLowLine.set_style(getStyle(nyRangeStyleInput))
    nyLowLine.set_width(1)
    nyHighLabel.set_point(       chart.point.new(nyRightEdge, na, nyRangeHigh))
    nyHighLabel.set_text('NY H')
    nyHighLabel.set_textcolor(nyRangeHighColorInput)
    nyHighLabel.set_color(color(na))
    nyHighLabel.set_style(label.style_label_left)
    nyLowLabel.set_point(        chart.point.new(nyRightEdge, na, nyRangeLow))
    nyLowLabel.set_text('NY L')
    nyLowLabel.set_textcolor(nyRangeLowColorInput)
    nyLowLabel.set_color(color(na))
    nyLowLabel.set_style(label.style_label_left)

// ── Initial Balance Drawing ───────────────────────────────────────────────────
if showInitialBalanceInput and not na(ibHigh) and not na(ibLow)
    var line  ibHighLine  = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  ibLowLine   = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  ibMidLine   = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  ibExtUpLine = line.new(na,na,na,na, xloc=xloc.bar_time)
    var line  ibExtDnLine = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label ibHighLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label ibLowLabel  = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label ibMidLabel  = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label ibExtUpLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    var label ibExtDnLabel = label.new(na,na, xloc=xloc.bar_time, size=size.tiny)
    int ibRightEdge = last_bar_time + 20 * (time - time[1])
    int ibLeftEdge  = nz(ibStartTime, time)
    // v19.9 — Age-based expiry. When the IB has been around longer than
    //         ibMaxAgeHoursInput, swap every color reference for color(na)
    //         so the lines/labels go invisible without deleting the var
    //         handles (deletion would error on next bar's set_color call).
    int  ibMaxAgeMs = ibMaxAgeHoursInput * 3600000
    bool ibExpired  = ibMaxAgeHoursInput > 0 and not na(ibStartTime) and (time - ibStartTime) > ibMaxAgeMs
    color ibHighCol = ibExpired ? color(na) : ibHighColorInput
    color ibLowCol  = ibExpired ? color(na) : ibLowColorInput
    color ibMidCol  = ibExpired ? color(na) : ibMidColorInput
    color ibExtCol  = ibExpired ? color(na) : ibExtensionColorInput
    ibHighLine.set_first_point(  chart.point.new(ibLeftEdge,  na, ibHigh))
    ibHighLine.set_second_point( chart.point.new(ibRightEdge, na, ibHigh))
    ibHighLine.set_color(ibHighCol)
    ibHighLine.set_style(getStyle(ibStyleInput))
    ibHighLine.set_width(1)
    ibLowLine.set_first_point(   chart.point.new(ibLeftEdge,  na, ibLow))
    ibLowLine.set_second_point(  chart.point.new(ibRightEdge, na, ibLow))
    ibLowLine.set_color(ibLowCol)
    ibLowLine.set_style(getStyle(ibStyleInput))
    ibLowLine.set_width(1)
    ibHighLabel.set_point(       chart.point.new(ibRightEdge, na, ibHigh))
    ibHighLabel.set_text('IBH')
    ibHighLabel.set_textcolor(ibHighCol)
    ibHighLabel.set_color(color(na))
    ibHighLabel.set_style(label.style_label_left)
    ibLowLabel.set_point(        chart.point.new(ibRightEdge, na, ibLow))
    ibLowLabel.set_text('IBL')
    ibLowLabel.set_textcolor(ibLowCol)
    ibLowLabel.set_color(color(na))
    ibLowLabel.set_style(label.style_label_left)
    float ibRange = ibHigh - ibLow
    if showIBMidInput
        float ibMid = math.avg(ibHigh, ibLow)
        ibMidLine.set_first_point(   chart.point.new(ibLeftEdge,  na, ibMid))
        ibMidLine.set_second_point(  chart.point.new(ibRightEdge, na, ibMid))
        ibMidLine.set_color(ibMidCol)
        ibMidLine.set_style(getStyle(ibStyleInput))
        ibMidLine.set_width(1)
        ibMidLabel.set_point(        chart.point.new(ibRightEdge, na, ibMid))
        ibMidLabel.set_text('IBM')
        ibMidLabel.set_textcolor(ibMidCol)
        ibMidLabel.set_color(color(na))
        ibMidLabel.set_style(label.style_label_left)
    if showIBExtensionsInput and ibRange > 0
        float ibExtUp = ibHigh + ibRange
        float ibExtDn = ibLow  - ibRange
        ibExtUpLine.set_first_point(  chart.point.new(ibLeftEdge,  na, ibExtUp))
        ibExtUpLine.set_second_point( chart.point.new(ibRightEdge, na, ibExtUp))
        ibExtUpLine.set_color(ibExtCol)
        ibExtUpLine.set_style(getStyle(ibExtensionStyleInput))
        ibExtUpLine.set_width(1)
        ibExtDnLine.set_first_point(  chart.point.new(ibLeftEdge,  na, ibExtDn))
        ibExtDnLine.set_second_point( chart.point.new(ibRightEdge, na, ibExtDn))
        ibExtDnLine.set_color(ibExtCol)
        ibExtDnLine.set_style(getStyle(ibExtensionStyleInput))
        ibExtDnLine.set_width(1)
        ibExtUpLabel.set_point(       chart.point.new(ibRightEdge, na, ibExtUp))
        ibExtUpLabel.set_text('IBH +1')
        ibExtUpLabel.set_textcolor(ibExtCol)
        ibExtUpLabel.set_color(color(na))
        ibExtUpLabel.set_style(label.style_label_left)
        ibExtDnLabel.set_point(       chart.point.new(ibRightEdge, na, ibExtDn))
        ibExtDnLabel.set_text('IBL -1')
        ibExtDnLabel.set_textcolor(ibExtCol)
        ibExtDnLabel.set_color(color(na))
        ibExtDnLabel.set_style(label.style_label_left)

// v17.0 — Single shared marker emitter. Internal and swing MSS may both
//         qualify on the same bar with potentially different displacement
//         offsets; we render one marker per offset, deduplicating when both
//         agree.
drawDisplacementMarker(int offset, bool bullish, color textCol) =>
    if not na(offset)
        int dispX = bar_index - offset
        float dispY = bullish ? low[offset] : high[offset]
        label dispLabel = label.new(dispX, dispY, '◆',
             xloc=xloc.bar_index,
             color=color(na),
             textcolor=textCol,
             style=label.style_none,
             size=size.tiny)
        displacementLabels.push(dispLabel)
        if displacementLabels.size() > MAX_SWEEP_LABELS
            label.delete(displacementLabels.shift())

if showDisplacementInput
    int iBullOff = currentAlerts.internalBullishMSSOffset
    int sBullOff = currentAlerts.swingBullishMSSOffset
    int iBearOff = currentAlerts.internalBearishMSSOffset
    int sBearOff = currentAlerts.swingBearishMSSOffset
    if currentAlerts.internalBullishMSS
        drawDisplacementMarker(iBullOff, true, mssBullColorInput)
    if currentAlerts.swingBullishMSS and (na(iBullOff) or sBullOff != iBullOff)
        drawDisplacementMarker(sBullOff, true, mssBullColorInput)
    if currentAlerts.internalBearishMSS
        drawDisplacementMarker(iBearOff, false, mssBearColorInput)
    if currentAlerts.swingBearishMSS and (na(iBearOff) or sBearOff != iBearOff)
        drawDisplacementMarker(sBearOff, false, mssBearColorInput)

//──────────────────────────────────────────────────────────────────────────────
// v17.0 — CVD Status Table
//──────────────────────────────────────────────────────────────────────────────
if showCVDTableInput and barstate.islast
    var table cvdTable = table.new(position.top_right, 2, 3,
         frame_color=color.new(color.gray, 50),
         frame_width=1,
         border_color=color.new(color.gray, 80),
         border_width=1)
    // v20.5 — Bias now uses a rolling N-bar sum of cvdBarDelta instead of
    //         the sign of chart-history cumulative CVD. The cumCVD value
    //         displayed in the first row stays as-is (raw cumulative,
    //         useful for absolute reference even if chart-load-dependent)
    //         but the Bias row and its colour are driven by the rolling
    //         window. CVD cell colour also flips to the rolling bias so
    //         it doesn't lie when cumCVD is positive while recent flow
    //         is bearish (or vice versa).
    float _cvdRollingSum = math.sum(cvdBarDelta, cvdBiasWindowInput)
    bool  _cvdBullBias   = _cvdRollingSum >= 0
    color cvdSignCol = _cvdBullBias ? GREEN : RED
    // v20.13 — Resolve the user-selected table font size.
    string _cvdSz = cvdTableSizeInput == 'Tiny'   ? size.tiny
                  : cvdTableSizeInput == 'Small'  ? size.small
                  : cvdTableSizeInput == 'Large'  ? size.large
                  : cvdTableSizeInput == 'Huge'   ? size.huge
                  :                                 size.normal
    table.cell(cvdTable, 0, 0, 'CVD',         text_color=color.white,    bgcolor=color.new(color.black, 60), text_size=_cvdSz)
    table.cell(cvdTable, 1, 0, str.tostring(cumCVD, format.volume), text_color=cvdSignCol, bgcolor=color.new(color.black, 80), text_size=_cvdSz)
    table.cell(cvdTable, 0, 1, 'Bias',        text_color=color.white,    bgcolor=color.new(color.black, 60), text_size=_cvdSz)
    table.cell(cvdTable, 1, 1, _cvdBullBias ? 'Bullish' : 'Bearish', text_color=cvdSignCol, bgcolor=color.new(color.black, 80), text_size=_cvdSz)
    table.cell(cvdTable, 0, 2, 'Δ Bar',       text_color=color.white,    bgcolor=color.new(color.black, 60), text_size=_cvdSz)
    color barSignCol = cvdBarDelta >= 0 ? GREEN : RED
    table.cell(cvdTable, 1, 2, str.tostring(cvdBarDelta, format.volume), text_color=barSignCol, bgcolor=color.new(color.black, 80), text_size=_cvdSz)

//──────────────────────────────────────────────────────────────────────────────
// Alerts
//──────────────────────────────────────────────────────────────────────────────
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')
alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')
// v17.2 — Legacy *OB Breakout (mitigation) alerts removed to free output
// slots. The same events are captured by *Breaker Formed when Breaker
// tracking is enabled.
// v16.8 — OB *formation* alerts.
alertcondition(currentAlerts.internalBullishOBFormed, 'Bullish Internal OB Formed', 'Bullish internal OB formed')
alertcondition(currentAlerts.internalBearishOBFormed, 'Bearish Internal OB Formed', 'Bearish internal OB formed')
alertcondition(currentAlerts.swingBullishOBFormed,    'Bullish Swing OB Formed',    'Bullish swing OB formed')
alertcondition(currentAlerts.swingBearishOBFormed,    'Bearish Swing OB Formed',    'Bearish swing OB formed')
alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')
alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')
// Merged the bull/bear liquidity-sweep alertconditions into one. alertcondition()
// counts toward the 64-plot cap (this script sits at exactly 64: 12 plots + 52
// alertconditions), so merging frees the one slot consumed by the SMT export
// plot below. Direction is still carried in the export series (and you can read
// it from the alert via the chart). Net plot budget unchanged.
alertcondition(currentAlerts.bullishLiquiditySweep or currentAlerts.bearishLiquiditySweep, 'Liquidity Sweep (Bull/Bear)', 'Liquidity sweep detected')

// ── SMT cross-indicator export ─────────────────────────────────────────────
// One hidden series (Data Window only — no chart/scale impact) packing this
// bar's swing-level direction so the SMT+VP+AVWAP+Ice indicator can read it via
// input.source() and gate SMT signals on a liquidity sweep / structure shift.
// Codes: 0 = none, 1 = bull, 2 = bear.  packed = sweep + 3*BOS + 9*CHoCH
// → decode downstream with  %3 (sweep), floor(/3)%3 (BOS), floor(/9)%3 (CHoCH).
// Uses the SWING (confirmed) signals to avoid repaint in the exported series.
int smtExpSweep = currentAlerts.bullishLiquiditySweep ? 1 : currentAlerts.bearishLiquiditySweep ? 2 : 0
int smtExpBos   = currentAlerts.swingBullishBOS       ? 1 : currentAlerts.swingBearishBOS       ? 2 : 0
int smtExpChoch = currentAlerts.swingBullishCHoCH     ? 1 : currentAlerts.swingBearishCHoCH     ? 2 : 0
plot(smtExpSweep + 3 * smtExpBos + 9 * smtExpChoch, 'SMT Sweep/BOS/CHoCH Export', display = display.data_window)
// v17.0 — EQH/EQL pool sweep alerts.
alertcondition(currentAlerts.bearishEQHSweep,           'EQH Sweep',                    'Equal Highs liquidity pool swept (bearish)')
alertcondition(currentAlerts.bullishEQLSweep,           'EQL Sweep',                    'Equal Lows liquidity pool swept (bullish)')
// v17.0 — CVD divergence at confirmed swing pivots.
alertcondition(currentAlerts.bullishCVDDivergence,      'Bullish CVD Divergence',       'Bullish CVD divergence at swing low (potential accumulation)')
alertcondition(currentAlerts.bearishCVDDivergence,      'Bearish CVD Divergence',       'Bearish CVD divergence at swing high (potential distribution)')
// v18.0 — Volume Imbalance, MSS AVWAP tag. (PO3 alert removed in v18.1.)
alertcondition(currentAlerts.volumeImbalanceFormed,     'Volume Imbalance Formed',      'Volume Imbalance (body-to-body gap) formed')
alertcondition(currentAlerts.mssAVWAPTagged,            'Price Tagged MSS AVWAP',       'Price wicked the Anchored VWAP from the latest MSS')
alertcondition(currentAlerts.bullishBreakerFormed,      'Bullish Breaker Formed',       'Bullish breaker block formed')
alertcondition(currentAlerts.bearishBreakerFormed,      'Bearish Breaker Formed',       'Bearish breaker block formed')
alertcondition(currentAlerts.bullishBreakerMitigated,   'Bullish Breaker Mitigated',    'Bullish breaker block mitigated')
alertcondition(currentAlerts.bearishBreakerMitigated,   'Bearish Breaker Mitigated',    'Bearish breaker block mitigated')
alertcondition(currentAlerts.bullishIFVGFormed,         'Bullish iFVG Formed',          'Bullish inverted FVG formed (support)')
alertcondition(currentAlerts.bearishIFVGFormed,         'Bearish iFVG Formed',          'Bearish inverted FVG formed (resistance)')
// v20.0 — New retail-trap + high-confluence-OB alerts.
alertcondition(currentAlerts.lowRvolBlockBroken,        'Low-RVOL Block Broken',        'A non-institutional FVG or OB just got mitigated (potential retail trap / stop-run)')
alertcondition(currentAlerts.highConfluenceOBFormed,    'High Confluence OB Formed',    'OB formed with confluence score >= threshold (Premium/Discount + FVG overlap + institutional RVOL)')

// v18.3 — Restored per-zone KZ alerts (4 separate). Silver Bullet (3) is
//         still combined to keep one output slot of headroom.
alertcondition(inAsianKZ       and not inAsianKZ[1],       'Asian KZ Start',        'Asian Kill Zone started')
alertcondition(inLondonOpenKZ  and not inLondonOpenKZ[1],  'London Open KZ Start',  'London Open Kill Zone started')
alertcondition(inNYOpenKZ      and not inNYOpenKZ[1],      'NY Open KZ Start',      'NY Open Kill Zone started')
alertcondition(inLondonCloseKZ and not inLondonCloseKZ[1], 'London Close KZ Start', 'London Close Kill Zone started')
bool anySilverBulletStart = (inSilverBulletAM and not inSilverBulletAM[1]) or (inSilverBulletPM and not inSilverBulletPM[1]) or (inSilverBulletLDN and not inSilverBulletLDN[1])
alertcondition(anySilverBulletStart, 'Silver Bullet Start', 'A Silver Bullet window has started (AM / PM / London)')

// v15.3 — Edge-detect the PDH / PDL touches with a [1] guard so the alert
//         fires once on the bar that crosses the level instead of every bar
//         the price holds beyond it. Matches the Asian/London/NY-range alert
//         style already used downstream.
// v16.7 — Require pdHigh / pdLow to be unchanged from the previous bar.
//         Without this, on the first bar of a new day pdHigh jumps to the
//         (just-ended) day's max — which by definition is >= every bar of
//         that day, including high[1]. The legacy `high[1] < pdHigh` check
//         was therefore trivially true on day rollover, producing a phantom
//         "PDH Touched" alert if the new day's first bar happened to wick
//         the level. Locking the comparison to a stable level kills that.
bool pdHighSweep = showPDLevelsInput and showPDHighInput and not na(pdHigh) and not na(pdHigh[1]) and pdHigh == pdHigh[1] and high >= pdHigh and not na(high[1]) and high[1] < pdHigh
bool pdLowSweep  = showPDLevelsInput and showPDLowInput  and not na(pdLow)  and not na(pdLow[1])  and pdLow  == pdLow[1]  and low  <= pdLow  and not na(low[1])  and low[1]  > pdLow
// v18.2 — Restored per-side alerts (were combined in v17.2 for budget).
alertcondition(pdHighSweep, 'PDH Touched', 'Price reached Previous Day High')
alertcondition(pdLowSweep,  'PDL Touched', 'Price reached Previous Day Low')
// v18.4 — NDOG and NWOG re-combined to free one output slot for AVWAP types.
// v20.15 — NWOG portion now keyed on nwogFormedThisBar (set at actual gap
//          creation in whichever anchor mode is active), so the alert agrees
//          with the drawn gap in ICT NY mode instead of always using the
//          TV-week condition. NDOG portion unchanged (not mode-dependent).
alertcondition((showNDOGInput and isNewDay  and not na(pdClose)      and not na(cdOpen)      and math.abs(cdOpen      - pdClose)      >= syminfo.mintick) or (showNWOGInput and nwogFormedThisBar),
    'Opening Gap Formed', 'New Day or New Week Opening Gap formed')

alertcondition(currentAlerts.internalBullishMSS, 'Internal Bullish MSS', 'Internal Bullish Market Structure Shift detected')
alertcondition(currentAlerts.internalBearishMSS, 'Internal Bearish MSS', 'Internal Bearish Market Structure Shift detected')
alertcondition(currentAlerts.swingBullishMSS,    'Bullish MSS',          'Bullish Market Structure Shift detected')
alertcondition(currentAlerts.swingBearishMSS,    'Bearish MSS',          'Bearish Market Structure Shift detected')

bool asianActiveForAlert = showAsianRangeInput and not na(time(timeframe.period, asianRangeSessionInput, rangeTimezoneInput))
bool asianHighTouched = showAsianRangeInput and not asianActiveForAlert and not na(asianRangeHigh) and high >= asianRangeHigh and (na(high[1]) or high[1] < asianRangeHigh)
bool asianLowTouched  = showAsianRangeInput and not asianActiveForAlert and not na(asianRangeLow)  and low  <= asianRangeLow  and (na(low[1])  or low[1]  > asianRangeLow)
bool priceInOTE = false
// v15.3 — Mirror the bearish OTE math fix from drawOTEZone(); also gate on
//         swingTrend.bias != 0 so we don't fire the alert in the warm-up
//         period before the first structural confirmation.
// v20.8 — Alert now consumes the shared oteZoneLevels() helper (BS #5),
//         so it automatically inherits the fib-order clamp (#4), the
//         Impulse-Leg anchor + void (#1-#3), and can never drift out of
//         sync with the drawn zone again.
if showOTEInput and swingTrend.bias != 0
    [_oteUpper, _oteLower, _oteValid, _oteSwTop, _oteSwBot, _oteEq] = oteZoneLevels()
    if _oteValid
        priceInOTE := close <= _oteUpper and close >= _oteLower

// v18.2 — Restored per-side Asian range alerts.
alertcondition(asianHighTouched, 'Asian High Touched', 'Price reached Asian Range High')
alertcondition(asianLowTouched,  'Asian Low Touched',  'Price reached Asian Range Low')
alertcondition(priceInOTE and not priceInOTE[1], 'Price Enters OTE', 'Price entered Optimal Trade Entry zone')
// v16.7 — Same day-rollover guard as PDH/PDL: require midnightOpenPrice to
//         be stable from the previous bar so the level "jumping" at the
//         start of a new day can't be misread as a fresh first-touch.
bool midnightOpenTouched = showMidnightOpenInput and not na(midnightOpenPrice) and not na(midnightOpenPrice[1]) and midnightOpenPrice == midnightOpenPrice[1] and
     ((high >= midnightOpenPrice and low <= midnightOpenPrice) and
    not (high[1] >= midnightOpenPrice and low[1] <= midnightOpenPrice))
alertcondition(midnightOpenTouched, 'Midnight Open Touched', 'Price touched Midnight Open level')

bool londonActiveForAlert = showLondonRangeInput and not na(time(timeframe.period, londonRangeSessionInput, rangeTimezoneInput))
bool nyActiveForAlert     = showNYRangeInput     and not na(time(timeframe.period, nyRangeSessionInput, rangeTimezoneInput))

bool londonHighTouched = showLondonRangeInput and not londonActiveForAlert and not na(londonRangeHigh) and high >= londonRangeHigh and (na(high[1]) or high[1] < londonRangeHigh)
bool londonLowTouched  = showLondonRangeInput and not londonActiveForAlert and not na(londonRangeLow)  and low  <= londonRangeLow  and (na(low[1])  or low[1]  > londonRangeLow)
bool nyHighTouched     = showNYRangeInput     and not nyActiveForAlert     and not na(nyRangeHigh)     and high >= nyRangeHigh     and (na(high[1]) or high[1] < nyRangeHigh)
bool nyLowTouched      = showNYRangeInput     and not nyActiveForAlert     and not na(nyRangeLow)      and low  <= nyRangeLow      and (na(low[1])  or low[1]  > nyRangeLow)

// v18.2 — Restored per-side London range alerts.
// v18.4 — NY high/low re-combined to free one output slot.
alertcondition(londonHighTouched, 'London High Touched', 'Price reached London Range High')
alertcondition(londonLowTouched,  'London Low Touched',  'Price reached London Range Low')
alertcondition(nyHighTouched or nyLowTouched, 'NY Range Touched', 'Price reached the New York Range high or low')

// Initial Balance alert intentionally omitted: the script is at the 64-output
// ceiling (alertconditions share the budget with plots). The IB lines/labels
// still render visually. To enable an IB touch alert, free one slot first —
// e.g. combine London H + L into a single 'London Range Touched' the way NY
// already is — then add:
//   bool ibActiveForAlert = showInitialBalanceInput and not na(time(timeframe.period, ibSessionInput, rangeTimezoneInput))
//   bool ibHighTouched = showInitialBalanceInput and not ibActiveForAlert and not na(ibHigh) and high >= ibHigh and (na(high[1]) or high[1] < ibHigh)
//   bool ibLowTouched  = showInitialBalanceInput and not ibActiveForAlert and not na(ibLow)  and low  <= ibLow  and (na(low[1])  or low[1]  > ibLow)
//   alertcondition(ibHighTouched or ibLowTouched, 'IB Range Touched', 'Price reached the Initial Balance high or low')
