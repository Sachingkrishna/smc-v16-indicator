// ── Initial Balance ───────────────────────────────────────────────────────────
// Market-profile concept: the high/low established during the first N minutes
// of the regular trading session becomes a reference range for the rest of the
// day. Default 0930-1030 ET matches the standard 1-hour IB used for US
// equities and index futures. Uses the same rangeTimezoneInput as the other
// session ranges so all timezone changes flow from a single input.
showInitialBalanceInput   = input(false, 'Show Initial Balance', group=IB_GROUP, display = display.none)
ibSessionInput            = input.string('0930-1030', 'IB Session Hours', group=IB_GROUP,
    options=['0930-1030','0930-1100','0900-1000','0830-0930','0815-0915'],
    tooltip='Initial Balance window in HHMM-HHMM format.\n0930-1030 = US RTH first hour (standard IB).\nAll times in the Range Timezone defined in the Asian Range group.', display = display.none)
ibHighColorInput          = input.color(color.new(#00bcd4, 20), 'IB High Color', group=IB_GROUP, display = display.none)
ibLowColorInput           = input.color(color.new(#00bcd4, 20), 'IB Low Color',  group=IB_GROUP, display = display.none)
ibStyleInput              = input.string(SOLID, 'IB Line Style', group=IB_GROUP, options=[SOLID,DASHED,DOTTED], display = display.none)
showIBMidInput            = input(false, 'Show IB Midline',     group=IB_GROUP, display = display.none)
ibMidColorInput           = input.color(color.new(#00bcd4, 50), 'IB Mid Color',  group=IB_GROUP, display = display.none)
showIBExtensionsInput     = input(false, 'Show 1x IB Extensions', group=IB_GROUP,
    tooltip='Plots IBH + 1×(IBH-IBL) and IBL − 1×(IBH-IBL). These are the standard market-profile range extensions used to gauge day-type (e.g., normal-variation vs trend day).', display = display.none)
ibExtensionColorInput     = input.color(color.new(#00bcd4, 70), 'IB Extension Color', group=IB_GROUP, display = display.none)
ibExtensionStyleInput     = input.string(DOTTED, 'IB Extension Style', group=IB_GROUP, options=[SOLID,DASHED,DOTTED], display = display.none)
// v19.9 — Mirrors ndogMaxAgeHoursInput. Without this the IB lines from the
//         previous session persist all day (≈23 hours on RTH IB), cluttering
//         the chart until the next IB window resets ibHigh/ibLow.
ibMaxAgeHoursInput        = input.int(23, 'Auto-Expire IB After (hours)', group=IB_GROUP, minval=0, maxval=72,
    tooltip='Hide IB lines this many hours after the IB session started.\n0 = never expire (legacy behavior — lines stay until next IB resets them).\nDefault 23 = lines fade just before the next 09:30 ET IB starts.', display = display.none)

showKillZonesInput      = input(false, 'Show Kill Zones',              group=KILLZONE_GROUP, display = display.none)
kzAsianInput            = input(true,  'Asian KZ (20:00–00:00)',       group=KILLZONE_GROUP, inline='kza', display = display.none)
kzAsianColorInput       = input.color(color.new(#9c27b0, 88), '',     group=KILLZONE_GROUP, inline='kza', display = display.none)
kzLondonOpenInput       = input(true,  'London Open KZ (02:00–05:00)',group=KILLZONE_GROUP, inline='kzl', display = display.none)
kzLondonOpenColorInput  = input.color(color.new(#ff9800, 88), '',     group=KILLZONE_GROUP, inline='kzl', display = display.none)
kzNYOpenInput           = input(true,  'NY Open KZ (07:00–10:00)',    group=KILLZONE_GROUP, inline='kzn', display = display.none)
kzNYOpenColorInput      = input.color(color.new(#2196f3, 88), '',     group=KILLZONE_GROUP, inline='kzn', display = display.none)
kzLondonCloseInput      = input(false, 'London Close KZ (10:00–12:00)',group=KILLZONE_GROUP, inline='kzlc', display = display.none)
kzLondonCloseColorInput = input.color(color.new(#e91e63, 88), '',     group=KILLZONE_GROUP, inline='kzlc', display = display.none)
kzSilverBulletAMInput      = input(false, 'Silver Bullet AM (10:00–11:00)',  group=KILLZONE_GROUP, inline='kzsb1', display = display.none)
kzSilverBulletAMColorInput = input.color(color.new(#ffd700, 85), '',         group=KILLZONE_GROUP, inline='kzsb1', display = display.none)
kzSilverBulletPMInput      = input(false, 'Silver Bullet PM (14:00–15:00)',  group=KILLZONE_GROUP, inline='kzsb2', display = display.none)
kzSilverBulletPMColorInput = input.color(color.new(#ffd700, 85), '',         group=KILLZONE_GROUP, inline='kzsb2', display = display.none)
