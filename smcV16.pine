showPDCloseInput    = input(false, 'PDC (Prev Day Close)',      group=PDHL_GROUP, inline='pdc', display = display.none)
pdCloseColorInput   = input.color(color.new(#9e9e9e, 20), '',  group=PDHL_GROUP, inline='pdc', display = display.none)
