    tooltip='ICT Silver Bullet windows — highest probability FVG entry times.\nAll times use the Kill Zone Timezone setting.', display = display.none)
kzTimezoneInput         = input.string('America/New_York', 'Kill Zone Timezone', group=KILLZONE_GROUP,
     options=['America/New_York','America/Chicago','America/Los_Angeles',
              'Europe/London','Europe/Berlin','Asia/Tokyo','Asia/Hong_Kong',
              'Asia/Kolkata','Asia/Singapore','Australia/Sydney','UTC'],
     tooltip='All kill zone times are defined in this timezone.\nDefault: America/New_York (EST/EDT)', display = display.none)

showSessionsInput       = input(false, 'Show Session Boxes',     group=SESSION_GROUP, display = display.none)
sessSydneyInput         = input(true,  'Sydney (17:00–02:00)',   group=SESSION_GROUP, inline='ss', display = display.none)
sessSydneyColorInput    = input.color(color.new(#4caf50, 85), '',group=SESSION_GROUP, inline='ss', display = display.none)
sessTokyoInput          = input(true,  'Tokyo (19:00–04:00)',    group=SESSION_GROUP, inline='st', display = display.none)
sessTokyoColorInput     = input.color(color.new(#ff5722, 85), '',group=SESSION_GROUP, inline='st', display = display.none)
sessLondonInput         = input(true,  'London (03:00–12:00)',   group=SESSION_GROUP, inline='sl', display = display.none)
sessLondonColorInput    = input.color(color.new(#2196f3, 85), '',group=SESSION_GROUP, inline='sl', display = display.none)
sessNYInput             = input(true,  'New York (08:00–17:00)', group=SESSION_GROUP, inline='sn', display = display.none)
sessNYColorInput        = input.color(color.new(#ff9800, 85), '',group=SESSION_GROUP, inline='sn', display = display.none)
sessTimezoneInput       = input.string('America/New_York', 'Session Timezone (Single mode)', group=SESSION_GROUP,
     options=['America/New_York','America/Chicago','America/Los_Angeles',
              'Europe/London','Europe/Berlin','Asia/Dubai','Asia/Tokyo','Asia/Hong_Kong',
              'Asia/Kolkata','Asia/Singapore','Australia/Sydney','UTC'],
     tooltip='Used only when Anchor Mode = "Single Timezone (ICT)".\n' +
             'All four session windows are evaluated in this timezone.', display = display.none)
// v20.3 — Per-session timezone anchoring. The legacy mode ("Single Timezone")
//         evaluated all four sessions in one timezone (default NY) using
//         hardcoded NY-clock hours — the canonical ICT convention. The new
//         default mode ("Per-Session Local") anchors each session in its
//         OWN market timezone using local business hours, so all four
//         sessions stay correctly aligned to their actual exchange hours
//         year-round regardless of asymmetric DST (e.g. UK BST vs US EDT
//         transition timing). Hardcoded mappings:
//             Sydney  → Australia/Sydney, 07:00-16:00 local
//             Tokyo   → Asia/Tokyo,        09:00-18:00 local (no DST)
//             London  → Europe/London,     08:00-17:00 local
//             New York → America/New_York,  08:00-17:00 local
//         Switch back to Single mode if you want strict ICT NY-anchored
//         behavior for everything.
sessionAnchorModeInput  = input.string('Per-Session Local', 'Session Anchor Mode', group=SESSION_GROUP,
     options=['Per-Session Local','Single Timezone (ICT)'],
     tooltip='Per-Session Local (default) = each session uses its own market timezone + local hours. London tracks UK DST, Sydney tracks Australian DST (opposite hemisphere), Tokyo has no DST, NY tracks US DST. All four boundaries stay locally correct.\n' +
             'Single Timezone (ICT) = legacy behavior. All four sessions evaluated in the timezone above using NY-clock hours (Sydney 17:00-02:00 NY, Tokyo 19:00-04:00 NY, London 03:00-12:00 NY, NY 08:00-17:00 NY). Use this if your methodology references everything in NY time (classic ICT).', display = display.none)
sessBoxBorderInput      = input(true, 'Show Box Border',   group=SESSION_GROUP, display = display.none)
sessLabelInput          = input(true, 'Show Session Labels',group=SESSION_GROUP, display = display.none)
// v20.2 — Optional history-window cap. Default 'All History' = legacy
//         behavior (every visible session draws a box, capped only by
//         MAX_SESSION_BOXES = 50). 'Custom (Last N Days)' restricts box
//         creation to sessions starting within N days of the LAST loaded
//         bar — so on a multi-year chart you only see today's (N=1),
//         this week's (N=5), etc., session boxes.
//         Implementation note: gating happens INSIDE updateSession() at
//         the box-creation step. tracker.active / .prevActive still
//         update every bar so when the window opens mid-session no
//         spurious "new session" trigger fires.
sessHistoryModeInput    = input.string('All History', 'Session History', group=SESSION_GROUP,
     options=['All History','Custom (Last N Days)'],
     tooltip='All History = draw every visible session box (default; capped at 50 most recent).\n' +
             'Custom (Last N Days) = only render session boxes for sessions starting within N days of the latest bar. Useful on long chart histories where the 50-box cap evicts today\'s box before you can see it.', display = display.none)
sessHistoryDaysInput    = input.int(5, 'Custom Days (N)', group=SESSION_GROUP, minval=1, maxval=60,
     tooltip='How many days of session history to render when "Custom (Last N Days)" is selected.\n1 = today only.\n5 = trading week.\n21 = month.\nIgnored when Session History = "All History".', display = display.none)

